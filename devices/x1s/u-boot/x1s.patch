+/*
+ * A restart with a note for S-BOOT, as Samsung's kernel leaves it (sec_reboot.c): PMU INFORM3
+ * (SEC_DEBUG_PANIC_INFORM) holds the reason, 0x12345600 | 4 for recovery (TWRP), | 0 for none;
+ * INFORM2 (SEC_DEBUG_MAGIC_INFORM) bits 16-23 = 0x4E, a normal restart and not the charging
+ * mode. Notes only: these registers survive the restart for the bootloader to read.
+ */
+#define EXYNOS990_PMU_INFORM2		0x15860808UL
+#define EXYNOS990_PMU_INFORM3		0x1586080cUL
+#define SEC_RESET_REASON_PREFIX		0x12345600
+#define SEC_RESET_REASON_RECOVERY	(SEC_RESET_REASON_PREFIX | 0x04)
+#define SEC_RESET_REASON_UNKNOWN	(SEC_RESET_REASON_PREFIX | 0x00)
+#define SEC_REBOOT_NORMAL		0x4e
+
+static int do_x1s_restart(struct cmd_tbl *cmdtp, int flag, int argc,
+			  char *const argv[])
+{
+	bool recovery = argc > 1 && !strcmp(argv[1], "recovery");
+
+	if (!of_machine_is_compatible("samsung,exynos990"))
+		return run_command("reset", 0);
+	printf("[x1s] restarting%s\n", recovery ? " into recovery (TWRP)" : "");
+	clrsetbits_le32(EXYNOS990_PMU_INFORM2, 0xff << 16, SEC_REBOOT_NORMAL << 16);
+	writel(recovery ? SEC_RESET_REASON_RECOVERY : SEC_RESET_REASON_UNKNOWN,
+	       EXYNOS990_PMU_INFORM3);
+	flush_dcache_all();
+	mdelay(500);
+	return run_command("reset", 0);
+}
