+/*
+ * The power chip (S2MPS19), through the APM as Samsung's kernel reaches it
+ * (acpm_mfd.c): ACPM channel 2, speedy bus 0. cmd0 = block << 8 | reg |
+ * bus << 12; cmd1 = function (0 read, 2 update) | value << 8 | mask << 16;
+ * the answer: the value read in cmd1 bits 8-15, an error in bits 24-31.
+ * Blocks: 0x01 PMIC, 0x02 RTC. RTC 0x01 is WTSR_SMPL: bit 6 WTSR (restart
+ * when PWRHOLD drops), bit 7 SMPL (restart after a sudden power loss);
+ * RTC 0x03 CAPSEL bit 3: SUB_SMPL. Samsung's kernel clears all three before
+ * it powers the phone off (rtc-s2mps19.c, s2m_rtc_shutdown()).
+ */
+#define ACPM_CH_MFD			2
+#define PMIC_SPEEDY_BUS			0
+#define PMIC_BLOCK_RTC			0x02
+#define PMIC_RTC_WTSR_SMPL		0x01
+#define PMIC_RTC_CAPSEL			0x03
+#define PMIC_WTSR_EN			BIT(6)
+#define PMIC_SMPL_EN			BIT(7)
+#define PMIC_SUB_SMPL_EN		BIT(3)
+#define MFD_FUNC_READ			0
+#define MFD_FUNC_UPDATE			2
+
+static int acpm_pmic_read(u32 block, u32 reg, u8 *val)
+{
+	u32 cmd[4] = { (block & 0xf) << 8 | (reg & 0xff) |
+		       (PMIC_SPEEDY_BUS & 0xf) << 12, MFD_FUNC_READ, 0, 0 };
+	int ret = acpm_send(ACPM_CH_MFD, cmd);
+
+	if (ret)
+		return ret;
+	if ((cmd[1] >> 24) & 0xff)
+		return -EIO;
+	*val = (cmd[1] >> 8) & 0xff;
+	return 0;
+}
+
+static int acpm_pmic_update(u32 block, u32 reg, u8 val, u8 mask)
+{
+	u32 cmd[4] = { (block & 0xf) << 8 | (reg & 0xff) |
+		       (PMIC_SPEEDY_BUS & 0xf) << 12,
+		       MFD_FUNC_UPDATE | val << 8 | mask << 16, 0, 0 };
+	int ret = acpm_send(ACPM_CH_MFD, cmd);
+
+	if (ret)
+		return ret;
+	return (cmd[1] >> 24) & 0xff ? -EIO : 0;
+}
+
+/* S-BOOT's notes on why the phone came on and why it last went off, found in RAM */
+static void sboot_power_notes(void)
+{
+	static const char *const keys[] = { "PMIC_PWRONSRC", "PMIC_OFFSRC" };
+	const char *p = (const char *)0x80000000UL;
+	const char *end = (const char *)0x96000000UL;	/* secure_camera after */
+	int found = 0, k, n;
+
+	for (; p < end - 64 && found < 12; p++) {
+		if (*p != 'P')
+			continue;
+		for (k = 0; k < 2; k++) {
+			if (memcmp(p, keys[k], strlen(keys[k])))
+				continue;
+			printf("  %08lx: ", (ulong)p);
+			/* to the end of S-BOOT's line; odd bytes in it shown as '.' */
+			for (n = 0; n < 48 && p[n] && p[n] != '\n' && p[n] != '\r'; n++)
+				putc(p[n] >= ' ' && p[n] < 127 ? p[n] : '.');
+			putc('\n');
+			found++;
+		}
+	}
+	if (!found)
+		printf("  S-BOOT's notes not found in RAM\n");
+}
+
+static int do_x1s_pmic(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	u8 v;
+	int ret;
+
+	ret = acpm_pmic_read(PMIC_BLOCK_RTC, PMIC_RTC_WTSR_SMPL, &v);
+	if (ret)
+		printf("RTC WTSR_SMPL: no answer (%d)\n", ret);
+	else
+		printf("RTC WTSR_SMPL = 0x%02x: WTSR %s, SMPL %s\n", v,
+		       v & PMIC_WTSR_EN ? "ON" : "off",
+		       v & PMIC_SMPL_EN ? "ON" : "off");
+	ret = acpm_pmic_read(PMIC_BLOCK_RTC, PMIC_RTC_CAPSEL, &v);
+	if (ret)
+		printf("RTC CAPSEL: no answer (%d)\n", ret);
+	else
+		printf("RTC CAPSEL = 0x%02x: SUB_SMPL %s\n", v,
+		       v & PMIC_SUB_SMPL_EN ? "ON" : "off");
+	printf("S-BOOT's power notes in RAM:\n");
+	sboot_power_notes();
+	return CMD_RET_SUCCESS;
+}
