+/*
+ * USB, read only: the clock gates S-BOOT left (Linux's clk-exynos990.c:
+ * CMU_TOP 0x1A330000, CMU_HSI0 0x10A00000; bit 21 of a gate is its enable),
+ * then one register of the USB PHY (0x10C00000) and the DWC3 controller's ID
+ * (GSNPSID, 0x10E0C120). A line is shown before every read of a USB block:
+ * if one hangs (its clock off, the bus never answers), the last line on the
+ * screen says which.
+ */
+static void usbcheck_line(const char *what, ulong addr)
+{
+	printf("  %-34s %08lx = ", what, addr);
+	video_sync_all();
+	flush_dcache_all();
+	printf("%08x\n", readl(addr));
+	video_sync_all();
+}
