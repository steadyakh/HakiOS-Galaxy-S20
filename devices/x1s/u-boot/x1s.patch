diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index cdbfdce7..d064eb8f 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1104,6 +1104,19 @@ void dwc3_remove(struct dwc3 *dwc);
 #define DWC3_IP_IS(_ip)							\
 	(dwc->ip == _ip##_IP)
 
+/*
+ * Comparisons with the DWC_usb3 revisions (DWC3_REVISION_xxx, "U3" and a
+ * number). A DWC_usb31 or DWC_usb32 keeps its revision in another numbering
+ * (VER_NUMBER, e.g. 0x3131302a for 1.10a) that compares below every one of
+ * them: such a core is newer than any DWC_usb3, as Linux takes it. Without
+ * this the Exynos990's DWC_usb31 got the old cores' workarounds (SuperSpeed
+ * forced, the old run/stop sequence) and never came up on the bus.
+ */
+#define DWC3_REV_LT(_rev)	(DWC3_IP_IS(DWC3) && dwc->revision < (_rev))
+#define DWC3_REV_LE(_rev)	(DWC3_IP_IS(DWC3) && dwc->revision <= (_rev))
+#define DWC3_REV_GT(_rev)	(!DWC3_IP_IS(DWC3) || dwc->revision > (_rev))
+#define DWC3_REV_GE(_rev)	(!DWC3_IP_IS(DWC3) || dwc->revision >= (_rev))
+
 #define DWC3_VER_IS(_ip, _ver)						\
 	(DWC3_IP_IS(_ip) && dwc->revision == _ip##_REVISION_##_ver)
 
