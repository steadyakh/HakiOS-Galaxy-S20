+/*
+ * Microsoft OS 1.0 descriptors, as U-Boot's own fastboot gadget gives them (f_fastboot.c): Windows asks for string 0xEE
+ * the first time it sees a device, then, with the vendor code in it, for the compatible ID (wIndex 4: "WINUSB", so the
+ * in-box WinUSB driver takes the interface with no .inf) and the extended properties (wIndex 5: the interface GUID,
+ * U-Boot fastboot's, which fastboot.exe found on the S20). Without them the loader is an unknown device on Windows.
+ */
+#define QUSB_MS_VENDOR_CODE	0xbc
+
+static int qusb_ms_os_string(u8 *buf)
+{
+	static const char sig[] = "MSFT100";
+
+	buf[0] = 18;
+	buf[1] = USB_DT_STRING;
+	for (int i = 0; i < 7; i++) {
+		buf[2 + 2 * i] = sig[i];
+		buf[3 + 2 * i] = 0;
+	}
+	buf[16] = QUSB_MS_VENDOR_CODE;
+	buf[17] = 0;
+	return 18;
+}
+
+static int qusb_utf16(u8 *dst, const char *s)
+{
+	int n = 0;
+
+	for (; *s; s++, n += 2) {
+		dst[n] = *s;
+		dst[n + 1] = 0;
+	}
+	dst[n] = 0;
+	dst[n + 1] = 0;
+	return n + 2;
+}
+
+static int qusb_ms_os_vendor(const struct usb_ctrlrequest *ctrl, u8 *buf)
+{
+	static const char name[] = "DeviceInterfaceGUID";
+	static const char guid[] = "{4866319A-F4D6-4374-93B9-DC2DEB361BA9}";
+	u16 w_index = le16_to_cpu(ctrl->wIndex);
+	int n, len;
+
+	if (ctrl->bRequest != QUSB_MS_VENDOR_CODE)
+		return -EOPNOTSUPP;
+	if (w_index == 4) {				/* extended compatible ID */
+		memset(buf, 0, 40);
+		put_unaligned_le32(40, buf);
+		put_unaligned_le16(0x0100, buf + 4);
+		put_unaligned_le16(4, buf + 6);
+		buf[8] = 1;				/* one function */
+		buf[16] = 0;				/* interface 0 */
+		buf[17] = 1;
+		memcpy(buf + 18, "WINUSB", 6);
+		return 40;
+	}
+	if (w_index == 5) {				/* extended properties: the interface GUID */
+		put_unaligned_le16(0x0100, buf + 4);
+		put_unaligned_le16(5, buf + 6);
+		put_unaligned_le16(1, buf + 8);		/* one property */
+		n = 10;
+		put_unaligned_le32(1, buf + n + 4);	/* REG_SZ */
+		len = qusb_utf16(buf + n + 10, name);
+		put_unaligned_le16(len, buf + n + 8);
+		n += 10 + len;
+		len = qusb_utf16(buf + n + 4, guid);
+		put_unaligned_le32(len, buf + n);
+		n += 4 + len;
+		put_unaligned_le32(n - 10, buf + 10);	/* the property's own size */
+		put_unaligned_le32(n, buf);
+		return n;
+	}
+	return -EOPNOTSUPP;
+}
