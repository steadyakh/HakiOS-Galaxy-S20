+/*
+ * The GPU (Mali-G77), read only (devices/x1s/PLAN.md "GPU", step G1). From the phone's device tree: the Mali at
+ * 0x18500000, its power domain pd-embedded_g3d at PMU 0x15862200 (CONFIGURATION, STATUS +4, OPTION +8; the Mali
+ * driver's gpu_pmu_status_reg_offset 0x2204 with local_pwr_mask 1: STATUS bit 0 is "on"), its temperature the APM's
+ * zone 3. The Mali's own registers are read only when the domain says it is on: a block without power never answers.
+ * Mali job-manager registers: GPU_ID 0x000, L2_FEATURES 0x004, GPU_STATUS 0x034, AS_PRESENT 0x018, JS_PRESENT 0x01c,
+ * SHADER_PRESENT 0x100, TILER_PRESENT 0x110, L2_PRESENT 0x120, SHADER_READY 0x140 (Linux's panfrost_regs.h).
+ */
+static void usbcheck_line(const char *what, ulong addr);
+
+static int do_x1s_gpucheck(struct cmd_tbl *cmdtp, int flag, int argc,
+			   char *const argv[])
+{
+	static const struct { const char *name; ulong off; } mali[] = {
+		{ "Mali GPU_ID", 0x000 }, { "Mali L2_FEATURES", 0x004 }, { "Mali AS_PRESENT", 0x018 },
+		{ "Mali JS_PRESENT", 0x01c }, { "Mali GPU_STATUS", 0x034 }, { "Mali SHADER_PRESENT", 0x100 },
+		{ "Mali TILER_PRESENT", 0x110 }, { "Mali L2_PRESENT", 0x120 }, { "Mali SHADER_READY", 0x140 },
+	};
+	u32 raw[2];
+	int i, t;
+
+	printf("GPU check (read only):\n");
+	usbcheck_line("G3D domain CONFIGURATION", 0x15862200UL);
+	usbcheck_line("G3D domain STATUS (bit 0: on)", 0x15862204UL);
+	usbcheck_line("G3D domain OPTION", 0x15862208UL);
+	t = acpm_read_temp(3, raw);
+	if (t < 0)
+		printf("  G3D temperature: no answer (%d)\n", t);
+	else
+		printf("  G3D temperature: %d C (raw %08x %08x)\n", t, raw[0], raw[1]);
+	if (!(readl(0x15862204UL) & 1)) {
+		printf("  the GPU's power domain is off: its registers are not read\n");
+	} else {
+		for (i = 0; i < ARRAY_SIZE(mali); i++)
+			usbcheck_line(mali[i].name, 0x18500000UL + mali[i].off);
+	}
+	printf("done\n");
+	return CMD_RET_SUCCESS;
+}
