+static int do_x1s_touchtest(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	u8 status = 0, id[5] = { 0 }, ev[16 * 8], en = 0, l2 = 0, l3 = 0;
+	ulong start;
+	int ret, i, shown = 0, events = 0;
+
+	printf("Touch test: 20 s. Touch the screen.\n");
+	video_sync_all();
+	/*
+	 * The supplies first (the owner's OK, 12 Nov): S2DOS05 EN (0x03) |= 0x06 (LDO2 tsp_io, LDO3 tsp_avdd), read-modify-
+	 * write, only if both voltages already read 0x0C (1.8 V, 3.0 V: the device tree's), and back as it was at the end.
+	 */
+	bb_begin();
+	if (dos_read(0x03, &en) || dos_read(0x05, &l2) || dos_read(0x06, &l3) ||
+	    dos_read(0x03, &status) || status != en) {
+		bb_end();
+		printf("  the power chip does not answer, or not the same twice: stopped\n");
+		return CMD_RET_FAILURE;
+	}
+	status = 0;
+	printf("  power chip: EN %02x, LDO2 %02x, LDO3 %02x\n", en, l2, l3);
+	if ((l2 & 0x7f) != 0x0c || (l3 & 0x7f) != 0x0c) {
+		bb_end();
+		printf("  the voltages are not 1.8 V and 3.0 V: nothing switched on, stopped\n");
+		return CMD_RET_FAILURE;
+	}
+	if ((en & 0x06) != 0x06) {
+		ret = dos_write(0x03, en | 0x06);
+		printf("  supplies on: %d (EN now %02x)\n", ret, dos_read(0x03, &status) ? 0xff : status);
+		status = 0;
+	} else {
+		printf("  supplies were already on\n");
+	}
+	bb_end();
+	mdelay(500);			/* the LDOs (50 us) and the chip's own start (sec_ts waits for it) */
+	video_sync_all();
+	clrsetbits_le32(0x10730000UL, 0xff << 24, 0x33 << 24);		/* GPP5-6/7: I2C */
+	clrbits_le32(0x10730008UL, 0xff << 24);				/* no pull */
+	clrbits_le32(0x15850028UL, 0xf);					/* GPA1-0: no pull-down */
+	printf("  USI mode 10721020 (hsi2c14) %08x, 10721024 (ours) %08x; USI_CON %08x\n",
+	       readl(0x10721020UL), readl(0x10721024UL), readl(HSI2C_REG(0xc4)));
+	/*
+	 * "touchtest usi" (menu 9, the owner's OK): our USI's mode register to I2C first, Samsung's usi_v2.c value
+	 * (I2C_SW_CONF = 4). Samsung's own device tree leaves this one disabled, so its default is what plain touchtest uses.
+	 */
+	if (argc > 1 && !strcmp(argv[1], "usi")) {
+		writel(4, 0x10721024UL);
+		printf("  USI mode 10721024 set to 4 (I2C): now %08x\n", readl(0x10721024UL));
+	}
+	writel(0, HSI2C_REG(0xc4));						/* USI_CON: out of reset */
+	hsi2c_reset(HSI2C15);
+	hsi2c_timing(HSI2C15, 200000000, 100000);
+	printf("  pins GPP5 %08x/%08x, GPA1 %08x; I2C USI_CON %08x CTL %08x CONF %08x FS1-3 %08x %08x %08x\n",
+	       readl(0x10730000UL), readl(0x10730008UL), readl(0x15850028UL), readl(HSI2C_REG(0xc4)),
+	       readl(HSI2C_REG(0x00)), readl(HSI2C_REG(0x40)), readl(HSI2C_REG(0x60)), readl(HSI2C_REG(0x64)),
+	       readl(HSI2C_REG(0x68)));
+	printf("  bus lines GPP5 DAT %08x (bits 6,7: SCL, SDA; high = idle, pulled up), IRQ line %d\n",
+	       readl(0x10730004UL), readl(0x15850024UL) & 1);
+	video_sync_all();
+	for (i = 0; i < 5; i++) {
+		ret = ts_read(0x55, &status, 1);
+		printf("  boot status (0x55), try %d: %d, %02x (0x20: running its firmware)\n", i + 1, ret, status);
+		if (ret)
+			printf("    failed with CTL %08x INT %08x FIFO %08x TRANS %08x AUTO %08x\n", hsi2c15_fail[0],
+			       hsi2c15_fail[1], hsi2c15_fail[2], hsi2c15_fail[3], hsi2c15_fail[4]);
+		video_sync_all();
+		if (!ret)
+			break;
+		mdelay(100);
+	}
+	ret = ts_read(0x22, id, 5);
+	printf("  device ID (0x22): %d, %02x %02x %02x %02x %02x\n", ret, id[0], id[1], id[2], id[3], id[4]);
+	video_sync_all();
+	if (ret) {
+		printf("  the chip does not answer: stopped (its power, or the bus)\n");
+		goto out;
+	}
+	printf("  clear events: %d, sense on: %d\n", ts_command(0x62), ts_command(0x10));
+	printf("  IRQ line now %d\n", readl(0x15850024UL) & 1);
+	video_sync_all();
+	start = get_timer(0);
+	while (get_timer(start) < 20000) {
+		int left;
+
+		schedule();
+		if (readl(0x15850024UL) & 1)		/* high: nothing waits */
+			continue;
+		if (ts_read(0x60, ev, 16))
+			continue;
+		left = ev[7] & 0x1f;
+		if (left > 7)
+			left = 7;
+		if (left && ts_read(0x61, ev + 16, 16 * left))
+			left = 0;
+		for (i = 0; i <= left; i++) {
+			const u8 *e = ev + 16 * i;
+			u32 x = (e[1] << 4) | (e[3] >> 4), y = (e[2] << 4) | (e[3] & 0xf);
+
+			events++;
+			if ((e[0] & 3) != 0 || shown >= 40)		/* coordinates only, and not too many lines */
+				continue;
+			shown++;
+			printf("  finger %d %s at %4u, %4u\n", (e[0] >> 2) & 0xf,
+			       ((e[0] >> 6) & 3) == 1 ? "down" : ((e[0] >> 6) & 3) == 3 ? "up  " : "move", x, y);
+			video_sync_all();
+		}
+	}
+	printf("  %d events; sense off: %d\n", events, ts_command(0x11));
+out:
+	if ((en & 0x06) != 0x06) {
+		bb_begin();
+		i = dos_write(0x03, en);
+		bb_end();
+		printf("  supplies back as they were: %d\n", i);
+	}
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(touchtest, 2, 0, do_x1s_touchtest,
+	   "the touch screen for 20 s, the fingers it reports on the screen", "[usi]: our USI mode register set to I2C first");
