+/*
+ * The heat guard. The Exynos990 runs hot, and until the temperature is
+ * read (its sensors are behind the ACPM firmware), a run of U-Boot is
+ * kept short as well: after hakios_max_minutes (default 30) the phone is
+ * powered off (PSCI SYSTEM_OFF through SMC, as Samsung's own kernel calls
+ * PSCI). This runs whenever U-Boot waits (menu, fastboot, prompt).
+ */
+#define HEAT_GUARD_DEFAULT_MINUTES	30
+
+static struct cyclic_info heat_guard;
+static ulong heat_guard_start, heat_guard_limit_ms, heat_guard_last_read;
+static bool heat_guard_warned;
+#define HEAT_GUARD_MAX_C		70
+
+/*
+ * The Exynos990's APM: a small processor running Samsung's ACPM firmware,
+ * which owns the temperature sensors and the power sequencing. The main
+ * processor talks to it through message queues in the APM's SRAM and a
+ * mailbox that rings it, the way Samsung's kernel does
+ * (drivers/soc/samsung/acpm/acpm_ipc.c), polled here: no interrupts.
+ *
+ *   mailbox 0x15900000 (INTGR0 rings the APM: bit 16 + channel)
+ *   SRAM 0x02039000, the firmware's description of itself at +0x7000:
+ *   ipc_channels (+0x08), ipc_ap_max (+0x18); every channel's queues
+ *   are SRAM offsets. The AP sends into the channel's "rx" queue and reads
+ *   the answers from its "tx" queue. Channel 4: the framework (STOP),
+ *   channel 9: the temperature sensors (the phone's device tree says so).
+ */
+#define ACPM_MBOX			0x15900000UL
+#define ACPM_INTGR0			0x08
+#define ACPM_INTCR1			0x20
+#define ACPM_SRAM			0x02039000UL
+#define ACPM_INITDATA			(ACPM_SRAM + 0x7000)
+#define ACPM_INITDATA_IPC_CHANNELS	0x08
+#define ACPM_INITDATA_IPC_AP_MAX	0x18
+#define ACPM_CH_FRAMEWORK		4
+#define ACPM_CH_TMU			9
+#define ACPM_PROTOCOL_STOP		BIT(22)
+#define ACPM_SEQ_SHIFT			16
+#define ACPM_SEQ_MASK			(0x3f << ACPM_SEQ_SHIFT)
+#define ACPM_TIMEOUT_MS			50
+
+struct acpm_channel_info {
+	u32 rx_rear, rx_front, rx_base;
+	u32 rx_indr_buf, rx_indr_buf_base, rx_indr_buf_size;
+	u32 tx_rear, tx_front, tx_base;
+	u32 q_len, q_elem_size, credit, mbox_addr;
+};
+
+struct acpm_ipc_channel {
+	u32 id, field;
+	s32 owner;
+	u32 type;
+	struct acpm_channel_info ch;
+	u32 ap_poll;
+};
+
+static u32 acpm_seq __section(".data") = 0;
+
+static const struct acpm_ipc_channel *acpm_channel(u32 id)
+{
+	u32 chans = readl(ACPM_INITDATA + ACPM_INITDATA_IPC_CHANNELS);
+	u32 max = readl(ACPM_INITDATA + ACPM_INITDATA_IPC_AP_MAX);
+	const struct acpm_ipc_channel *ch;
+	u32 i;
+
+	if (!chans || chans >= 0x38000 || max == 0 || max > 32)
+		return NULL;
+	ch = (const struct acpm_ipc_channel *)(ACPM_SRAM + chans);
+	for (i = 0; i < max; i++)
+		if (readl(&ch[i].id) == id)
+			return &ch[i];
+	return NULL;
+}
+
+/* send cmd[4] on a channel and wait for its answer (into cmd): 0, or an error */
+static int acpm_send(u32 id, u32 *cmd)
+{
+	const struct acpm_ipc_channel *c = acpm_channel(id);
+	ulong start;
+	u32 len, size, front, next, rear, i, k, seq;
+
+	if (!c)
+		return -ENODEV;
+	len = readl(&c->ch.q_len);
+	size = readl(&c->ch.q_elem_size);
+	if (!len || len > 64 || size < 16 || size > 64)
+		return -EINVAL;
+
+	/* our message into the APM's queue */
+	front = readl(ACPM_SRAM + readl(&c->ch.rx_front));
+	next = (front + 1) % len;
+	start = get_timer(0);
+	while (next == readl(ACPM_SRAM + readl(&c->ch.rx_rear)))
+		if (get_timer(start) > ACPM_TIMEOUT_MS)
+			return -EBUSY;
+	acpm_seq = acpm_seq % 63 + 1;
+	seq = acpm_seq;
+	cmd[0] = (cmd[0] & ~ACPM_SEQ_MASK) | seq << ACPM_SEQ_SHIFT;
+	for (k = 0; k < size / 4; k++)
+		writel(k < 4 ? cmd[k] : 0, ACPM_SRAM + readl(&c->ch.rx_base) +
+		       size * front + 4 * k);
+	writel(next, ACPM_SRAM + readl(&c->ch.rx_front));
+	writel(BIT(id) << 16, ACPM_MBOX + ACPM_INTGR0);
+
+	/* its answer, the one with our sequence number, from its queue */
+	start = get_timer(0);
+	while (get_timer(start) <= ACPM_TIMEOUT_MS) {
+		front = readl(ACPM_SRAM + readl(&c->ch.tx_front));
+		rear = readl(ACPM_SRAM + readl(&c->ch.tx_rear));
+		for (i = rear; i != front; i = (i + 1) % len) {
+			ulong e = ACPM_SRAM + readl(&c->ch.tx_base) + size * i;
+
+			if (((readl(e) & ACPM_SEQ_MASK) >> ACPM_SEQ_SHIFT) != seq)
+				continue;
+			for (k = 0; k < 4; k++)
+				cmd[k] = readl(e + 4 * k);
+			/* dequeue: what was at rear moves into its place */
+			if (i != rear)
+				for (k = 0; k < size / 4; k++)
+					writel(readl(ACPM_SRAM + readl(&c->ch.tx_base) +
+						     size * rear + 4 * k), e + 4 * k);
+			rear = (rear + 1) % len;
+			writel(rear, ACPM_SRAM + readl(&c->ch.tx_rear));
+			if (rear == readl(ACPM_SRAM + readl(&c->ch.tx_front)))
+				writel(BIT(id), ACPM_MBOX + ACPM_INTCR1);
+			return 0;
+		}
+	}
+	return -ETIMEDOUT;
+}
+
+/*
+ * A temperature from the APM (TMU_IPC_READ_TEMP, Samsung's
+ * exynos_acpm_tmu.c): request type 0x02 and the zone in the second word;
+ * the answer has the temperature in degrees C in its top byte. Zones as the
+ * phone's device tree numbers them: 0 BIG (Mongoose), 1 MID (A76),
+ * 2 LITTLE (A55). Returns the temperature, or a negative error.
+ */
+#define TMU_IPC_READ_TEMP		0x02
+
+static int acpm_read_temp(u32 zone, u32 *raw)
+{
+	u32 cmd[4] = { 0, TMU_IPC_READ_TEMP | zone << 16, 0, 0 };
+	int ret = acpm_send(ACPM_CH_TMU, cmd);
+
+	if (raw) {
+		raw[0] = cmd[1];
+		raw[1] = cmd[2];
+	}
+	if (ret)
+		return ret;
+	return cmd[1] >> 24;
+}
+
+/* the hottest of the three CPU zones, or a negative error when none answers sanely */
+static int exynos990_cpu_temp(void)
+{
+	int zone, t, hottest = -ENODATA;
+
+	for (zone = 0; zone < 3; zone++) {
+		t = acpm_read_temp(zone, NULL);
+		if (t >= 5 && t <= 125 && t > hottest)
+			hottest = t;
+	}
+	return hottest;
+}
+
+static int do_x1s_temp(struct cmd_tbl *cmdtp, int flag, int argc,
+		       char *const argv[])
+{
+	/* the phone's device tree's thermal-zones, in their order: BIG, MID, LITTLE, G3D, ISP, NPU */
+	static const char *const names[] = { "BIG (Mongoose)", "MID (A76)",
+					     "LITTLE (A55)", "G3D (GPU)", "ISP",
+					     "NPU" };
+	u32 raw[2];
+	int zone, t;
+
+	for (zone = 0; zone < 6; zone++) {
+		t = acpm_read_temp(zone, raw);
+		if (t < 0)
+			printf("%-15s no answer (%d)\n", names[zone], t);
+		else
+			printf("%-15s %3d C   (raw %08x %08x)\n", names[zone],
+			       t, raw[0], raw[1]);
+	}
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(temp, 1, 0, do_x1s_temp,
