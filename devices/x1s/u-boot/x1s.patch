+	0x209c, 0x20a0, 0x20a4, 0x20ac, 0x20b0, 0x20b4, 0x20b8, 0x20bc, 0x20c0, 0x20c4, 0x20c8, 0x20cc,
+	0x20d0, 0x20d8, 0x20dc, 0x20e0, 0x20e4, 0x20e8, 0x20ec, 0x20f0, 0x20f4, 0x20f8, 0x20fc, 0x2100,
+	0x2104, 0x2108, 0x210c, 0x2110, 0x2114, 0x2118, 0x211c,
+};
