+/*
+ * The phone's storage (UFS), read only (devices/x1s/PLAN.md "iOS from the phone's own storage", step S1): how S-BOOT
+ * leaves the UFS host controller when it starts the boot image -- whether it is still on, the link to the flash up and
+ * its transfer list in place, which a driver that adopts it (no reset, no PHY setup) needs. Addresses from Samsung's
+ * exynos9830 device tree (as Scion's socs/exynos990 has them): UFSHCI at 0x13100000, the Exynos vendor registers at
+ * 0x13101100, the IO-coherency bits in SYSREG_HSI 0x13020700. Nothing is written anywhere: no register, no list, no
+ * command to the flash. UFSHCI 0x38-0x48 (the UIC error codes) clear when they are read: never read here. The vendor
+ * registers and S-BOOT's transfer list are read only when the controller says it is enabled.
+ */
+static int do_x1s_ufscheck(struct cmd_tbl *cmdtp, int flag, int argc,
+			   char *const argv[])
+{
+	static const struct { const char *name; ulong off; } hci[] = {
+		{ "UFS CAP", 0x00 }, { "UFS VER", 0x08 }, { "UFS HCDDID", 0x10 }, { "UFS HCPMID", 0x14 },
+		{ "UFS AHIT", 0x18 }, { "UFS IS", 0x20 }, { "UFS IE", 0x24 }, { "UFS HCS", 0x30 },
+		{ "UFS UTRIACR", 0x4c }, { "UFS UTRLBA", 0x50 }, { "UFS UTRLBAU", 0x54 }, { "UFS UTRLDBR", 0x58 },
+		{ "UFS UTRLRSR", 0x60 }, { "UFS UTRLCNR", 0x64 }, { "UFS UTMRLBA", 0x70 }, { "UFS UTMRLBAU", 0x74 },
+		{ "UFS UTMRLDBR", 0x78 }, { "UFS UTMRLRSR", 0x80 },
+	};
+	static const struct { const char *name; ulong off; } vs[] = {
+		{ "VS TXPRDT_ENTRY_SIZE", 0x00 }, { "VS RXPRDT_ENTRY_SIZE", 0x04 }, { "VS 1US_TO_CNT_VAL", 0x0c },
+		{ "VS UTRL_NEXUS_TYPE", 0x40 }, { "VS UTMRL_NEXUS_TYPE", 0x44 }, { "VS SW_RST", 0x50 },
+		{ "VS DATA_REORDER", 0x60 }, { "VS AXIDMA_BURST", 0x6c }, { "VS GPIO_OUT (bit 0: device out of reset)", 0x70 },
+		{ "VS CLKSTOP_CTRL", 0xb0 }, { "VS FORCE_HCS", 0xb4 }, { "VS UFS_ACG_DISABLE", 0xfc },
+		{ "VS IOP_ACG_DISABLE", 0x100 }, { "VS MPHY_REFCLK_SEL", 0x108 },
+	};
+	const ulong base = 0x13100000UL, vbase = 0x13101100UL;
+	u32 hce, hcs, rsr, lba, lbau, stop;
+	u64 list;
+	int i;
+
+	printf("Storage (UFS) check, read only:\n");
+	usbcheck_line("UFS HCE (bit 0: enabled)", base + 0x34);
+	hce = readl(base + 0x34);
+	for (i = 0; i < ARRAY_SIZE(hci); i++)
+		usbcheck_line(hci[i].name, base + hci[i].off);
+	usbcheck_line("SYSREG IO coherency", 0x13020700UL);
+	if (!(hce & 1)) {
+		printf("  the controller is OFF: S-BOOT switched it off (a driver must bring it up from scratch)\n");
+		printf("done\n");
+		return CMD_RET_SUCCESS;
+	}
+	for (i = 0; i < ARRAY_SIZE(vs); i++)
+		usbcheck_line(vs[i].name, vbase + vs[i].off);
+
+	hcs = readl(base + 0x30);
+	rsr = readl(base + 0x60);
+	lba = readl(base + 0x50);
+	lbau = readl(base + 0x54);
+	stop = readl(vbase + 0xb0);
+	list = ((u64)lbau << 32) | (lba & ~0x3ffu);
+	printf("  controller ON; flash present: %s; transfer list ready: %s, running: %s; list at %llx\n",
+	       (hcs & 1) ? "yes" : "NO", (hcs & 2) ? "yes" : "NO", (rsr & 1) ? "yes" : "NO", list);
+	printf("  PRDT entry size (S-BOOT's): tx %u rx %u (12 = plain 16-byte entries); flash %s; clocks stopped %x\n",
+	       readl(vbase + 0x00) & 0x1f, readl(vbase + 0x04) & 0x1f,
+	       (readl(vbase + 0x70) & 1) ? "out of reset" : "HELD IN RESET", stop & 0xf);
+	/* S-BOOT's first request descriptor, only if its list lies in one of the RAM banks U-Boot maps (else not read) */
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++)
+		if (gd->bd->bi_dram[i].size && list >= gd->bd->bi_dram[i].start &&
+		    list + 32 <= gd->bd->bi_dram[i].start + gd->bd->bi_dram[i].size)
+			break;
+	if (list && i < CONFIG_NR_DRAM_BANKS) {
+		printf("  S-BOOT's slot 0:");
+		for (i = 0; i < 8; i++)
+			printf(" %08x", readl((ulong)list + i * 4));
+		printf("\n");
+	} else {
+		printf("  S-BOOT's list is outside U-Boot's RAM banks: not read\n");
+	}
+	printf("done\n");
+	return CMD_RET_SUCCESS;
+}
