+static void heat_guard_check(struct cyclic_info *c)
+{
+	ulong ms = get_timer(heat_guard_start);
+
+	if (!heat_guard_warned && ms + 60 * 1000 >= heat_guard_limit_ms) {
+		heat_guard_warned = true;
+		printf("\n[x1s] time limit (not heat): powering off in 1 minute; CPU %d C\n",
+		       exynos990_cpu_temp());
+	}
+	if (ms >= heat_guard_limit_ms)
+		exynos_power_off("time limit (hakios_max_minutes) reached");
+
+	/* the temperature, every 2 s: 70 C on any CPU zone is the end of the run */
+	if (ms / 2000 != heat_guard_last_read) {
+		int t = exynos990_cpu_temp();
+
+		heat_guard_last_read = ms / 2000;
+		if (t >= HEAT_GUARD_MAX_C) {
+			printf("\n[x1s] heat guard: %d C\n", t);
+			exynos_power_off("heat guard: too hot");
+		}
+	}
+}
+
+static void exynos990_heat_guard_start(void)
+{
+	ulong minutes = env_get_ulong("hakios_max_minutes", 10,
+				      HEAT_GUARD_DEFAULT_MINUTES);
+
+	if (!minutes || minutes > 60)
+		minutes = HEAT_GUARD_DEFAULT_MINUTES;
+	heat_guard_start = get_timer(0);
+	heat_guard_limit_ms = minutes * 60 * 1000;
+	cyclic_register(&heat_guard, heat_guard_check, 1000 * 1000,
+			"heat-guard");
+	printf("[x1s] heat guard: power off after %lu minutes or at %d C\n",
+	       minutes, HEAT_GUARD_MAX_C);
+	{
+		int t = exynos990_cpu_temp();
+
+		if (t < 0)
+			printf("[x1s] temperature: no answer from the APM (%d): the time limit only\n", t);
+		else
+			printf("[x1s] temperature: %d C (hottest CPU zone)\n", t);
+	}
+}
+
+/*
+ * Core test (12 Nov). HakiOS's loader gets "yes" (0) from PSCI CPU_ON and AFFINITY_INFO "off", and no core runs.
+ * TWRP's Linux started through this U-Boot (booti, kernel at 0x8c080000) gets cores 0 and 4-7, not 1-3; iOS's
+ * kernel (high in RAM) gets none. So: does the place a core starts at matter? A tiny stub (its MPIDR into its own
+ * page at +0x100 + 8 * Affinity1, then CPU_OFF) in a page high in RAM (U-Boot's heap) or low (0x8c080000, where
+ * Linux ran). Early (board_init): core 4 high, core 5 low. "cores": core 4 low, core 5 high, core 1 low.
+ * Results in the environment, read over fastboot with "oem run:test ...": x1s_<e|l><core><h|l> =
+ * "<CPU_ON> <AFFINITY now> <AFFINITY after 200 ms> <seen MPIDR|1>".
+ */
+void x1s_core_stub(void);
+void x1s_core_stub_end(void);
+asm(".pushsection .text.x1s_core_stub, \"ax\"\n"
+    ".balign 64\n"
+    ".globl x1s_core_stub\n"
+    "x1s_core_stub:\n"
+    "  msr daifset, #0xf\n"
+    "  mrs x1, mpidr_el1\n"
+    "  adr x2, x1s_core_stub\n"
+    "  add x2, x2, #0x100\n"
+    "  ubfx x3, x1, #8, #3\n"
+    "  add x2, x2, x3, lsl #3\n"
+    "  orr x1, x1, #1\n"
+    "  str x1, [x2]\n"
+    "  dsb sy\n"
+    "  mov x0, #2\n"
+    "  movk x0, #0x8400, lsl #16\n"
+    "  hvc #0\n"
+    "1: wfi\n"
+    "  b 1b\n"
+    ".globl x1s_core_stub_end\n"
+    "x1s_core_stub_end:\n"
+    ".popsection\n");
+
+static s64 x1s_hvc(u64 fn, u64 a1, u64 a2, u64 a3)
+{
+	register u64 x0 asm("x0") = fn;
+	register u64 x1 asm("x1") = a1;
+	register u64 x2 asm("x2") = a2;
+	register u64 x3 asm("x3") = a3;
+
+	asm volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		     "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return (s64)x0;
+}
+
+#define X1S_LOW_PAGE	0x8c080000UL
+
+static void x1s_core_try(int core, ulong page, s64 res[4])
+{
+	ulong n = (ulong)x1s_core_stub_end - (ulong)x1s_core_stub, start;
+	volatile u64 *marks = (volatile u64 *)(page + 0x100);
+
+	memset((void *)page, 0, 0x200);
+	memcpy((void *)page, (void *)x1s_core_stub, n);
+	flush_dcache_range(page, page + 0x200);
+	invalidate_icache_all();
+	res[0] = x1s_hvc(0xC4000003, core, page, 0);
+	res[1] = x1s_hvc(0xC4000004, core, 0, 0);
+	start = get_timer(0);
+	while (get_timer(start) < 200) {
+		invalidate_dcache_range(page + 0x100, page + 0x140);
+		if (marks[core])
+			break;
+	}
+	res[2] = x1s_hvc(0xC4000004, core, 0, 0);
+	invalidate_dcache_range(page + 0x100, page + 0x140);
+	res[3] = marks[core];
+}
+
+static void x1s_core_publish(const char *name, s64 res[4])
+{
+	char val[80];
+
+	snprintf(val, sizeof(val), "%lld %lld %lld %llx", res[0], res[1], res[2], res[3]);
+	env_set(name, val);
+	printf("[x1s] %s: CPU_ON %lld, AFFINITY now %lld, later %lld, seen %llx\n", name, res[0], res[1], res[2],
+	       res[3]);
+}
+
+
+static int do_x1s_cores(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	s64 res[4][4] = { 0 };
+	void *high = memalign(4096, 4096);
+
+	if (!high)
+		return CMD_RET_FAILURE;
+	x1s_core_try(4, X1S_LOW_PAGE, res[0]);
+	x1s_core_try(5, X1S_LOW_PAGE, res[1]);
+	x1s_core_try(1, X1S_LOW_PAGE, res[2]);
+	free(high);
+	x1s_core_publish("x1s_l4l", res[0]);
+	x1s_core_publish("x1s_l5l", res[1]);
+	x1s_core_publish("x1s_l1l", res[2]);
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(cores, 1, 0, do_x1s_cores,
+	   "start cores 4, 5 and 1 for a moment (PSCI by HVC), from low and high RAM, and say whether they ran", "");
