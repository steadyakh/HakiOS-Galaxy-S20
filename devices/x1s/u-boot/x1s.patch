+ * 0xB00000000, in S-BOOT's reserved-memory): stop below any reserved region
+ * in the upper half of the bank, in S-BOOT's device tree or U-Boot's own.
+ */
+static phys_addr_t exynos_clip_top(const void *fdt, phys_addr_t top)
+{
+	int rsv, node, na, ns, i;
+	fdt_size_t size;
+	fdt_addr_t addr;
+
+	if (!fdt || fdt_check_header(fdt) < 0)
+		return top;
+	rsv = fdt_path_offset(fdt, "/reserved-memory");
+	if (rsv < 0)
+		return top;
+	na = fdt_address_cells(fdt, rsv);
+	ns = fdt_size_cells(fdt, rsv);
+	fdt_for_each_subnode(node, fdt, rsv) {
+		for (i = 0; ; i++) {
