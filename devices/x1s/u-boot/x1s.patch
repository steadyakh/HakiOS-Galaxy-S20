+/*
+ * The touch screen for 20 s: the fingers it reports, on the screen. What is written, all of it (the owner's OK first):
+ *   GPP5 CON 0x10730000 bits 24-31 = 0x33   pins 6, 7 to I2C (function 3), the other pins as they are
+ *   GPP5 PUD 0x10730008 bits 24-31 = 0      no pull on them (the device tree's pin-pud 0)
+ *   GPA1 PUD 0x15850028 bits 0-3 = 0        no pull-down on the touch IRQ line (the chip drives it)
+ *   HSI2C15 0x108D0000                      the I2C controller itself: out of reset (USI_CON 0xC4 = 0), master,
+ *                                           auto mode, timing for 100 kHz at a 200 MHz input (slower if the input
+ *                                           is slower), then its transfer registers for each message
+ *   the touch chip (I2C 0x48)               0x55 and 0x22 read, 0x62 clear its event stack, 0x10 sensing on,
+ *                                           0x60/0x61 events read; at the end 0x11 sensing off
+ *   S2DOS05 (I2C 0x60, by hand on GPP1-0/1) EN 0x03 |= 0x06 (LDO2 tsp_io 1.8 V, LDO3 tsp_avdd 3.0 V) first, only if
+ *                                           their voltage registers already say so, and EN back as it was at the end
+ *   "touchtest usi" only: 0x10721024 = 4    our USI's mode register to I2C (Samsung's usi_v2.c I2C_SW_CONF)
+ * Test 17: without its supplies the chip did not answer (-ENODEV) and the bus pins read low (their pull-ups are on
+ * tsp_io). Test 19: the supplies came on (EN 0x19 -> 0x1f) and it still did not answer; CTL read 0 after 0x8 was
+ * written, so now master mode is set in every message, and the controller's state is shown when a message fails.
+ * No clock or storage is written. The pins are left as they are at the end (U-Boot is the only user).
+ * Samsung's kernel: drivers/i2c/busses/i2c-exynos5.c (polled transfers), drivers/input/touchscreen/sec_ts/y79a.
+ */
+#define HSI2C15			0x108D0000UL	/* the touch chip's bus */
+#define HSI2C4			0x10590000UL	/* the display power chip's (S2DOS05) controller: left in reset (test 18), only read */
+#define HSI2C_REG(o)		(HSI2C15 + (o))
+#define TS_ADDR			0x48
+#define DOS_ADDR		0x60
+
+static void hsi2c_reset(ulong b)
+{
+	setbits_le32(b + 0x00, BIT(31));		/* CTL: SW_RST */
+	clrbits_le32(b + 0x00, BIT(31));
+	writel(BIT(3), b + 0x00);			/* CTL: master */
+	writel(0xffffff, b + 0x08);			/* TRAILIG_CTL */
+	setbits_le32(b + 0x40, BIT(31));		/* CONF: auto mode */
+}
+
+/* i2c-exynos5.c's fast-mode timing, for op_clk at an input of ipclk */
+static void hsi2c_timing(ulong b, u32 ipclk, u32 op_clk)
+{
+	u32 div = (ipclk / (op_clk * 15)) & 0xff;
+	u32 h = ((9 * ipclk) / (1000 * 1000)) / ((div + 1) * 10);
+	u32 start = (9 * ipclk / (1000 * 1000)) / ((div + 1) * 10) - 1;
+
+	h = ((0xffffffffU >> h) << h) & 0xff;
+	start = ((0xffffffffU >> start) << start) & 0xff;
+	clrsetbits_le32(b + 0x68, 0xff << 16, div << 16);	/* TIMING_FS3 */
+	clrsetbits_le32(b + 0x64, 0xff, h);			/* TIMING_FS2 */
+	clrsetbits_le32(b + 0x60, 0xff << 16, start << 16);	/* TIMING_FS1 */
+}
+
+/*
+ * One message to device dev on the bus at b, polled, with a stop after it (both buses' device-tree nodes:
+ * samsung,stop-after-trans or a single message). 0, or a negative error. The controller is not reset on an error
+ * here: on the power chip's bus that is S-BOOT's set-up, left as it is.
+ */
+static int hsi2c_msg(ulong b, u8 dev, bool read, u8 *buf, int len)
+{
+	u32 ctl = readl(b + 0x00), conf, addr;
+	ulong start = get_timer(0);
+	int n = 0;
+
+	clrbits_le32(b + 0x48, BIT(31));				/* TIMEOUT off */
+	writel(BIT(0) | BIT(1) | (min(len, 0x40) << 4) | (min(len, 0x40) << 16), b + 0x04);	/* FIFO_CTL */
+	ctl &= ~(BIT(6) | BIT(7));
+	ctl |= read ? BIT(6) : BIT(7);					/* RXCHON or TXCHON */
+	ctl |= BIT(3);		/* master, whatever CTL read back (test 19: it read 0 after 0x8 was written to it) */
+	conf = readl(b + 0x44);						/* AUTO_CONF */
+	conf = read ? conf | BIT(16) : conf & ~BIT(16);
+	conf |= BIT(17);						/* stop after it */
+	addr = readl(b + 0x70) & ~((0x3ff << 10) | 0x3ff | (0xff << 24));
+	addr |= (0x7 << 24) | (dev << 10);
+	writel(addr, b + 0x70);
+	writel(ctl, b + 0x00);
+	/*
+	 * INT_ENABLE: transfer done, and the transfer-state errors (bits 8-11; bit 10 = no device answered), as
+	 * i2c-exynos5.c's interrupt handler reads them from INT_STATUS. TRANS_STATUS is not an error register on this
+	 * controller: its low four bits are the master's state (test 20: 0x9, a transfer in progress, which an older
+	 * reading of it here took for "no device").
+	 */
+	writel(BIT(7) | (0xf << 8), b + 0x20);
+	writel(readl(b + 0x24), b + 0x24);				/* INT_STATUS cleared */
+	conf = (conf & ~0xffff) | len;
+	writel(conf, b + 0x44);
+	writel(conf | BIT(31), b + 0x44);				/* master run */
+	while (get_timer(start) < 100) {
+		u32 fifo = readl(b + 0x30), ints = readl(b + 0x24);
+
+		if (ints & BIT(10)) {					/* no device answered */
+			writel(ints, b + 0x24);
+			return -ENODEV;
+		}
+		if (ints & (0xb << 8)) {				/* another transfer error */
+			writel(ints, b + 0x24);
+			return -EIO;
+		}
+		if (read) {
+			if (!(fifo & BIT(24)))
+				buf[n++] = readl(b + 0x38);
+			if (n >= len)
+				return 0;
+		} else {
+			if (n < len && (fifo & 0x7f) < 0x40)
+				writel(buf[n++], b + 0x34);
+			if (n >= len && (readl(b + 0x24) & BIT(7)) && (fifo & BIT(8))) {
+				writel(readl(b + 0x24), b + 0x24);
+				return 0;
+			}
+		}
+	}
+	return -ETIMEDOUT;
+}
+
+/* the touch bus's controller as it was when its last message failed: CTL, INT_STATUS, FIFO_STATUS, TRANS_STATUS, AUTO_CONF */
+static u32 hsi2c15_fail[5];
+
+static int hsi2c15_msg(bool read, u8 *buf, int len)
+{
+	int ret = hsi2c_msg(HSI2C15, TS_ADDR, read, buf, len);
+
+	if (ret) {
+		hsi2c15_fail[0] = readl(HSI2C_REG(0x00));
+		hsi2c15_fail[1] = readl(HSI2C_REG(0x24));
+		hsi2c15_fail[2] = readl(HSI2C_REG(0x30));
+		hsi2c15_fail[3] = readl(HSI2C_REG(0x50));
+		hsi2c15_fail[4] = readl(HSI2C_REG(0x44));
+		hsi2c_reset(HSI2C15);
+	}
+	return ret;
+}
+
+/* a register of the touch chip: its command byte written, then len bytes read (sec_ts_i2c_read) */
+static int ts_read(u8 cmd, u8 *buf, int len)
+{
+	int ret = hsi2c15_msg(false, &cmd, 1);
+
+	return ret ? ret : hsi2c15_msg(true, buf, len);
+}
+
+static int ts_command(u8 cmd)
+{
+	return hsi2c15_msg(false, &cmd, 1);
+}
+
+/*
+ * The display power chip S2DOS05 (I2C 0x60), reached the way S-BOOT reaches it: test 18 found its bus's controller
+ * (hsi2c4) still in reset and its pins GPP1-0 (SCL) and GPP1-1 (SDA) plain GPIO outputs, both high. So this drives
+ * those two pins by hand, open drain: a line is pulled low by making it an output at 0, and let go by making it an
+ * input (the SoC's own pull-up on, in case the board has none). About 50 kHz. bb_begin() saves the pins' CON, DAT and
+ * PUD and bb_end() puts them back as they were.
+ */
+#define GPP1_CON	0x10430020UL
+#define GPP1_DAT	0x10430024UL
+#define GPP1_PUD	0x10430028UL
+#define BB_SCL		0
+#define BB_SDA		1
+#define BB_US		10
+static u32 bb_saved[3];
+
+static void bb_set(int pin, int high)
+{
+	if (high) {
+		clrbits_le32(GPP1_CON, 0xf << (4 * pin));		/* input: let go */
+	} else {
+		clrbits_le32(GPP1_DAT, BIT(pin));
+		clrsetbits_le32(GPP1_CON, 0xf << (4 * pin), 1 << (4 * pin));	/* output, low */
+	}
+	udelay(BB_US);
+}
+
+static int bb_get(int pin)
+{
+	return (readl(GPP1_DAT) >> pin) & 1;
+}
+
+static void bb_scl_high(void)
+{
+	ulong t = get_timer(0);
+
+	bb_set(BB_SCL, 1);
+	while (!bb_get(BB_SCL) && get_timer(t) < 2)	/* a device holding the clock (stretching) */
+		;
+}
+
+static void bb_begin(void)
+{
+	bb_saved[0] = readl(GPP1_CON);
+	bb_saved[1] = readl(GPP1_DAT);
+	bb_saved[2] = readl(GPP1_PUD);
+	clrsetbits_le32(GPP1_PUD, 0xff, 0x33);			/* pull-ups on SCL, SDA */
+	bb_set(BB_SDA, 1);
+	bb_scl_high();
+}
+
+static void bb_end(void)
+{
+	writel(bb_saved[1], GPP1_DAT);
+	writel(bb_saved[0], GPP1_CON);
+	writel(bb_saved[2], GPP1_PUD);
+}
+
+static void bb_start(void)
+{
+	bb_set(BB_SDA, 1);
+	bb_scl_high();
+	bb_set(BB_SDA, 0);
+	bb_set(BB_SCL, 0);
+}
+
+static void bb_stop(void)
+{
+	bb_set(BB_SDA, 0);
+	bb_scl_high();
+	bb_set(BB_SDA, 1);
+}
+
+/* a byte out; 0 if the device acknowledged it */
+static int bb_out(u8 v)
+{
+	int i, nack;
+
+	for (i = 7; i >= 0; i--) {
+		bb_set(BB_SDA, (v >> i) & 1);
+		bb_scl_high();
+		bb_set(BB_SCL, 0);
+	}
+	bb_set(BB_SDA, 1);
+	bb_scl_high();
+	nack = bb_get(BB_SDA);
+	bb_set(BB_SCL, 0);
+	return nack;
+}
+
+static u8 bb_in(bool ack)
+{
+	u8 v = 0;
+	int i;
+
+	bb_set(BB_SDA, 1);
+	for (i = 0; i < 8; i++) {
+		bb_scl_high();
+		v = (v << 1) | bb_get(BB_SDA);
+		bb_set(BB_SCL, 0);
+	}
+	bb_set(BB_SDA, !ack);
+	bb_scl_high();
+	bb_set(BB_SCL, 0);
+	bb_set(BB_SDA, 1);
+	return v;
+}
+
+/* the display power chip S2DOS05: one register read (SMBus byte read: register, repeated start, a byte), or written */
+static int dos_read(u8 reg, u8 *val)
+{
+	int ret = -ENODEV;
+
+	bb_start();
+	if (!bb_out(DOS_ADDR << 1) && !bb_out(reg)) {
+		bb_start();
+		if (!bb_out((DOS_ADDR << 1) | 1)) {
+			*val = bb_in(false);
+			ret = 0;
+		}
+	}
+	bb_stop();
+	return ret;
+}
+
+static int dos_write(u8 reg, u8 val)
+{
+	int ret = -ENODEV;
+
+	bb_start();
+	if (!bb_out(DOS_ADDR << 1) && !bb_out(reg) && !bb_out(val))
+		ret = 0;
+	bb_stop();
+	return ret;
+}
+
+/*
+ * The touch chip's supplies, read only: the power chip's bus as S-BOOT left it (pins GPP1-0/1, its USI mode register
+ * usi@10421014, the controller), then, by hand on those pins (bb_*), the S2DOS05's ID (0x00), enables (0x03: bit 1
+ * LDO2 tsp_io, bit 2 LDO3 tsp_avdd) and the two LDOs' voltage (0x05, 0x06: 0x0C = 1.8 V and 3.0 V), each read twice
+ * (the two must agree). The pins are put back as they were.
+ */
+static int do_x1s_touchpower(struct cmd_tbl *cmdtp, int flag, int argc,
+			     char *const argv[])
+{
+	static const struct { const char *name; ulong addr; } regs[] = {
+		{ "GPP1 CON (pins 0,1: I2C=2)",	0x10430000UL + 0x20 },
+		{ "GPP1 DAT",			0x10430000UL + 0x24 },
+		{ "GPP1 PUD",			0x10430000UL + 0x28 },
+		{ "USI mode usi@10421014",	0x10421014UL },
+		{ "HSI2C4 CTL",			HSI2C4 + 0x00 },
+		{ "HSI2C4 CONF",		HSI2C4 + 0x40 },
+		{ "HSI2C4 TRANS_STATUS",	HSI2C4 + 0x50 },
+		{ "HSI2C4 TIMING_FS3",		HSI2C4 + 0x68 },
+		{ "HSI2C4 USI_CON (0: running)", HSI2C4 + 0xc4 },
+	};
+	static const struct { const char *name; u8 reg; } dos[] = {
+		{ "S2DOS05 DEV_ID", 0x00 }, { "S2DOS05 TOPSYS_STAT", 0x01 }, { "S2DOS05 STAT", 0x02 },
+		{ "S2DOS05 EN (bit1 tsp_io, bit2 tsp_avdd)", 0x03 },
+		{ "S2DOS05 LDO2_CFG (tsp_io, 0x0C=1.8V)", 0x05 }, { "S2DOS05 LDO3_CFG (tsp_avdd, 0x0C=3.0V)", 0x06 },
+	};
+	int i, ret, ret2;
+	u8 v, v2;
+
+	printf("Touch power check (read only):\n");
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		usbcheck_line(regs[i].name, regs[i].addr);
+	bb_begin();
+	for (i = 0; i < ARRAY_SIZE(dos); i++) {
+		v = v2 = 0;
+		ret = dos_read(dos[i].reg, &v);
+		ret2 = dos_read(dos[i].reg, &v2);
+		printf("  %-40s %d %d, %02x %02x\n", dos[i].name, ret, ret2, v, v2);
+		video_sync_all();
+	}
+	bb_end();
+	printf("  GPP1 CON/DAT/PUD back to %08x %08x %08x\n", readl(GPP1_CON), readl(GPP1_DAT), readl(GPP1_PUD));
+	printf("done\n");
+	return CMD_RET_SUCCESS;
+}
