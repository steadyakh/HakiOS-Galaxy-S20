+/*
+ * USB as fastboot does it (the controller, the PHY, the fastboot gadget), for
+ * 20 s, with the PHY's and the controller's state on the screen every second:
+ * PMU USB20 PHY control (bit 0: not isolated), PHY UTMI and HSP, DWC3 DCTL
+ * (bit 31: run), DSTS (bits 18-21: link state, bit 22 DEVCTRLHLT), the event
+ * count, GUSB2PHYCFG. Then everything stopped again and back to the menu.
+ */
+static int do_x1s_usbtest(struct cmd_tbl *cmdtp, int flag, int argc,
+			  char *const argv[])
+{
+	struct udevice *udc;
+	ulong start;
+	int ret, sec = -1;
+
+	printf("USB test: 20 s\n");
+	video_sync_all();
+	ret = udc_device_get_by_index(0, &udc);
+	if (ret) {
+		printf("USB init failed: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	printf("controller up\n");
+	g_dnl_clear_detach();
+	ret = g_dnl_register("usb_dnl_fastboot");
+	printf("fastboot gadget: %d\n", ret);
+	printf("PMU72C %08x UTMI %08x HSP %08x U2PHYCFG %08x\n",
+	       readl(0x1586072cUL), readl(0x10c00050UL), readl(0x10c00054UL),
+	       readl(0x10e0c200UL));
+	printf(" s DCTL     DSTS     EVCNT    EVADRLO  EVADRHI  GCTL     DCFG     DEVTEN\n");
+	video_sync_all();
+	start = get_timer(0);
+	while (!ret && get_timer(start) < 20000) {
+		if ((int)(get_timer(start) / 1000) != sec) {
+			sec = get_timer(start) / 1000;
+			/* after 5 s with the run bit still off: set it here, and see whether it stays */
+			if (sec == 5 && !(readl(0x10e0c704UL) & BIT(31))) {
+				setbits_le32(0x10e0c704UL, BIT(31));
+				printf("run bit set by hand\n");
+			}
+			printf("%2d %08x %08x %08x %08x %08x %08x %08x %08x\n", sec,
+			       readl(0x10e0c704UL), readl(0x10e0c70cUL),
+			       readl(0x10e0c40cUL), readl(0x10e0c400UL),
+			       readl(0x10e0c404UL), readl(0x10e0c110UL),
+			       readl(0x10e0c700UL), readl(0x10e0c708UL));
+			video_sync_all();
+		}
+		schedule();
+		dm_usb_gadget_handle_interrupts(udc);
+	}
+	if (!ret)
+		g_dnl_unregister();
+	g_dnl_clear_detach();
+	udc_device_put(udc);
+	printf("USB stopped\n");
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(usbtest, 1, 0, do_x1s_usbtest,
+	   "USB (fastboot) for 20 s with the PHY's and controller's state", "");
+
+/*
+ * Power off, Samsung's way (sec_reboot.c, sec_power_off() in the phone's own
+ * kernel): wait until the power key is let go (the power chip keeps the phone
+ * on while it is held), then PS_HOLD low: PMU PS_HOLD_CONTROL (0x1586030C)
+ * bit 8 cleared, and the power chip cuts the power. PSCI SYSTEM_OFF is tried
+ * first: on the test phone it came back. With a USB cable or a charger on, the
+ * power chip keeps the phone on (Samsung's kernel restarts into its charging
+ * screen then): the screen is made black, nothing lit, and the core waits.
+ */
+#define EXYNOS990_PMU_PS_HOLD_CONTROL	0x1586030CUL
+#define EXYNOS990_PS_HOLD_EN		BIT(8)
+#define EXYNOS990_GPA2_DAT		0x15850044UL	/* pinctrl ALIVE, gpa2 */
+#define EXYNOS990_POWER_KEY		BIT(4)		/* gpa2-4, low while pressed */
+#define EXYNOS990_FB			0xF1000000UL
+#define EXYNOS990_FB_SIZE		(1440 * 3200 * 4)
+
+static void __noreturn exynos_power_off(const char *why)
+{
+	struct pt_regs regs;
+	bool exynos990 = of_machine_is_compatible("samsung,exynos990");
+	int i;
+
+	printf("\n[x1s] %s: powering off\n", why);
+	if (exynos990) {
+		/* up to 10 s for the power key to be let go */
+		for (i = 0; i < 100 && !(readl(EXYNOS990_GPA2_DAT) &
+					 EXYNOS990_POWER_KEY); i++)
+			mdelay(100);
+	}
+	mdelay(1500);	/* long enough to read it */
+
+	if (exynos990) {
+		/*
+		 * The one write to the power chip, the one Samsung's kernel
+		 * makes before every power off: its restart features (WTSR,
+		 * SMPL) off. Without it the phone came straight back on
+		 * (tests 5 and 6); with it, it stayed off (test 7). The
+		 * owner's OK for every power off, the heat guard's too:
+		 * 11 Nov 2026. S-BOOT turns them on again at the next start.
+		 */
+		printf("[x1s] PMIC: WTSR/SMPL off: %d, SUB_SMPL off: %d\n",
+		       acpm_pmic_update(PMIC_BLOCK_RTC, PMIC_RTC_WTSR_SMPL, 0,
+					PMIC_WTSR_EN | PMIC_SMPL_EN),
+		       acpm_pmic_update(PMIC_BLOCK_RTC, PMIC_RTC_CAPSEL, 0,
+					PMIC_SUB_SMPL_EN));
+	}
+
+	if (exynos990) {
+		/*
+		 * Tell the APM first, as Samsung's kernel does
+		 * (exynos_acpm_reboot(): ACPM_IPC_PROTOCOL_STOP on the
+		 * framework's channel): without it the phone came straight
+		 * back on after PS_HOLD went low (test 5).
+		 */
+		u32 cmd[4] = { ACPM_PROTOCOL_STOP, 0, 0, 0 };
+
+		printf("[x1s] APM stop: %d\n", acpm_send(ACPM_CH_FRAMEWORK, cmd));
+	}
+
+	memset(&regs, 0, sizeof(regs));
+	regs.regs[0] = ARM_PSCI_0_2_FN_SYSTEM_OFF;
+	smc_call(&regs);
+
+	if (exynos990) {
+		clrbits_le32(EXYNOS990_PMU_PS_HOLD_CONTROL, EXYNOS990_PS_HOLD_EN);
+		mdelay(2000);
+		/* still here: the power chip keeps the phone on */
+		printf("[x1s] still on: a USB cable or charger keeps it on.\n");
+		printf("[x1s] Unplug it, or hold Volume Down + Power for 10 s.\n");
+		mdelay(8000);
+		memset((void *)EXYNOS990_FB, 0, EXYNOS990_FB_SIZE);
+		flush_dcache_range(EXYNOS990_FB,
+				   EXYNOS990_FB + EXYNOS990_FB_SIZE);
+	} else {
+		printf("[x1s] power off failed: hold Volume Down + Power for 10 s\n");
+	}
+	for (;;)
+		asm volatile("wfi");
+}
+
+#if !CONFIG_IS_ENABLED(SYSRESET_CMD_POWEROFF)
+/* the poweroff command, where no driver provides one: PSCI SYSTEM_OFF */
+int do_poweroff(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	exynos_power_off("poweroff");
+}
+#endif
