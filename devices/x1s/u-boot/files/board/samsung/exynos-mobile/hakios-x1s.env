/*
 * HakiOS's U-Boot on the Galaxy S20 5G (x1s). The menu comes first on this phone until the loader is known to work
 * here: nothing starts by itself, and the heat guard powers the phone off after hakios_max_minutes.
 */
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

/* minutes in U-Boot until the phone is powered off whatever its temperature (1 to 60); 70 C powers it off at once */
hakios_max_minutes=30

bootdelay=0

fastbootcmd=echo "Fastboot (USB): fastboot stage x.hkub; fastboot oem run:hakios load fastboot; fastboot continue"; \
	fastboot -l $fastboot_addr_r usb 0

/*
 * The HakiOS loader and its payload from memory: from the boot image's ramdisk (S-BOOT puts it at 0x84000000 and says
 * so in /chosen), else from the host over fastboot. Nothing is written to the phone's storage on the way.
 */
hakios_start=if hakios load; then x1sguard off; hakios boot; fi; pause
hakios_fastboot=run fastbootcmd; hakios load fastboot && x1sguard off && hakios boot; pause

/*
 * The menu again after anything it ran: at the prompt with no key for a second (bootretry), U-Boot runs bootcmd,
 * which is the menu. There is no keyboard to type at the prompt with; "Shell" turns this off (for a USB console later).
 */
bootretry=1
/* the text menu ("More...") waits for a key too (owner, 14 Nov: nothing starts by itself; the computer picks
 * through the graphical menu's fastboot instead) */
bootmenu_default=0
menucmd=x1smenu || bootmenu -1
/*
 * The graphical menu (x1s-menu.c): the logo and these items. "More..." is the old text menu below, with every tool.
 * Nothing starts by itself (owner, 14 Nov): the menu stays; the computer can pick an item over USB meanwhile
 * (fastboot oem run:x1spick N) or send the loader (xl enter: stage, oem run:hakios load fastboot, continue). The two storage items wait for the storage steps
 * (devices/x1s/PLAN.md "iOS from the phone's own storage"). A boot item draws the boot screen and keeps the console
 * text off it (serial only).
 */
/*
 * "Boot iOS from storage" (PLAN.md S4): the boot screen, the storage taken from S-BOOT and woken (x1sufs wake: the
 * owner's OK, 14 Nov), then the loader and its payload from this boot image; the payload's rd_part=super has the
 * loader read iOS's system image from SUPER into RAM. Nothing is written to the storage.
 */
x1smenu_0=Boot iOS from storage=x1sbar 0 new; if x1sufs wake; then x1sbar 10; run hakios_start; else x1sbar -1 new "The storage did not answer"; pause; fi
/*
 * "Boot iOS (writable)" (PLAN.md S5/S6): as "Boot iOS from storage", and the 110 GB data volume at the start of
 * userdata (owner's OK, 14 Nov) mounted on /private/var: U-Boot's write window on (x1sufs writes: userdata where the
 * PIT puts it, its first 26855468 blocks only), the loader's storage service for the kernel (ufs=2, the loader keeping
 * core 0, the kernel starting on core 4), writes there (ufs_write=1) and the volume (var_hfs=ufs_userdata_data).
 */
x1s_rw_args=ufs=2 ufs_write=1 var_hfs=ufs_userdata_data bootcpu=4
x1smenu_1=Boot iOS (writable)=x1sbar 0 new; if x1sufs wake && x1sufs writes; then x1sbar 10; hakios load && x1sargs "${x1s_rw_args}" && x1sguard off && hakios boot; pause; else x1sbar -1 new "The storage did not answer"; pause; fi
x1smenu_2=HakiOS over USB=x1sbar -1 new "Connected to the computer (USB)"; run hakios_fastboot
x1smenu_3=Restart into TWRP=x1sbar 0 new; restart recovery
x1smenu_4=Restart=x1sbar 0 new; restart
x1smenu_5=Power off=poweroff
x1smenu_6=More...=setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; cls; bootmenu -1
x1smenu_default=0
bootcmd=run menucmd

/* power off: the power chip's restart features (WTSR, SMPL) off, the APM stopped, PS_HOLD low, as Samsung's kernel does */
bootmenu_0=HakiOS (from the boot image)=run hakios_start
bootmenu_1=HakiOS over USB (fastboot)=run hakios_fastboot
bootmenu_2=Restart into TWRP=restart recovery
bootmenu_3=Restart (back to this menu)=restart
bootmenu_4=Power off=poweroff
bootmenu_5=Temperature=temp; pause
bootmenu_6=Power chip info (read only)=pmic; pause
bootmenu_7=Touch power check (read only)=touchpower; pause
bootmenu_8=Touch test (20 s: touch the screen)=touchtest; pause
bootmenu_9=GPU check (read only)=gpucheck; pause
bootmenu_10=What is in memory=hakios info; pause
bootmenu_11=Board info=bdinfo; pause
bootmenu_12=Storage check (read only)=ufscheck; pause
bootmenu_13=Storage: partitions (read only)=x1sufs; pause
bootmenu_14=Shell=setenv bootretry -1; echo "type: run menucmd"
