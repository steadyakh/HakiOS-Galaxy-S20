+/*
+ * fb_fps=1: the frames shown in the last half second, times two, drawn at the panel's top left (below the status bar)
+ * in a 3 x 5 font scaled up 10 times, after the frame's own pixels: it is in every frame and costs a few thousand pixels.
+ */
+void
+IOMobileFramebuffer::drawFps(uint64_t now)
+{
+	static const uint16_t digits[10] = { 0x7b6f, 0x2c97, 0x73e7, 0x73cf, 0x5bc9, 0x79cf, 0x79ef, 0x7249, 0x7bef, 0x7bcf };
+	const uint32_t scale = 10, x0 = 40, y0 = 160, w = 3 * 3 * scale + 2 * scale + 2 * scale, h = 5 * scale + 2 * scale;
+	uint64_t ns;
+	uint32_t value;
+	char text[4];
+	int n = 0;
+
+	fFpsCount++;
+	if (fFpsSince == 0) {
+		fFpsSince = now;
+	}
+	absolutetime_to_nanoseconds(now - fFpsSince, &ns);
+	if (ns >= 500 * NSEC_PER_MSEC) {
+		fFpsShown = (uint32_t) ((uint64_t) fFpsCount * NSEC_PER_SEC / ns);
+		fFpsCount = 0;
+		fFpsSince = now;
+	}
+	if (x0 + w + 4 * scale >= fPanelWidth || y0 + h >= fPanelHeight) {
+		return;
+	}
+	value = fFpsShown > 999 ? 999 : fFpsShown;
+	if (value >= 100) {
+		text[n++] = (char) (value / 100);
+	}
+	if (value >= 10) {
+		text[n++] = (char) (value / 10 % 10);
+	}
+	text[n++] = (char) (value % 10);
+	for (uint32_t y = y0; y < y0 + h; y++) {
+		uint32_t * row = (uint32_t *) (fBase + (size_t) y * fRowBytes);
+
+		for (uint32_t x = x0; x < x0 + w + 4 * scale; x++) {
+			row[x] = 0xff000000u;
+		}
+	}
+	for (int d = 0; d < n; d++) {
+		uint16_t glyph = digits[(int) text[d]];
+
+		for (uint32_t gy = 0; gy < 5; gy++) {
+			for (uint32_t gx = 0; gx < 3; gx++) {
+				if (!(glyph >> (14 - (gy * 3 + gx)) & 1)) {
+					continue;
+				}
+				for (uint32_t py = 0; py < scale; py++) {
+					uint32_t * row = (uint32_t *) (fBase + (size_t) (y0 + scale + gy * scale + py) * fRowBytes);
+
+					for (uint32_t px = 0; px < scale; px++) {
+						row[x0 + scale + (uint32_t) d * 4 * scale + gx * scale + px] = 0xffffffffu;
+					}
+				}
+			}
+		}
+	}
+}
