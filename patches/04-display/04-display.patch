+/*
+ * A layer onto the panel: from the surface the GPU has stretched it into (fb_gpuscale, see gPanelSize), if it has one
+ * and the whole surface goes onto the whole display; else from the surface itself, stretched here.
+ */
+void
+IOMobileFramebuffer::drawLayerOrTwin(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	static const int32_t all[4] = { 0, 0, 0, 0 };   /* (drawLayer: the whole surface, the whole display) */
+	static bool said;
+	MiniIOSurface * t;
+
+	if (gPanelSize == 0 || s->panelTwin == 0 ||
+	    !((src[2] <= 0 && src[3] <= 0) || (src[0] == 0 && src[1] == 0 && (uint32_t) src[2] == s->info.width && (uint32_t) src[3] == s->info.height)) ||
+	    !((dst[2] <= 0 && dst[3] <= 0) || (dst[0] == 0 && dst[1] == 0 && (uint32_t) dst[2] == fWidth && (uint32_t) dst[3] == fHeight)) ||
+	    (t = MiniIOSurfaceCopy(s->panelTwin)) == NULL) {
+		drawLayer(s, src, dst);
+		return;
+	}
+	if (t->twinOf != s->sid || t->info.width != fPanelWidth || t->info.height != fPanelHeight ||
+	    t->info.bytesPerElement != 4 || t->info.planeCount != 0 || t->drawn == 0) {
+		MiniIOSurfaceDrop(t);
+		drawLayer(s, src, dst);
+		return;
+	}
+	if (!MiniIOSurfaceDrawn(t, SWAP_GPU_MS)) {
+		IOLog("MiniIOMobileFramebuffer: the GPU is not done with surface %u (surface %u stretched) after %u ms; shown as it is\n",
+		    t->sid, s->sid, SWAP_GPU_MS);
+	}
+	if (!said) {
+		said = true;
+		IOLog("MiniIOMobileFramebuffer: surface %u stretched to the panel by the GPU, in surface %u (%ux%u): copied as it is\n",
+		    s->sid, t->sid, t->info.width, t->info.height);
+	}
+	drawLayer(t, all, all);
+	MiniIOSurfaceDrop(t);
+}
