+		errno = EINVAL;
+		return -EINVAL;
+	}
+	for (unsigned i = 0; i < SYNC_FILES; i++) {
+		if (sync_files[i].fd != sync_file_fd) {
+			continue;
+		}
+		/* binary: signalled once every submission the exported syncobj waited for is done */
+		s->pending = 0;
+		for (unsigned k = 0; k < sync_files[i].pending; k++) {
+			s->on_the_way[s->pending].point = 1;
+			s->on_the_way[s->pending].fence = sync_files[i].on_the_way[k].fence;
+			s->pending++;
+		}
+		s->reached = s->pending == 0 ? 1 : 0;
+		sync_files[i].fd = -1;
+		pthread_mutex_unlock(&syncobj_lock);
+		return 0;
+	}
+	pthread_mutex_unlock(&syncobj_lock);
+	errno = EINVAL;
+	return -EINVAL;
+}
