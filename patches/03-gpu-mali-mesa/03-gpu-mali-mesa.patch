+	wr(m + AS(0) + AS_TRANSTAB_LO, 0x5a5a5000u);
+	t1 = mach_absolute_time();
+	seen = rd(m + AS(0) + AS_TRANSTAB_LO);
+	wr(m + AS(0) + AS_TRANSTAB_LO, 0);
+	after = rd(m + AS(0) + AS_TRANSTAB_LO);
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	say("mali: EARLY write test: written 0x5a5a5000, read %#x; written 0, read %#x (the write took %llu ns): %s\n",
