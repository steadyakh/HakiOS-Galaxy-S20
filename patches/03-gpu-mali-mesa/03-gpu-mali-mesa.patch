 int
 drmSyncobjDestroy(int fd, uint32_t handle)
 {
@@ -571,6 +730,74 @@ submit_with_syncobjs(struct drm_msm_gem_submit *submit, unsigned long size)
 	return 0;
 }
 
+/*
+ * Panfrost's submission (drm_panfrost_submit): what it waits for is waited for here, in this process; the kernel
+ * takes the job chain and answers with its fence in out_sync (Linux's kernel would signal that sync object; here the
+ * sync objects are this file's, see above), which then goes into the sync object Panfrost gave.
+ */
+static int
+panfrost_submit(struct drm_panfrost_submit *submit)
+{
+	const uint32_t *in = (const uint32_t *)(uintptr_t)submit->in_syncs;
+	uint32_t out = submit->out_sync, fence;
+	int error;
+
+	for (uint32_t i = 0; i < submit->in_sync_count; i++) {
+		uint32_t h = in[i];
+		bool submitted;
+		int r;
+
+		/*
+		 * The S20's kernel runs the Mali's jobs one after the other in the order they are given (hakios.mali.c's
+		 * queue), so a job waited for that has been given already is done before this one starts: nothing to wait
+		 * for here. Waiting for it to be done, as before, made every render pass of a frame wait for the one
+		 * before on the processor (runs 100-101: 48-91 ms a frame while swiping). Only one not given yet is waited for.
+		 */
+		pthread_mutex_lock(&syncobj_lock);
+		{
+			struct syncobj *s = syncobj_of(h);
+			submitted = s == NULL || s->pending != 0 || s->reached != 0;
+		}
+		pthread_mutex_unlock(&syncobj_lock);
+		if (panfrost && submitted) {
+			continue;
+		}
+		r = drmSyncobjWait(0, &h, 1, now_ns() + 10000000000LL,
+		    DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL);
+		if (r != 0) return -r;
+	}
+	{
+		/* the buffers this job names: from now on the kernel is asked whether they are idle (drmIoctl, WAIT_BO) */
+		const uint32_t *handles = (const uint32_t *)(uintptr_t)submit->bo_handles;
+
+		for (uint32_t i = 0; handles != NULL && i < submit->bo_handle_count; i++) {
+			if (handles[i] < BO_SEEN) {
+				__atomic_store_n(&bo_seen[handles[i]], 1, __ATOMIC_RELEASE);
+			}
+		}
+	}
+	submit->in_syncs = 0;
+	submit->in_sync_count = 0;
+	submit->out_sync = 0;
+	error = call(DRM_COMMAND_BASE + DRM_PANFROST_SUBMIT, submit, sizeof(*submit));
+	fence = submit->out_sync;               /* (the kernel's answer) */
+	submit->out_sync = out;
+	if (error != 0) return error;
+	__atomic_store_n(&last_fence, fence, __ATOMIC_RELEASE);
+	pthread_mutex_lock(&syncobj_lock);
+	{
+		struct syncobj *s = syncobj_of(out);
+		if (s != NULL) {
+			s->reached = 0;
+			s->pending = 0;
+			syncobj_add(s, 1, fence);
+		}
+	}
+	pthread_cond_broadcast(&syncobj_submitted);
+	pthread_mutex_unlock(&syncobj_lock);
+	return 0;
+}
