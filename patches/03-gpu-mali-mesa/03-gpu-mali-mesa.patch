+#define AS_TRANSCFG_PTW_NON_CACHEABLE   (1u << 24)      /* the table walk reads memory, not the GPU's L2 */
+/* every one of the eight memory kinds: inner and outer non-cacheable (panfrost's mair_to_memattr for device memory) */
+#define AS_MEMATTR_NON_CACHEABLE        0x4c4c4c4cu
+
+/* an entry of the tables (kbase's mmu_mode_aarch64.c) */
+#define PTE_TABLE               3ull            /* levels 0-2: the next table */
+#define PTE_PAGE                3ull            /* level 3: a 4K page */
+#define PTE_ACCESS_RW           (1ull << 6)
+#define PTE_ACCESS_FLAG         (1ull << 10)
+#define PTE_NX                  (1ull << 54)
+#define PTE_ADDRESS             0x0000fffffffff000ull
+
+#define GPU_VA                  0x1000000ull    /* where the GPU sees our page */
