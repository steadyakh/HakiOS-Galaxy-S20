+		for (unsigned i = 0; i < SYNC_FILES; i++) sync_files[i].fd = -1;
+		sync_files_ready = true;
+	}
+	s = syncobj_of(handle);
+	if (s == NULL) {
+		pthread_mutex_unlock(&syncobj_lock);
+		close(out);
+		errno = EINVAL;
+		return -EINVAL;
