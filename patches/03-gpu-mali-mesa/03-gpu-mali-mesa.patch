+	{
+		uint64_t sctlr, tcr, mair, el, mpidr;
+		uint32_t a, b, c;
+
+		__asm__ volatile ("mrs %0, sctlr_el1" : "=r" (sctlr));
+		__asm__ volatile ("mrs %0, tcr_el1" : "=r" (tcr));
+		__asm__ volatile ("mrs %0, mair_el1" : "=r" (mair));
+		__asm__ volatile ("mrs %0, CurrentEL" : "=r" (el));
+		__asm__ volatile ("mrs %0, mpidr_el1" : "=r" (mpidr));
+		say("mali: kernel CPU: EL%llu SCTLR %#llx TCR %#llx MAIR %#llx MPIDR %#llx\n", (el >> 2) & 3, sctlr, tcr, mair,
+		    mpidr);
+		/* other store forms: 64-bit (TRANSTAB_LO and _HI at once), store-release, a store pair */
+		__asm__ volatile ("dsb sy; str %0, [%1]; dsb sy" : : "r" (0x11111000ull), "r" (m + AS(0) + AS_TRANSTAB_LO) : "memory");
+		a = rd(m + AS(0) + AS_TRANSTAB_LO);
+		__asm__ volatile ("dsb sy; stlr %w0, [%1]; dsb sy" : : "r" (0x22222000u), "r" (m + AS(0) + AS_TRANSTAB_LO) : "memory");
+		b = rd(m + AS(0) + AS_TRANSTAB_LO);
+		__asm__ volatile ("dsb sy; stp %w0, %w0, [%1]; dsb sy" : : "r" (0x33333000u), "r" (m + AS(0) + AS_TRANSTAB_LO) : "memory");
+		c = rd(m + AS(0) + AS_TRANSTAB_LO);
+		wr(m + AS(0) + AS_TRANSTAB_LO, 0);
+		wr(m + AS(0) + AS_TRANSTAB_HI, 0);
+		say("mali: other stores: 64-bit -> %#x, store-release -> %#x, pair -> %#x\n", a, b, c);
+		/*
+		 * A marker left behind: AS 1's table address = 0x77777000, not put back. After the run the loader reads it
+		 * ("oem peek 18502440"): if it is there, the kernel's writes land and its READS are what is wrong.
+		 */
+		wr(m + AS(1) + AS_TRANSTAB_LO, 0x77777000u);
+		say("mali: marker written to AS 1 (0x18502440), the kernel reads it as %#x\n", rd(m + AS(1) + AS_TRANSTAB_LO));
+		/*
+		 * Timed with the generic timer (26 MHz), 1000 each: writes of 0 to the GIC distributor's ISPENDR0 (0x10101200:
+		 * writing 0 does nothing) and to the GPU's AS 1 table address, and reads of both. The loader (13 Nov): every
+		 * device write ~400 ns there, the GIC's and the GPU's alike; the kernel's GPU writes ~10 ns, and lost.
+		 */
+		{
+			vm_offset_t gic = ml_io_map(0x10101000u, 0x1000);
+			uint64_t t[5];
+
+			if (gic != 0) {
+				__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (t[0]));
+				for (int i = 0; i < 1000; i++) {
+					wr(gic + 0x200, 0);
+				}
+				__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (t[1]));
+				for (int i = 0; i < 1000; i++) {
+					wr(m + AS(1) + AS_TRANSTAB_LO, 0);
+				}
+				__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (t[2]));
+				for (int i = 0; i < 1000; i++) {
+					(void)rd(gic + 0x200);
+				}
+				__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (t[3]));
+				for (int i = 0; i < 1000; i++) {
+					(void)rd(m + AS(1) + AS_TRANSTAB_LO);
+				}
+				__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (t[4]));
+				say("mali: kernel, ticks of 26 MHz per 1000: GIC writes %llu, GPU writes %llu, GIC reads %llu, GPU reads %llu\n",
+				    t[1] - t[0], t[2] - t[1], t[3] - t[2], t[4] - t[3]);
+				show_mapping("the GIC distributor", gic);
+			}
+		}
+	}
+}
