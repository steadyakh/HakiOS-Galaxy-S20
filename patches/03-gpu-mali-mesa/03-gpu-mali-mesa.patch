+ * IOConnectCallStructMethod's Mach message and its copies -- after runs 104-107 those two calls were about a fifth of
+ * the window server's drawing thread (glprof). The Galaxy S9+ port does the same (danstronics/ios-s9plus-exynos,
+ * hakios.mali_fast.h). Trap 0: SUBMIT, p1 the user's 40-byte drm_panfrost_submit (its out_sync written back); trap 1:
+ * WAIT_BO, p1 its 16 bytes. tools/mesa/hakios-drm/hakios.drm.c uses them when the first answers.
+ */
+IOExternalTrap *
+HakiosGPUUserClient::getTargetAndTrapForIndex(IOService ** targetP, UInt32 index)
+{
+	static IOExternalTrap traps[2] = {
+		{ NULL, (IOTrap) &HakiosGPUUserClient::trapSubmit },
+		{ NULL, (IOTrap) &HakiosGPUUserClient::trapWaitBo },
+	};
