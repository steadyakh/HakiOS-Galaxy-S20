+/* The surface of the panel's size that a frame for the panel is stretched into, made the first time: false if none. */
+static bool
+panel_twin(struct eagl *e, struct image *image)
+{
+	int32_t numbers[6] = { (int32_t)panel_w, (int32_t)panel_h, 4, (int32_t)panel_w * 4, 0x42475241 /* 'BGRA' */,
+	                       (int32_t)IOSurfaceGetID(image->surface) };
+	const void *keys[6] = { CFSTR("IOSurfaceWidth"), CFSTR("IOSurfaceHeight"), CFSTR("IOSurfaceBytesPerElement"),
+	                        CFSTR("IOSurfaceBytesPerRow"), CFSTR("IOSurfacePixelFormat"), CFSTR("HakiosPanelTwinOf") };
+	const void *values[6];
+	CFDictionaryRef properties;
+	GLint bound = 0;
+
+	if (image->twin_mirror != 0) {
+		return true;
+	}
+	if (image->twin_failed || panel_w == 0 || (uint32_t)image->width >= panel_w || image->mirror == 0) {
+		return false;
+	}
+	image->twin_failed = true;      /* (until it is made) */
+	for (int i = 0; i < 6; i++) {
+		values[i] = CFNumberCreate(NULL, kCFNumberSInt32Type, &numbers[i]);
+	}
+	properties = CFDictionaryCreate(NULL, keys, values, 6, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+	for (int i = 0; i < 6; i++) {
+		CFRelease(values[i]);
+	}
+	image->twin = properties != NULL ? IOSurfaceCreate(properties) : NULL;
+	if (properties != NULL) {
+		CFRelease(properties);
+	}
+	if (image->twin == NULL) {
+		say("hakios-gl: no surface of the panel's size (%u x %u) for surface %u: stretched by the display's driver\n",
+		    panel_w, panel_h, IOSurfaceGetID(image->surface));
+		return false;
+	}
+	glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+	glGenTextures(1, &image->twin_mirror);
+	glBindTexture(GL_TEXTURE_2D, image->twin_mirror);
+	if (!hakios_gl_surface_texture(e->gl, IOSurfaceGetID(image->twin))) {
+		glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+		say("hakios-gl: the library refused surface %u (%u x %u, the panel's size): stretched by the display's driver\n",
+		    IOSurfaceGetID(image->twin), panel_w, panel_h);
+		image_drop_twin(image);
+		return false;
+	}
+	glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
