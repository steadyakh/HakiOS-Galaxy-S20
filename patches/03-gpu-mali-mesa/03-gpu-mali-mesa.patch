+/*
+ * THE WAY IN (13 Nov, runs 57-69). Samsung's hypervisor (H-Arx, EL2) handles the kernel's stores to the GPU, its
+ * power-domain page and its clock pages in software, and for stores made through the kernel's own (TTBR1) mappings
+ * it drops them: reads come back right, writes never arrive -- from the first C code on; U-Boot's, the loader's and
+ * the kernel's MMU-off stores (start.s) all land. Through a table of our own in TTBR0, for the moment of the access,
+ * every store tried landed (runs 60-63, 65). So every access to those blocks goes that way here: a private lower-half
+ * window at LOW_BASE (4K pages, Device-nGnRnE: the kernel's MAIR index 3), entered with interrupts off, TTBR0 put back
+ * and this core's TLB emptied around each access. Slow (two TLB flushes per access) but sure; a few dozen accesses
+ * per GPU job.
+ *
+ * Faster (13 Nov, after run 79): an access empties only the TLB's entry for its own page (tlbi vaae1: that page, any
+ * ASID, its table walk too) instead of the whole TLB of this core twice -- every look at whether a job is done was
+ * two whole flushes, a few thousand a second while CoreAnimation draws, and every program on the core paid for them
+ * in refills. Loads need the window as much as stores: through a kernel (TTBR1) mapping of the power-domain page,
+ * every load gave back what the destination register held before, its own address (run 82: "configuration
+ * 0x40005200") -- the hypervisor skips them too. Boot-arg mali_slow=1: the whole flushes, as before.
+ */
+#define LOW_BASE                0x40000000ull
+#define LOW_PAGES               32
+
+static uint64_t low_l1[512] __attribute__((aligned(4096)));
+static uint64_t low_l2[512] __attribute__((aligned(4096)));
+static uint64_t low_l3[512] __attribute__((aligned(4096)));
+static uint64_t low_l1pa;
+static uint32_t low_next;
+static uint32_t low_slow;                       /* mali_slow=1: whole TLB flushes around each access */
+
+static void
+low_flush(void *start, size_t size)
+{
+	for (uintptr_t line = (uintptr_t)start & ~(uintptr_t)63; line < (uintptr_t)start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+/* `pages` 4K pages of device registers from `pa` into the window: the VA that stands for `pa` there, or 0 */
+static vm_offset_t
+low_map(uint64_t pa, uint32_t pages)
+{
+	vm_offset_t va;
+
+	if (low_l1pa == 0) {
+		(void)PE_parse_boot_argn("mali_slow", &low_slow, sizeof(low_slow));
+		low_l1[1] = kvtophys((vm_offset_t)low_l2) | 3;          /* VA 0x40000000: level-1 entry 1 */
+		low_l2[0] = kvtophys((vm_offset_t)low_l3) | 3;
+		low_flush(low_l1, sizeof(low_l1));
+		low_flush(low_l2, sizeof(low_l2));
+		low_l1pa = kvtophys((vm_offset_t)low_l1);
+	}
+	if (low_next + pages > LOW_PAGES) {
+		return 0;
+	}
+	va = (vm_offset_t)(LOW_BASE + 4096ull * low_next + (pa & 0xfff));
+	for (uint32_t i = 0; i < pages; i++) {
+		low_l3[low_next++] = ((pa & ~0xfffull) + 4096ull * i) | 3ull << 2 | 1ull << 10 | 1ull << 53 | 1ull << 54 | 3;
+	}
+	low_flush(low_l3, sizeof(low_l3));
+	return va;
+}
+
+static inline bool
+in_low(vm_offset_t address)
+{
+	return low_l1pa != 0 && address >= LOW_BASE && address < LOW_BASE + 4096ull * LOW_PAGES;
+}
+
+/* A load through the window, emptying only its page's TLB entry (any ASID) before and after: see above. */
+static uint32_t __attribute__((noinline))
+low_load(vm_offset_t address)
+{
+	boolean_t was = ml_set_interrupts_enabled(FALSE);
+	uint64_t old0, got = 0, page = ((uint64_t)address >> 12) & 0xfffffffffffull;
+
+	__asm__ volatile ("mrs %0, ttbr0_el1" : "=r" (old0));
+	__asm__ volatile (
+	    "  dsb sy\n"
+	    "  msr ttbr0_el1, %[t]\n"
+	    "  isb\n"
+	    "  tlbi vaae1, %[p]\n"
+	    "  dsb sy\n"
+	    "  isb\n"
+	    "  ldr %w[g], [%[a]]\n"
+	    "  dsb sy\n"
+	    "  msr ttbr0_el1, %[o]\n"
+	    "  isb\n"
+	    "  tlbi vaae1, %[p]\n"
+	    "  dsb sy\n"
+	    "  isb\n"
+	    : [g] "=&r" (got) : [t] "r" (low_l1pa), [a] "r" (address), [o] "r" (old0), [p] "r" (page) : "memory");
+	(void)ml_set_interrupts_enabled(was);
+	return (uint32_t)got;
+}
+
+/* A store through the window, the same way. */
+static void __attribute__((noinline))
+low_store(vm_offset_t address, uint32_t value)
+{
+	boolean_t was = ml_set_interrupts_enabled(FALSE);
+	uint64_t old0, page = ((uint64_t)address >> 12) & 0xfffffffffffull;
+
+	__asm__ volatile ("mrs %0, ttbr0_el1" : "=r" (old0));
+	__asm__ volatile (
+	    "  dsb sy\n"
+	    "  msr ttbr0_el1, %[t]\n"
+	    "  isb\n"
+	    "  tlbi vaae1, %[p]\n"
+	    "  dsb sy\n"
+	    "  isb\n"
+	    "  str %w[v], [%[a]]\n"
+	    "  dsb sy\n"
+	    "  msr ttbr0_el1, %[o]\n"
+	    "  isb\n"
+	    "  tlbi vaae1, %[p]\n"
+	    "  dsb sy\n"
+	    "  isb\n"
+	    : : [t] "r" (low_l1pa), [v] "r" (value), [a] "r" (address), [o] "r" (old0), [p] "r" (page) : "memory");
+	(void)ml_set_interrupts_enabled(was);
+}
+
+static uint32_t __attribute__((noinline))
+low_access(vm_offset_t address, uint32_t value, bool write)
+{
+	boolean_t was;
+	uint64_t old0, got = 0;
+
+	if (!low_slow) {
+		if (write) {
+			low_store(address, value);
+			return 0;
+		}
+		return low_load(address);
+	}
+	was = ml_set_interrupts_enabled(FALSE);
+	__asm__ volatile ("mrs %0, ttbr0_el1" : "=r" (old0));
+	if (write) {
+		__asm__ volatile (
+		    "  dsb sy\n"
+		    "  msr ttbr0_el1, %[t]\n"
+		    "  isb\n"
+		    "  tlbi vmalle1\n"
+		    "  dsb sy\n"
+		    "  isb\n"
+		    "  str %w[v], [%[a]]\n"
+		    "  dsb sy\n"
+		    "  msr ttbr0_el1, %[o]\n"
+		    "  isb\n"
+		    "  tlbi vmalle1\n"
+		    "  dsb sy\n"
+		    "  isb\n"
+		    : : [t] "r" (low_l1pa), [v] "r" (value), [a] "r" (address), [o] "r" (old0) : "memory");
+	} else {
+		__asm__ volatile (
+		    "  dsb sy\n"
+		    "  msr ttbr0_el1, %[t]\n"
+		    "  isb\n"
+		    "  tlbi vmalle1\n"
+		    "  dsb sy\n"
+		    "  isb\n"
+		    "  ldr %w[g], [%[a]]\n"
+		    "  dsb sy\n"
+		    "  msr ttbr0_el1, %[o]\n"
+		    "  isb\n"
+		    "  tlbi vmalle1\n"
+		    "  dsb sy\n"
+		    "  isb\n"
+		    : [g] "=&r" (got) : [t] "r" (low_l1pa), [a] "r" (address), [o] "r" (old0) : "memory");
+	}
+	(void)ml_set_interrupts_enabled(was);
+	return (uint32_t)got;
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	if (in_low(address)) {
+		return low_access(address, 0, false);
+	}
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	if (in_low(address)) {
+		(void)low_access(address, value, true);
+		return;
+	}
+	__asm__ volatile ("dsb sy; str %w0, [%1]; dsb sy" : : "r" (value), "r" (address) : "memory");
+}
+
+#define G(reg)          rd(mali + (reg))
+#define P(reg, value)   wr(mali + (reg), (value))
+
+/* until (register & mask) == want, at most ms milliseconds: true if it came */
+static bool
+wait_for(uint32_t reg, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us <= ms * 1000; us += 10) {
+		if ((G(reg) & mask) == want) {
+			return true;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	return (G(reg) & mask) == want;
+}
+
+/* Push what this processor wrote out of its cache to memory, and forget it: the GPU reads and writes memory. */
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+/* the G3D temperature, or -1: from the heat guard (hakios.exynos_thermal.c), which must be running */
+static int
+g3d_celsius(void)
+{
+	return hakios_exynos_temperature(G3D_ZONE);
+}
+
+static bool
+cool_enough(const char *before)
+{
+	int t = g3d_celsius();
+
+	if (t < 0) {
+		say("mali: no G3D temperature (is exynos_thermal=1 given?): nothing powered on %s\n", before);
+		return false;
+	}
+	if (t >= (int)hot_c) {
+		say("mali: G3D at %d C, at or above mali_hot=%u: nothing powered on %s\n", t, hot_c, before);
+		return false;
+	}
+	say("mali: G3D at %d C (limit %u C)\n", t, hot_c);
+	return true;
+}
+
+/* ---- step 1: look -------------------------------------------------------------------------------- */
+
+static bool
+step_look(void)
+{
+	uint32_t con0 = rd(cmu_top + PLL_CON0_PLL_G3D), con3 = rd(cmu_top + PLL_CON3_PLL_G3D);
+	uint32_t m = (con3 >> 16) & 0x3ff, p = (con3 >> 8) & 0x3f, s = con3 & 7;
+	uint32_t status = rd(pmu + PMU_G3D_STATUS), id;
+
+	say("mali: G3D domain: configuration %#x, status %#x (%s)\n", rd(pmu + PMU_G3D_CONFIGURATION), status,
+	    (status & 1) ? "on" : "OFF");
+	say("mali: G3D PLL: con0 %#x con3 %#x: %s, %s, %u MHz from 26 MHz (M %u P %u S %u); the mux after it takes %s\n",
+	    con0, con3, (con3 >> 31) ? "on" : "off", (con3 >> 29 & 1) ? "locked" : "not locked",
+	    p ? (uint32_t)(26ull * m / ((uint64_t)p << s)) : 0, m, p, s, (con0 >> 4 & 1) ? "the PLL" : "the crystal");
+	say("mali: G3D temperature: %d C\n", g3d_celsius());
+	/*
+	 * Samsung's power-on of this domain (cal-if/exynos9830/flexpmu_cal_local_exynos9830.h, embedded_g3d_on[]):
+	 * PLL_CON1_PLL_G3D = 0x30000003, PLL_CON0_PLL_G3D bit 4 = 1, CMU_G3D +0x600 bit 4 = 1, PMU +0x2220 |= 2, a delay,
+	 * CONFIGURATION = 1, wait STATUS bit 0; its power-off leaves PLL_CON1_PLL_G3D = 0x10000001. Read only here.
+	 */
+	say("mali: PLL_CON1_PLL_G3D %#x (Samsung: 0x30000003 on, 0x10000001 off), EMBEDDED_G3D_OUT %#x (on: bit 1)\n",
+	    rd(cmu_top + 0x104), rd(pmu + 0x220));
+	{
+		/* Samsung's exynos_acpm_get_rate(): channel 5 (acpm_dvfs), cmd {domain, 0, FREQ_GET = 1, 0}, the answer in
+		 * cmd[1] in kHz; the GPU is domain 10 (g3d_cmu_cal_id 0xb04000a & 0xffff). A question: nothing is set. */
+		uint32_t q[4] = { ACPM_DVFS_G3D, 0, ACPM_FREQ_GET, 0 };
+		int r = hakios_exynos_acpm(ACPM_CH_DVFS, q);
+
+		say("mali: the APM says the GPU's clock is %u kHz (answer %d: %#x %#x %#x %#x)\n", r == 0 ? q[1] : 0, r,
+		    q[0], q[1], q[2], q[3]);
+		hakios_exynos_acpm_show(ACPM_CH_DVFS);          /* (read only: why it does or does not answer) */
+		hakios_exynos_acpm_show(9);                     /* the TMU's, which answers, to compare */
+		hakios_exynos_acpm_list();                      /* by place: Samsung's acpm_ipc.c sends to channel[5] by place */
+	}
+	/* (CMU_G3D +0x83c, which the device tree names, is not to be read from here: run 33, a synchronous external abort) */
+	if (!(status & 1)) {
+		say("mali: the GPU's power domain is off: its registers are not read, and the steps end here (step G2 is "
+		    "switching it on)\n");
+		return false;
+	}
+	id = G(GPU_ID);
+	shader_present = (uint64_t)G(SHADER_PRESENT_HI) << 32 | G(SHADER_PRESENT_LO);
+	tiler_present = G(TILER_PRESENT_LO);
+	l2_present = G(L2_PRESENT_LO);
+	js_present = G(JS_PRESENT);
+	as_present = G(AS_PRESENT);
+	pa_bits = (G(MMU_FEATURES) >> 8) & 0xff;
+	say("mali: GPU_ID %#x (product %#x, r%up%u), GPU_STATUS %#x\n", id, id >> 16, (id >> 12) & 0xf, (id >> 4) & 0xff,
+	    G(GPU_STATUS));
+	say("mali: L2_FEATURES %#x CORE_FEATURES %#x TILER_FEATURES %#x MEM_FEATURES %#x MMU_FEATURES %#x\n",
+	    G(L2_FEATURES), G(CORE_FEATURES), G(TILER_FEATURES), G(MEM_FEATURES), G(MMU_FEATURES));
+	say("mali: present: shaders %#llx, tiler %#x, L2 %#x, address spaces %#x, job slots %#x\n", shader_present,
+	    tiler_present, l2_present, as_present, js_present);
+	say("mali: ready: shaders %#x, tiler %#x, L2 %#x; coherency features %#x enable %#x\n", G(SHADER_READY_LO),
+	    G(TILER_READY_LO), G(L2_READY_LO), G(COHERENCY_FEATURES), G(COHERENCY_ENABLE));
+	say("mali: interrupts raw: GPU %#x job %#x MMU %#x; masks: GPU %#x job %#x MMU %#x; fault %#x at %#x\n",
+	    G(GPU_IRQ_RAWSTAT), G(JOB_IRQ_RAWSTAT), G(MMU_IRQ_RAWSTAT), G(GPU_IRQ_MASK), G(JOB_IRQ_MASK),
+	    G(MMU_IRQ_MASK), G(GPU_FAULTSTATUS), G(GPU_FAULTADDRESS_LO));
+	if ((id >> 16) != 0x9080) {
+		say("mali: not the Mali-G77 this was written for: the steps end here\n");
+		return false;
+	}
+	if (shader_present == 0 || l2_present == 0 || !(js_present & 1u << JOB_SLOT) || !(as_present & 1) || pa_bits < 32) {
+		say("mali: something the steps need is missing: they end here\n");
+		return false;
+	}
+	return true;
+}
+
+/* ---- step 2: soft reset -------------------------------------------------------------------------- */
+
+static void
+masks_off(void)
+{
+	P(GPU_IRQ_MASK, 0);
+	P(JOB_IRQ_MASK, 0);
+	P(MMU_IRQ_MASK, 0);
+}
+
+/*
+ * Do our writes reach the GPU? Runs 32-34: clearing the interrupt status did nothing and no power-on was ever seen,
+ * while every read answered. AS 0's table address is a plain register that does nothing until AS_COMMAND_UPDATE: a
+ * number written there is read back, then 0 again.
+ */
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern unsigned long long ml_phys_read_double_64(addr64_t paddr);
+
+/*
+ * How the kernel maps an address: the stage-1 descriptors of a kernel VA, walked by hand from TTBR1_EL1 (13 Nov: the
+ * loader's writes to the GPU stick before and after a kernel run, the kernel's never do, its reads are right).
+ */
+static void
+show_mapping(const char *what, vm_offset_t va)
+{
+	uint64_t tcr, ttbr1, mair, table, desc = 0;
+	unsigned tg1, granule_shift, bits, t1sz, level, index_bits;
+
+	__asm__ volatile ("mrs %0, tcr_el1" : "=r" (tcr));
+	__asm__ volatile ("mrs %0, ttbr1_el1" : "=r" (ttbr1));
+	__asm__ volatile ("mrs %0, mair_el1" : "=r" (mair));
+	tg1 = (unsigned)(tcr >> 30) & 3;                /* 1: 16K, 2: 4K, 3: 64K */
+	granule_shift = tg1 == 1 ? 14 : tg1 == 3 ? 16 : 12;
+	t1sz = (unsigned)(tcr >> 16) & 0x3f;
+	bits = 64 - t1sz;
+	index_bits = granule_shift - 3;
+	level = (unsigned)(4 - (bits - granule_shift + index_bits - 1) / index_bits);
+	table = ttbr1 & 0x0000fffffffffffeull;
+	say("mali: %s: VA %#lx; TCR %#llx (granule %u K, %u bits), MAIR %#llx\n", what, (unsigned long)va, tcr,
+	    1u << (granule_shift - 10), bits, mair);
+	for (unsigned first = level; level <= 3; level++) {
+		unsigned shift = granule_shift + (3 - level) * index_bits;
+		unsigned width = level == first ? bits - shift : index_bits;   /* the top level indexes what is left */
+		uint64_t idx = (va >> shift) & ((1ull << width) - 1);
+
+		desc = ml_phys_read_double_64(table + idx * 8);
+		say("mali:   level %u entry %llu: %#llx\n", level, idx, desc);
+		if ((desc & 3) != 3 || level == 3) {
+			break;                          /* a block, the page, or nothing */
+		}
+		table = desc & 0x0000fffffffff000ull & ~((1ull << granule_shift) - 1);
+	}
+	say("mali:   -> AttrIndx %llu (MAIR byte %#llx), AP %llu (2,3: read only), output %#llx\n", (desc >> 2) & 7,
+	    (mair >> (8 * ((desc >> 2) & 7))) & 0xff, (desc >> 6) & 3, desc & 0x0000fffffffff000ull);
+}
+
+/* the write test through another mapping of the GPU's registers: normal memory, uncached (posted, combined) */
+static void
+__unused writes_land_other(void)
+{
+	vm_offset_t m = ml_io_map_wcomb(MALI_PA, 0x4000);
+	uint32_t seen, after;
+
+	if (m == 0) {
+		return;
+	}
+	show_mapping("the GPU, uncached-normal mapping", m);
+	wr(m + AS(0) + AS_TRANSTAB_LO, 0x5a5a5000u);
+	seen = rd(m + AS(0) + AS_TRANSTAB_LO);
+	wr(m + AS(0) + AS_TRANSTAB_LO, 0);
+	after = rd(m + AS(0) + AS_TRANSTAB_LO);
+	say("mali: write test through the uncached-normal mapping: read %#x, then %#x: %s\n", seen, after,
+	    seen == 0x5a5a5000u && after == 0 ? "WRITES REACH THE GPU THIS WAY" : "not this way either");
+}
+
+static bool
+writes_land(void)
+{
+	uint32_t seen, after;
+
+	P(AS(0) + AS_TRANSTAB_LO, 0x5a5a5000u);
+	seen = G(AS(0) + AS_TRANSTAB_LO);
+	P(AS(0) + AS_TRANSTAB_LO, 0);
+	after = G(AS(0) + AS_TRANSTAB_LO);
+	say("mali: write test: AS 0 table address written 0x5a5a5000, read %#x; written 0, read %#x: %s\n", seen, after,
+	    seen == 0x5a5a5000u && after == 0 ? "OUR WRITES REACH THE GPU" : "our writes do NOT reach the GPU");
+	return seen == 0x5a5a5000u && after == 0;
+}
+
+/*
+ * Samsung's power-domain code (cal-if/pmucal_local.c, pmucal_local_enable()) switches the G3D domain on and then, for a
+ * domain whose device tree says need_smc (pd-embedded_g3d: 0x18410204), asks the secure firmware to restore the
+ * block's protection settings (its TZPC): exynos_pd_tz_restore() = exynos_smc(SMC_CMD_PREAPRE_PD_ONOFF 0x82000410,
+ * EXYNOS_WAKEUP_PD_DOWN 1, 0x18410204, RUNTIME_PM_TZPC_GROUP 2) (exynos-el3_mon.c, include/linux/smc.h). Until then the
+ * block's registers may be the secure world's to write. Only with mali_tz=1 (the owner's OK, 12 Nov).
+ */
+static uint64_t
+smc4(uint64_t function, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+#define SMC_CMD_PREAPRE_PD_ONOFF        0x82000410u
+#define EXYNOS_WAKEUP_PD_DOWN           1u
+#define G3D_NEED_SMC                    0x18410204u
+#define RUNTIME_PM_TZPC_GROUP           2u
+
+static void
+tz_restore(void)
+{
+	uint64_t ret;
+
+	say("mali: asking the secure firmware to restore the G3D block's protection (as Samsung's kernel does after the "
+	    "domain comes on)\n");
+	ret = smc4(SMC_CMD_PREAPRE_PD_ONOFF, EXYNOS_WAKEUP_PD_DOWN, G3D_NEED_SMC, RUNTIME_PM_TZPC_GROUP);
+	say("mali: secure firmware answered %#llx (0: done)\n", ret);
+}
+
+static bool
+soft_reset(void)
+{
+	masks_off();
+	P(GPU_IRQ_CLEAR, 0xffffffffu);
+	say("mali: before the reset: GPU raw %#x after clearing it (0: our writes reach the GPU), latest flush %#x\n",
+	    G(GPU_IRQ_RAWSTAT), G(LATEST_FLUSH));
+	if (G(GPU_IRQ_RAWSTAT) & GPU_IRQ_RESET_COMPLETED) {
+		say("mali: the old \"reset completed\" did not clear: no reset can be seen\n");
+		return false;
+	}
+	P(GPU_COMMAND, GPU_CMD_SOFT_RESET);
+	if (!wait_for(GPU_IRQ_RAWSTAT, GPU_IRQ_RESET_COMPLETED, GPU_IRQ_RESET_COMPLETED, 100)) {
+		say("mali: no RESET_COMPLETED within 100 ms (raw %#x, status %#x)\n", G(GPU_IRQ_RAWSTAT), G(GPU_STATUS));
+		return false;
+	}
+	P(GPU_IRQ_CLEAR, 0xffffffffu);
+	masks_off();
+	P(JOB_IRQ_CLEAR, 0xffffffffu);
+	P(MMU_IRQ_CLEAR, 0xffffffffu);
+	return true;
+}
+
+/*
+ * The GPU's clock, as Samsung's power-on of the domain starts it (embedded_g3d_on[], flexpmu_cal_local_exynos9830.h)
+ * before it switches the domain on. Run 41: S-BOOT leaves the domain on but PLL_CON1_PLL_G3D at 0x10000001 (what
+ * Samsung's power-off leaves) and EMBEDDED_G3D_OUT without bit 1: the GPU's registers answer reads, take no write.
+ * Only with mali_clk=1 (the owner's OK). The PLL's own frequency (PLL_CON3: 260 MHz) is not touched.
+ */
+#define PLL_CON1_PLL_G3D        0x104u
+#define PLL_G3D_RUN             0x30000003u
+#define PLL_G3D_STOPPED         0x10000001u
+#define PLL_G3D_LOCKED          (1u << 29)      /* of PLL_CON3 */
+#define CMU_G3D_PA              0x18400000u
+#define MUX_CLKCMU_G3D_USER     0x600u          /* bit 4: the CMU_TOP clock (1), not the crystal (0) */
+#define PMU_EMBEDDED_G3D_OUT    0x220u          /* bit 1 */
+
+static uint32_t clk_saved_con1, clk_saved_out, clk_saved_mux;
+static bool clk_started, mux_set;
+static vm_offset_t cmu_g3d;
+
+static void
+clock_start(void)
+{
+	uint32_t con3 = 0;
+
+	clk_saved_con1 = rd(cmu_top + PLL_CON1_PLL_G3D);
+	clk_saved_out = rd(pmu + PMU_EMBEDDED_G3D_OUT);
+	say("mali: starting the GPU's clock as Samsung does: PLL_CON1 %#x -> %#x, EMBEDDED_G3D_OUT %#x -> %#x\n",
+	    clk_saved_con1, PLL_G3D_RUN, clk_saved_out, clk_saved_out | 2);
+	clk_started = true;
+	wr(cmu_top + PLL_CON1_PLL_G3D, PLL_G3D_RUN);
+	if (!(rd(cmu_top + PLL_CON0_PLL_G3D) & 0x10)) {
+		wr(cmu_top + PLL_CON0_PLL_G3D, rd(cmu_top + PLL_CON0_PLL_G3D) | 0x10);
+	}
+	for (uint32_t us = 0; us < 10000; us += 10) {
+		con3 = rd(cmu_top + PLL_CON3_PLL_G3D);
+		if (con3 & PLL_G3D_LOCKED) {
+			break;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	say("mali: PLL_G3D: con1 %#x con3 %#x: %s\n", rd(cmu_top + PLL_CON1_PLL_G3D), con3,
+	    (con3 & PLL_G3D_LOCKED) ? "LOCKED" : "still not locked");
+	if (!(con3 & PLL_G3D_LOCKED)) {
+		return;
+	}
+	cmu_g3d = low_map(CMU_G3D_PA, 1);
+	if (cmu_g3d != 0) {
+		clk_saved_mux = rd(cmu_g3d + MUX_CLKCMU_G3D_USER);     /* (run 33: CMU_G3D could not be read; with the PLL on?) */
+		say("mali: CMU_G3D user mux %#x\n", clk_saved_mux);
+		if (!(clk_saved_mux & 0x10)) {
+			wr(cmu_g3d + MUX_CLKCMU_G3D_USER, clk_saved_mux | 0x10);
+			mux_set = true;
+			say("mali: CMU_G3D user mux now %#x\n", rd(cmu_g3d + MUX_CLKCMU_G3D_USER));
+		}
+	}
+	wr(pmu + PMU_EMBEDDED_G3D_OUT, clk_saved_out | 2);
+	delay_for_interval(20, NSEC_PER_USEC);
+	say("mali: EMBEDDED_G3D_OUT now %#x\n", rd(pmu + PMU_EMBEDDED_G3D_OUT));
+}
+
+/* everything clock_start() changed, back as it was, in Samsung's power-off order */
+static void
+clock_stop(void)
+{
+	if (!clk_started) {
+		return;
+	}
+	wr(pmu + PMU_EMBEDDED_G3D_OUT, clk_saved_out);
+	if (mux_set) {
+		wr(cmu_g3d + MUX_CLKCMU_G3D_USER, clk_saved_mux);
+	}
+	wr(cmu_top + PLL_CON1_PLL_G3D, clk_saved_con1);
+	clk_started = mux_set = false;
+	say("mali: the GPU's clock as it was: PLL_CON1 %#x, EMBEDDED_G3D_OUT %#x\n", rd(cmu_top + PLL_CON1_PLL_G3D),
+	    rd(pmu + PMU_EMBEDDED_G3D_OUT));
+}
+
+/*
+ * The G3D domain switched off and on again exactly as Samsung's kernel does it (cal-if/pmucal_local.c with
+ * exynos9830/flexpmu_cal_local_exynos9830.h embedded_g3d_off[] / embedded_g3d_on[], and exynos-el3_mon.c's TZPC save
+ * and restore). TWRP's Linux, 12 Nov: after such a cycle its Mali driver writes SHADER_PWRON and the cores come on;
+ * S-BOOT only ever leaves the domain on with the GPU's PLL stopped, and nothing of ours reached the GPU in that state
+ * (runs 32-43, with the PLL started and the TZPC restored by themselves too). Only with mali_cycle=1 (owner's OK).
+ *   off: TZPC save (SMC 0x82000410, 0, 0x18410204, 2); CONFIGURATION bit 0 = 0, wait STATUS bit 0 = 0; CMU_G3D +0x600
+ *        bit 4 = 0; PLL_CON0_PLL_G3D bit 4 = 0; PLL_CON1_PLL_G3D = 0x10000001
+ *   on:  PLL_CON1_PLL_G3D = 0x30000003; PLL_CON0_PLL_G3D bit 4 = 1; CMU_G3D +0x600 bit 4 = 1; EMBEDDED_G3D_OUT: bit 2
+ *        set through the PMU's atomic "set" alias (+0xc000, written with the bit's number, as exynos-pmu.c does);
+ *        280 us; CONFIGURATION bit 0 = 1, wait STATUS bit 0 = 1; TZPC restore (SMC 0x82000410, 1, 0x18410204, 2)
+ */
+#define EXYNOS_GET_IN_PD_DOWN           0u
+#define PMU_SET_ALIAS_PA                0x1586e000u     /* 0x15860000 + (0x2220 | 0xc000), its page */
+
+static vm_offset_t pmu_set;
+static bool cycled;
+
+static bool
+wait_status(uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us <= ms * 1000; us += 10) {
+		if ((rd(pmu + PMU_G3D_STATUS) & 1) == want) {
+			return true;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	return false;
+}
+
+static void
+domain_off(void)
+{
+	uint64_t r = smc4(SMC_CMD_PREAPRE_PD_ONOFF, EXYNOS_GET_IN_PD_DOWN, G3D_NEED_SMC, RUNTIME_PM_TZPC_GROUP);
+	bool off;
+
+	say("mali: G3D off as Samsung does it: TZPC save answered %#llx\n", r);
+	wr(pmu + PMU_G3D_CONFIGURATION, rd(pmu + PMU_G3D_CONFIGURATION) & ~1u);
+	off = wait_status(0, 10);
+	if (cmu_g3d != 0) {
+		wr(cmu_g3d + MUX_CLKCMU_G3D_USER, rd(cmu_g3d + MUX_CLKCMU_G3D_USER) & ~0x10u);
+	}
+	wr(cmu_top + PLL_CON0_PLL_G3D, rd(cmu_top + PLL_CON0_PLL_G3D) & ~0x10u);
+	wr(cmu_top + PLL_CON1_PLL_G3D, PLL_G3D_STOPPED);
+	say("mali: G3D %s: status %#x, PLL con0 %#x con3 %#x\n", off ? "OFF" : "did not go off", rd(pmu + PMU_G3D_STATUS),
+	    rd(cmu_top + PLL_CON0_PLL_G3D), rd(cmu_top + PLL_CON3_PLL_G3D));
+}
+
+static bool
+domain_on(void)
+{
+	uint64_t r;
+	uint32_t con3 = 0;
+	bool on;
+
+	wr(cmu_top + PLL_CON1_PLL_G3D, PLL_G3D_RUN);
+	wr(cmu_top + PLL_CON0_PLL_G3D, rd(cmu_top + PLL_CON0_PLL_G3D) | 0x10u);
+	for (uint32_t us = 0; us < 10000 && !(con3 & PLL_G3D_LOCKED); us += 10) {
+		con3 = rd(cmu_top + PLL_CON3_PLL_G3D);
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	if (cmu_g3d != 0) {
+		wr(cmu_g3d + MUX_CLKCMU_G3D_USER, rd(cmu_g3d + MUX_CLKCMU_G3D_USER) | 0x10u);
+	}
+	wr(pmu_set + (PMU_EMBEDDED_G3D_OUT & 0xfffu), 2);       /* bit 2 of EMBEDDED_G3D_OUT, atomically */
+	delay_for_interval(280, NSEC_PER_USEC);
+	wr(pmu + PMU_G3D_CONFIGURATION, rd(pmu + PMU_G3D_CONFIGURATION) | 1u);
+	on = wait_status(1, 10);
+	r = smc4(SMC_CMD_PREAPRE_PD_ONOFF, EXYNOS_WAKEUP_PD_DOWN, G3D_NEED_SMC, RUNTIME_PM_TZPC_GROUP);
+	say("mali: G3D on as Samsung does it: %s (status %#x), PLL con3 %#x (%s), out %#x, TZPC restore answered %#llx\n",
+	    on ? "ON" : "did not come on", rd(pmu + PMU_G3D_STATUS), con3, (con3 & PLL_G3D_LOCKED) ? "locked" : "not locked",
+	    rd(pmu + PMU_EMBEDDED_G3D_OUT), r);
+	return on;
+}
+
+static bool
+domain_cycle(void)
+{
+	pmu_set = low_map(PMU_SET_ALIAS_PA, 1);
+	if (cmu_g3d == 0) {
+		cmu_g3d = low_map(CMU_G3D_PA, 1);
+	}
+	if (pmu_set == 0 || cmu_g3d == 0) {
+		say("mali: could not map the PMU's set alias or CMU_G3D\n");
+		return false;
+	}
+	cycled = true;
+	domain_off();
+	delay_for_interval(1, NSEC_PER_MSEC);
+	return domain_on();
+}
+
+static bool
+step_reset(void)
+{
+	uint32_t tz = 0, clk = 0, cycle = 0;
+
+	if (!writes_land() && PE_parse_boot_argn("mali_cycle", &cycle, sizeof(cycle)) && cycle) {
+		if (!domain_cycle()) {
+			return false;
+		}
+	}
+	if (!writes_land()) {
+		if (PE_parse_boot_argn("mali_clk", &clk, sizeof(clk)) && clk) {
+			clock_start();
+		}
+		if (!writes_land()) {
+			if (!(PE_parse_boot_argn("mali_tz", &tz, sizeof(tz)) && tz)) {
+				return false;
+			}
+			tz_restore();
+			if (!writes_land()) {
+				return false;
+			}
+		}
+	}
+	if (!soft_reset()) {
+		return false;
+	}
+	say("mali: reset done; ready: shaders %#x tiler %#x L2 %#x, GPU_STATUS %#x, latest flush %#x\n",
+	    G(SHADER_READY_LO), G(TILER_READY_LO), G(L2_READY_LO), G(GPU_STATUS), G(LATEST_FLUSH));
+	return true;
+}
+
+/* ---- step 3: power ------------------------------------------------------------------------------- */
+
+static void
+power_off(void)
+{
+	uint32_t sl = G(SHADER_READY_LO), sh = G(SHADER_READY_HI), t = G(TILER_READY_LO), l2 = G(L2_READY_LO);
+
+	if (sl | sh) {
+		P(SHADER_PWROFF_LO, sl);
+		if (sh) {
+			P(SHADER_PWROFF_HI, sh);
+		}
+		wait_for(SHADER_READY_LO, 0xffffffffu, 0, 100);
+	}
+	if (t) {
+		P(TILER_PWROFF_LO, t);
+		wait_for(TILER_READY_LO, 0xffffffffu, 0, 100);
+	}
+	if (l2) {
+		P(L2_PWROFF_LO, l2);
+		wait_for(L2_READY_LO, 0xffffffffu, 0, 100);
+	}
+	powered = false;
+	say("mali: powered off: ready now shaders %#x tiler %#x L2 %#x (in transition %#x %#x %#x)\n", G(SHADER_READY_LO),
+	    G(TILER_READY_LO), G(L2_READY_LO), G(SHADER_PWRTRANS_LO), G(TILER_PWRTRANS_LO), G(L2_PWRTRANS_LO));
+}
+
+static bool
+step_power(void)
+{
+	if (!cool_enough("(step 3)")) {
+		return false;
+	}
+	powered = true;
+	P(L2_PWRON_LO, l2_present);
+	for (uint32_t i = 0; i < 4; i++) {
+		say("mali: %u us after L2 on: ready %#x, in transition %#x, GPU raw %#x, GPU_STATUS %#x, fault %#x\n",
+		    i * 20, G(L2_READY_LO), G(L2_PWRTRANS_LO), G(GPU_IRQ_RAWSTAT), G(GPU_STATUS), G(GPU_FAULTSTATUS));
+		delay_for_interval(20, NSEC_PER_USEC);
+	}
+	if (!wait_for(L2_READY_LO, l2_present, l2_present, 100)) {
+		say("mali: the L2 did not come on (ready %#x, in transition %#x)\n", G(L2_READY_LO), G(L2_PWRTRANS_LO));
+		return false;
+	}
+	if (tiler_present) {
+		P(TILER_PWRON_LO, tiler_present);
+		if (!wait_for(TILER_READY_LO, tiler_present, tiler_present, 100)) {
+			say("mali: the tiler did not come on (ready %#x)\n", G(TILER_READY_LO));
+			return false;
+		}
+	}
+	P(SHADER_PWRON_LO, (uint32_t)shader_present);
+	if (shader_present >> 32) {
+		P(SHADER_PWRON_HI, (uint32_t)(shader_present >> 32));
+	}
+	if (!wait_for(SHADER_READY_LO, (uint32_t)shader_present, (uint32_t)shader_present, 100)) {
+		say("mali: the shader cores did not all come on (ready %#x, in transition %#x)\n", G(SHADER_READY_LO),
+		    G(SHADER_PWRTRANS_LO));
+		return false;
+	}
+	say("mali: on: L2 %#x, tiler %#x, shaders %#x; GPU_STATUS %#x\n", G(L2_READY_LO), G(TILER_READY_LO),
+	    G(SHADER_READY_LO), G(GPU_STATUS));
+	return cool_enough("(after power on)");
+}
+
+/* ---- step 4: an address space -------------------------------------------------------------------- */
+
+static vm_offset_t tables, page;        /* 16K each: the four 4K tables; the page the GPU sees at GPU_VA */
+static uint64_t tables_phys, page_phys;
+
+/* 16K of wired memory, zero, that is in one piece in physical memory too */
+static bool
+contiguous(vm_offset_t *va, uint64_t *phys)
+{
+	if (kmem_alloc(kernel_map, va, 16384, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	*phys = kvtophys(*va);
+	for (uint32_t off = 4096; off < 16384; off += 4096) {
+		if (kvtophys(*va + off) != *phys + off) {
+			return false;
+		}
+	}
+	return *phys != 0 && (*phys & 4095) == 0 && (pa_bits >= 64 || (*phys + 16384) <= (1ull << pa_bits));
+}
+
+static bool
+step_space(void)
+{
+	uint64_t *l0, *l1, *l2, *l3;
+
+	if (!contiguous(&tables, &tables_phys) || !contiguous(&page, &page_phys)) {
+		say("mali: no memory in one piece for the tables or the page\n");
+		return false;
+	}
+	l0 = (uint64_t *)tables;
+	l1 = (uint64_t *)(tables + 4096);
+	l2 = (uint64_t *)(tables + 8192);
+	l3 = (uint64_t *)(tables + 12288);
+	l0[(GPU_VA >> 39) & 511] = ((tables_phys + 4096) & PTE_ADDRESS) | PTE_TABLE;
+	l1[(GPU_VA >> 30) & 511] = ((tables_phys + 8192) & PTE_ADDRESS) | PTE_TABLE;
+	l2[(GPU_VA >> 21) & 511] = ((tables_phys + 12288) & PTE_ADDRESS) | PTE_TABLE;
+	for (uint32_t i = 0; i < 4; i++) {
+		l3[((GPU_VA >> 12) & 511) + i] = ((page_phys + 4096 * i) & PTE_ADDRESS) | PTE_ACCESS_FLAG | PTE_ACCESS_RW |
+		    PTE_NX | PTE_PAGE;          /* memory kind 0: non-cacheable */
+	}
+	to_memory(tables, 16384);
+	to_memory(page, 16384);
+
+	P(AS(0) + AS_TRANSCFG_LO, AS_TRANSCFG_ADRMODE_AARCH64_4K | AS_TRANSCFG_PTW_NON_CACHEABLE);
+	P(AS(0) + AS_TRANSCFG_HI, 0);
+	P(AS(0) + AS_TRANSTAB_LO, (uint32_t)tables_phys);
+	P(AS(0) + AS_TRANSTAB_HI, (uint32_t)(tables_phys >> 32));
+	P(AS(0) + AS_MEMATTR_LO, AS_MEMATTR_NON_CACHEABLE);
+	P(AS(0) + AS_MEMATTR_HI, AS_MEMATTR_NON_CACHEABLE);
+	P(AS(0) + AS_COMMAND, AS_COMMAND_UPDATE);
+	if (!wait_for(AS(0) + AS_STATUS, 1, 0, 100)) {
+		say("mali: AS 0 still busy after its update (status %#x)\n", G(AS(0) + AS_STATUS));
+		return false;
+	}
+	P(MMU_IRQ_CLEAR, 0xffffffffu);
+	say("mali: AS 0: tables at %#llx, GPU %#llx-%#llx -> %#llx; transcfg %#x memattr %#x status %#x\n", tables_phys,
+	    GPU_VA, GPU_VA + 16383, page_phys, G(AS(0) + AS_TRANSCFG_LO), G(AS(0) + AS_MEMATTR_LO), G(AS(0) + AS_STATUS));
+	return true;
+}
+
+/* ---- step 5: a job ------------------------------------------------------------------------------- */
+
+#define JOB_TYPE_WRITE_VALUE    2
+#define WRITE_VALUE_IMM32       6
+#define TARGET_OFFSET           0x1000          /* in the page: where the job writes, a 4K page after the job */
+#define MAGIC                   0x6a0b77u       /* what it writes */
+
+static bool
+step_job(void)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page;
+	volatile uint32_t *target = (volatile uint32_t *)(page + TARGET_OFFSET);
+	uint32_t raw, js_status, cfg;
+	uint64_t start, end, ns;
+	bool done;
+
+	/* the job header (64-byte aligned) and the write-value payload after it, at +0x20 */
+	job[0] = 0;                                     /* exception status: the GPU writes 1 here when it is done */
+	job[1] = 0;                                     /* first incomplete task */
+	job[2] = job[3] = 0;                            /* fault pointer */
+	job[4] = 1u | JOB_TYPE_WRITE_VALUE << 1 | 1u << 16;     /* 64-bit descriptors, the type, index 1 */
+	job[5] = 0;                                     /* no dependencies */
+	job[6] = job[7] = 0;                            /* no next job */
+	job[8] = (uint32_t)(GPU_VA + TARGET_OFFSET);    /* the address written */
+	job[9] = (uint32_t)((GPU_VA + TARGET_OFFSET) >> 32);
+	job[10] = WRITE_VALUE_IMM32;
+	job[11] = 0;
+	job[12] = MAGIC;                                /* the value */
+	job[13] = 0;
+	*target = 0xdeadbeefu;
+	to_memory(page, 16384);
+
+	if (G(JS(JOB_SLOT) + JS_COMMAND_NEXT) != 0) {
+		say("mali: job slot %u is not free (command next %#x)\n", JOB_SLOT, G(JS(JOB_SLOT) + JS_COMMAND_NEXT));
+		return false;
+	}
+	if (!cool_enough("(step 5)")) {
+		return false;
+	}
+	P(JOB_IRQ_CLEAR, 0xffffffffu);
+	P(MMU_IRQ_CLEAR, 0xffffffffu);
+	cfg = 0 /* AS 0 */ | JS_CONFIG_START_FLUSH_CLEAN_INVALIDATE | JS_CONFIG_END_FLUSH_CLEAN_INVALIDATE |
+	    JS_CONFIG_THREAD_PRI(8);
+	P(JS(JOB_SLOT) + JS_HEAD_NEXT_LO, (uint32_t)GPU_VA);
+	P(JS(JOB_SLOT) + JS_HEAD_NEXT_HI, (uint32_t)(GPU_VA >> 32));
+	P(JS(JOB_SLOT) + JS_AFFINITY_NEXT_LO, (uint32_t)shader_present);
+	P(JS(JOB_SLOT) + JS_AFFINITY_NEXT_HI, (uint32_t)(shader_present >> 32));
+	P(JS(JOB_SLOT) + JS_CONFIG_NEXT, cfg);
+	start = mach_absolute_time();
+	P(JS(JOB_SLOT) + JS_COMMAND_NEXT, JS_COMMAND_START);
+
+	done = false;
+	for (uint32_t us = 0; us <= 100000 && !done; us += 10) {
+		raw = G(JOB_IRQ_RAWSTAT);
+		done = (raw & (1u << JOB_SLOT | 1u << (16 + JOB_SLOT))) != 0;
+		if (!done) {
+			delay_for_interval(10, NSEC_PER_USEC);
+		}
+	}
+	end = mach_absolute_time();
+	absolutetime_to_nanoseconds(end - start, &ns);
+	raw = G(JOB_IRQ_RAWSTAT);
+	js_status = G(JS(JOB_SLOT) + JS_STATUS);
+	say("mali: job: interrupts raw %#x, slot %u status %#x, head %#x, after %llu us; MMU raw %#x, AS 0 fault %#x at "
+	    "%#x%08x; GPU raw %#x fault %#x\n", raw, JOB_SLOT, js_status, G(JS(JOB_SLOT) + JS_HEAD_LO), ns / 1000,
+	    G(MMU_IRQ_RAWSTAT), G(AS(0) + AS_FAULTSTATUS), G(AS(0) + AS_FAULTADDRESS_HI), G(AS(0) + AS_FAULTADDRESS_LO),
+	    G(GPU_IRQ_RAWSTAT), G(GPU_FAULTSTATUS));
+	if (!done) {
+		say("mali: the job did not finish within 100 ms: hard stop\n");
+		P(JS(JOB_SLOT) + JS_COMMAND, JS_COMMAND_HARD_STOP);
+		delay_for_interval(10, NSEC_PER_MSEC);
+		say("mali: after the stop: interrupts raw %#x, slot status %#x\n", G(JOB_IRQ_RAWSTAT),
+		    G(JS(JOB_SLOT) + JS_STATUS));
+	}
+	P(JOB_IRQ_CLEAR, 0xffffffffu);
+	to_memory(page, 16384);                 /* forget what this processor remembers: read what the GPU wrote */
+	say("mali: memory: the job's status word %#x, the value at GPU %#llx: %#x (%s)\n", job[0],
+	    GPU_VA + TARGET_OFFSET, *target, *target == MAGIC ? "WRITTEN BY THE GPU" : "not written");
+	return done && (raw & 1u << JOB_SLOT) && *target == MAGIC;
+}
+
+/* ---- the GPU kept for the system: HakiosGPU's backend (mali_keep=1, Panfrost's interface) --------- */
+
+/*
+ * drivers/gpu/hakios.gpu.cpp serves Panfrost's requests (tools/mesa/hakios-drm, Mesa's panfrost) with these. GPU
+ * addresses 0x10000000-0x4fffffff (1 GB) in address space 0, 4K pages, four levels (the level-3 tables made as
+ * needed); every buffer non-cacheable for the GPU (MEMATTR 0x4c: the CPU maps them write-combined) and executable
+ * (shaders run from them). Jobs one at a time: a submission waits for the one before to finish; no interrupts yet,
+ * the job slots' state is asked for. Each register access through the low window (rd()/wr() above).
+ */
+bool hakios_mali_gpu_ready(void);
+bool hakios_mali_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t hakios_mali_gpu_address(uint64_t size);
+void hakios_mali_gpu_address_free(uint64_t address, uint64_t size);
+bool hakios_mali_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void hakios_mali_gpu_mapped(void);
+void hakios_mali_gpu_unmap(uint64_t address, uint64_t size);
+void hakios_mali_gpu_to_memory(void *start, uint64_t size);
+uint32_t hakios_mali_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool hakios_mali_gpu_done(uint32_t fence);
+uint32_t hakios_mali_gpu_last(void);
+void hakios_mali_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void hakios_mali_gpu_report(const char *why);
+void hakios_mali_gpu_stop(void);
+
+#define KEEP_VA_BASE            0x10000000ull
+#define KEEP_VA_PAGES           (1u << 18)              /* 1 GB of 4K pages */
+#define KEEP_L3_TABLES          (KEEP_VA_PAGES / 512)
+#define KEEP_ASK_US             50                      /* how often a submission looks at whether the job before is done */
+#define KEEP_SUBMIT_MS          2000                    /* the most a submission waits for the job before it */
+
+static bool kept;
+static uint64_t *k_l0, *k_l1, *k_l2[2];
+static uint64_t k_l0_pa;
+static uint64_t *k_l3[KEEP_L3_TABLES];
+static uint8_t *k_used;                                 /* a bit per GPU page of the range: given out */
+static uint32_t k_fence, k_done, k_busy_fence;          /* the last fence given, the last seen done, the one running */
+static int k_busy_slot = -1;
+/* the jobs given and not yet started, in order (hakios_mali_gpu_submit), and the lock over them and the GPU's job slots */
+#define K_QUEUE                 64
+struct k_job {
+	uint64_t jc;
+	uint32_t fence;
+	int slot;
+};
+static struct k_job k_queue[K_QUEUE];
+static uint32_t k_queue_first, k_queued;
+static bool k_queue_started;
+static LCK_GRP_DECLARE(k_group, "hakios_mali");
+static LCK_MTX_DECLARE(k_lock, &k_group);
+static void k_start(int slot, uint64_t jc, uint32_t fence);
+static void k_start_next(void);
+static void k_queue_init(void);
+static uint32_t k_jobs, k_faults;
+static uint64_t k_busy_since, k_worked_abs;
+
+static uint64_t *
+k_table(uint64_t *pa)
+{
+	vm_offset_t va = 0;
+
+	if (kmem_alloc(kernel_map, &va, 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	*pa = kvtophys(va);
+	to_memory(va, 4096);
+	return (uint64_t *)va;
+}
+
+/* the GPU's MMU told that the tables changed: the whole range locked, its TLB and walk caches flushed (FLUSH_MEM) */
+static void
+k_flush(void)
+{
+	/* LOCKADDR: a naturally aligned power of two, as log2(size) - 1 in bits 5:0 and the base above: 4 GB from 0 */
+	P(AS(0) + 0x10, 31);
+	P(AS(0) + 0x14, 0);
+	P(AS(0) + AS_COMMAND, 0x02);            /* LOCK */
+	wait_for(AS(0) + AS_STATUS, 1, 0, 10);
+	P(AS(0) + AS_COMMAND, 0x05);            /* FLUSH_MEM (and the lock goes) */
+	wait_for(AS(0) + AS_STATUS, 1, 0, 10);
+}
+
+static bool keep_space_again(void);
+
+static bool
+keep_space(void)
+{
+	uint64_t pa1, pa2[2];
+
+	{
+		vm_offset_t bits = 0;
+
+		if (kmem_alloc(kernel_map, &bits, KEEP_VA_PAGES / 8, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) ==
+		    KERN_SUCCESS) {
+			k_used = (uint8_t *)bits;
+		}
+	}
+	k_l0 = k_table(&k_l0_pa);
+	k_l1 = k_table(&pa1);
+	k_l2[0] = k_table(&pa2[0]);
+	k_l2[1] = k_table(&pa2[1]);
+	if (k_used == NULL || k_l0 == NULL || k_l1 == NULL || k_l2[0] == NULL || k_l2[1] == NULL) {
+		return false;
+	}
+	k_l0[0] = (pa1 & PTE_ADDRESS) | PTE_TABLE;
+	k_l1[0] = (pa2[0] & PTE_ADDRESS) | PTE_TABLE;          /* 0x00000000-0x3fffffff */
+	k_l1[1] = (pa2[1] & PTE_ADDRESS) | PTE_TABLE;          /* 0x40000000-0x7fffffff */
+	to_memory((vm_offset_t)k_l0, 4096);
+	to_memory((vm_offset_t)k_l1, 4096);
+	return keep_space_again();
+}
+
+/* address space 0 given its tables (made by keep_space()) and the quirks: at the start and after a reset */
+static bool
+keep_space_again(void)
+{
+	P(AS(0) + AS_TRANSCFG_LO, AS_TRANSCFG_ADRMODE_AARCH64_4K | AS_TRANSCFG_PTW_NON_CACHEABLE);
+	P(AS(0) + AS_TRANSCFG_HI, 0);
+	P(AS(0) + AS_TRANSTAB_LO, (uint32_t)k_l0_pa);
+	P(AS(0) + AS_TRANSTAB_HI, (uint32_t)(k_l0_pa >> 32));
+	P(AS(0) + AS_MEMATTR_LO, AS_MEMATTR_NON_CACHEABLE);
+	P(AS(0) + AS_MEMATTR_HI, AS_MEMATTR_NON_CACHEABLE);
+	P(AS(0) + AS_COMMAND, AS_COMMAND_UPDATE);
+	if (!wait_for(AS(0) + AS_STATUS, 1, 0, 100)) {
+		return false;
+	}
+	/* kbase's quirks for this GPU, as TWRP's Linux had them (13 Nov): JM_CONFIG, SHADER_CONFIG */
+	P(0xf00, 0x000f0000);
+	P(0xf04, 0x20000000);
+	P(JOB_IRQ_CLEAR, 0xffffffffu);
+	P(MMU_IRQ_CLEAR, 0xffffffffu);
+	say("mali: kept: address space 0 at %#llx, GPU addresses %#llx-%#llx\n", k_l0_pa, KEEP_VA_BASE,
+	    KEEP_VA_BASE + 4096ull * KEEP_VA_PAGES - 1);
+	return true;
+}
+
+static void k_recover(void);
+
+/* whether the job running is over (a fault counts: it is reported and its fence given up) */
+static void
+k_poll(void)
+{
+	uint32_t raw;
+
+	if (k_busy_slot < 0) {
+		k_start_next();
+		return;
+	}
+	raw = G(JOB_IRQ_RAWSTAT);
+	if (!(raw & (1u << k_busy_slot | 1u << (16 + k_busy_slot)))) {
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - k_busy_since, &ns);
+		if (ns > KEEP_SUBMIT_MS * NSEC_PER_MSEC) {
+			k_recover();            /* (whoever asks first after the job's time is up: a wait, or the next submission) */
+		}
+		return;
+	}
+	if (raw & 1u << (16 + k_busy_slot)) {
+		k_faults++;
+		say("mali: job %u FAILED on slot %d: status %#x, head %#x; MMU raw %#x, AS 0 fault %#x at %#x%08x\n",
+		    k_busy_fence, k_busy_slot, G(JS(k_busy_slot) + JS_STATUS), G(JS(k_busy_slot) + JS_HEAD_LO),
+		    G(MMU_IRQ_RAWSTAT), G(AS(0) + AS_FAULTSTATUS), G(AS(0) + AS_FAULTADDRESS_HI), G(AS(0) + AS_FAULTADDRESS_LO));
+		P(MMU_IRQ_CLEAR, 0xffffffffu);
+	}
+	P(JOB_IRQ_CLEAR, 1u << k_busy_slot | 1u << (16 + k_busy_slot));
+	k_worked_abs += mach_absolute_time() - k_busy_since;
+	k_done = k_busy_fence;
+	k_busy_slot = -1;
+	k_start_next();
+}
+
+/*
+ * A job that does not finish (run 77: CoreAnimation's first job ran on for ever, and every one after it was refused).
+ * What the GPU says about it is reported -- a Mali job that touches an address with no page waits for that page,
+ * it does not fail, and its address space says where -- then the job is stopped hard and the GPU reset, powered and
+ * given its address space again; the job's fence counts as done (its picture is lost, the next ones are not).
+ */
+static void
+k_recover(void)
+{
+	int slot = k_busy_slot;
+
+	say("mali: job %u on slot %d not done after %u ms: status %#x head %#x%08x tail %#x; job raw %#x; MMU raw %#x, AS 0 "
+	    "fault %#x at %#x%08x, AS 0 status %#x; GPU_STATUS %#x fault %#x\n", k_busy_fence, slot, KEEP_SUBMIT_MS,
+	    G(JS(slot) + JS_STATUS), G(JS(slot) + JS_HEAD_HI), G(JS(slot) + JS_HEAD_LO), G(JS(slot) + 0x08),
+	    G(JOB_IRQ_RAWSTAT), G(MMU_IRQ_RAWSTAT), G(AS(0) + AS_FAULTSTATUS), G(AS(0) + AS_FAULTADDRESS_HI),
+	    G(AS(0) + AS_FAULTADDRESS_LO), G(AS(0) + AS_STATUS), G(GPU_STATUS), G(GPU_FAULTSTATUS));
+	P(JS(slot) + JS_COMMAND, JS_COMMAND_HARD_STOP);
+	delay_for_interval(5, NSEC_PER_MSEC);
+	k_faults++;
+	k_done = k_busy_fence;
+	k_busy_slot = -1;
+	/* the reset puts every power domain of the GPU's off and forgets the address space: all of it again */
+	if (!soft_reset() || !step_power() || !keep_space_again()) {
+		say("mali: the GPU did not come back after its reset: it is given up\n");
+		kept = false;
+		return;
+	}
+	say("mali: the GPU reset and running again (%u jobs, %u lost)\n", k_jobs, k_faults);
+}
+
+bool
+hakios_mali_gpu_ready(void)
+{
+	return kept;
+}
+
+bool
+hakios_mali_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	/* Linux's DRM_PANFROST_PARAM_*, in their order */
+	switch (which) {
+	case 0: *value = G(GPU_ID) >> 16; break;                        /* GPU_PROD_ID */
+	case 1: *value = G(GPU_ID) & 0xffff; break;                     /* GPU_REVISION */
+	case 2: *value = (uint64_t)G(SHADER_PRESENT_HI) << 32 | G(SHADER_PRESENT_LO); break;
+	case 3: *value = G(TILER_PRESENT_LO); break;
+	case 4: *value = G(L2_PRESENT_LO); break;
+	case 5: *value = (uint64_t)G(0xe04) << 32 | G(0xe00); break;    /* STACK_PRESENT */
+	case 6: *value = G(AS_PRESENT); break;
+	case 7: *value = G(JS_PRESENT); break;
+	case 8: *value = G(L2_FEATURES); break;
+	case 9: *value = G(CORE_FEATURES); break;
+	case 10: *value = G(TILER_FEATURES); break;
+	case 11: *value = G(MEM_FEATURES); break;
+	case 12: *value = G(MMU_FEATURES); break;
+	case 13: *value = G(0xac); break;                               /* THREAD_FEATURES */
+	case 14: *value = G(0xa0); break;                               /* THREAD_MAX_THREADS */
+	case 15: *value = G(0xa4); break;                               /* THREAD_MAX_WORKGROUP_SIZE */
+	case 16: *value = G(0xa8); break;                               /* THREAD_MAX_BARRIER_SIZE */
+	case 17: *value = G(COHERENCY_FEATURES); break;
+	case 18: case 19: case 20: case 21:
+		*value = G(0xb0 + 4 * (which - 18)); break;                 /* TEXTURE_FEATURES_0..3 */
+	case 22: case 23: case 24: case 25: case 26: case 27: case 28: case 29:
+	case 30: case 31: case 32: case 33: case 34: case 35: case 36: case 37:
+		*value = G(0xc0 + 4 * (which - 22)); break;                 /* JS0..15_FEATURES */
+	case 38: *value = 1; break;                                     /* NR_CORE_GROUPS */
+	case 39: *value = G(0x310); break;                              /* THREAD_TLS_ALLOC */
+	case 40: *value = G(0x4c); break;                               /* AFBC_FEATURES */
+	case 41: *value = mach_absolute_time(); break;                  /* SYSTEM_TIMESTAMP: the 26 MHz counter */
+	case 42: *value = 26000000; break;                              /* SYSTEM_TIMESTAMP_FREQUENCY */
+	default:
+		return false;
+	}
+	return true;
+}
+
+uint64_t
+hakios_mali_gpu_address(uint64_t size)
+{
+	uint32_t pages = (uint32_t)((size + 4095) / 4096), run = 0;
+
+	for (uint32_t i = 0; i < KEEP_VA_PAGES && pages != 0; i++) {
+		run = (k_used[i / 8] & 1u << (i % 8)) ? 0 : run + 1;
+		if (run == pages) {
+			uint32_t first = i + 1 - pages;
+
+			for (uint32_t j = first; j <= i; j++) {
+				k_used[j / 8] |= (uint8_t)(1u << (j % 8));
+			}
+			return KEEP_VA_BASE + 4096ull * first;
+		}
+	}
+	return 0;
+}
+
+void
+hakios_mali_gpu_address_free(uint64_t address, uint64_t size)
+{
+	uint32_t first = (uint32_t)((address - KEEP_VA_BASE) / 4096), pages = (uint32_t)((size + 4095) / 4096);
+
+	for (uint32_t j = first; j < first + pages && j < KEEP_VA_PAGES; j++) {
+		k_used[j / 8] &= (uint8_t)~(1u << (j % 8));
+	}
+}
+
+bool
+hakios_mali_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	uint64_t off = address - KEEP_VA_BASE, idx2 = off >> 21, *l3;
+
+	if (address < KEEP_VA_BASE || off >= 4096ull * KEEP_VA_PAGES || (phys & 4095) != 0) {
+		return false;
+	}
+	l3 = k_l3[idx2];
+	if (l3 == NULL) {
+		uint64_t pa;
+
+		l3 = k_l3[idx2] = k_table(&pa);
+		if (l3 == NULL) {
+			return false;
+		}
+		k_l2[address >> 30][(address >> 21) & 511] = (pa & PTE_ADDRESS) | PTE_TABLE;
+		to_memory((vm_offset_t)&k_l2[address >> 30][(address >> 21) & 511], 8);
+	}
+	l3[(address >> 12) & 511] = (phys & PTE_ADDRESS) | PTE_ACCESS_FLAG | (read_only ? 3ull << 6 : PTE_ACCESS_RW) |
+	    PTE_PAGE;               /* memory kind 0 (non-cacheable); executable */
+	to_memory((vm_offset_t)&l3[(address >> 12) & 511], 8);
+	return true;
+}
+
+void
+hakios_mali_gpu_mapped(void)
+{
+	k_flush();
+}
+
+void
+hakios_mali_gpu_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t a = address; a < address + size; a += 4096) {
+		uint64_t off = a - KEEP_VA_BASE, *l3;
+
+		if (a < KEEP_VA_BASE || off >= 4096ull * KEEP_VA_PAGES || (l3 = k_l3[off >> 21]) == NULL) {
+			continue;
+		}
+		l3[(a >> 12) & 511] = 0;
+		to_memory((vm_offset_t)&l3[(a >> 12) & 511], 8);
+	}
+	k_flush();
+}
+
+void
+hakios_mali_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		to_memory((vm_offset_t)start, size);
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+uint32_t
+hakios_mali_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint64_t jc = count ? addresses[0] : 0;
+	int slot = count && (words[0] & 1) ? 0 : 1;     /* PANFROST_JD_REQ_FS: fragment jobs on slot 0, the rest on 1 */
+
+	uint32_t fence;
+
+	if (!kept || jc == 0) {
+		return 0;
+	}
+	k_queue_init();
+	lck_mtx_lock(&k_lock);
+	/*
+	 * Queued, not waited for (runs 100-101: a frame of CoreAnimation's is up to 15 render passes, and each waited here
+	 * for the GPU to finish the one before -- 48-91 ms a frame while swiping, the GPU busy for a few of them). The
+	 * jobs run one after the other in the order given, which is every order Panfrost asks for; the queue's thread
+	 * starts the next as soon as one is done. Only a full queue is waited on.
+	 */
+	for (uint64_t began = mach_absolute_time(), ns; k_poll(), k_queued == K_QUEUE;) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		if (ns >= KEEP_SUBMIT_MS * NSEC_PER_MSEC) {
+			k_recover();
+			break;
+		}
+		lck_mtx_unlock(&k_lock);
+		delay_for_interval(KEEP_ASK_US, NSEC_PER_USEC);
+		lck_mtx_lock(&k_lock);
+	}
+	fence = ++k_fence;
+	if (k_fence == 0) {
+		fence = k_fence = 1;
+	}
+	if (k_busy_slot < 0 && k_queued == 0) {
+		k_start(slot, jc, fence);
+	} else {
+		k_queue[(k_queue_first + k_queued) % K_QUEUE] = (struct k_job){ jc, fence, slot };
+		k_queued++;
+	}
+	thread_wakeup((event_t)&k_queued);
+	lck_mtx_unlock(&k_lock);
+	return fence;
+}
+
+/* a job onto the GPU now (k_lock held, the GPU idle) */
+static void
+k_start(int slot, uint64_t jc, uint32_t fence)
+{
+	P(JS(slot) + JS_HEAD_NEXT_LO, (uint32_t)jc);
+	P(JS(slot) + JS_HEAD_NEXT_HI, (uint32_t)(jc >> 32));
+	P(JS(slot) + JS_AFFINITY_NEXT_LO, (uint32_t)shader_present);
+	P(JS(slot) + JS_AFFINITY_NEXT_HI, (uint32_t)(shader_present >> 32));
+	P(JS(slot) + JS_CONFIG_NEXT, 0 /* AS 0 */ | JS_CONFIG_START_FLUSH_CLEAN_INVALIDATE |
+	    JS_CONFIG_END_FLUSH_CLEAN_INVALIDATE | JS_CONFIG_THREAD_PRI(8));
+	k_busy_fence = fence;
+	k_busy_slot = slot;
+	k_busy_since = mach_absolute_time();
+	k_jobs++;
+	P(JS(slot) + JS_COMMAND_NEXT, JS_COMMAND_START);
+}
+
+/* the next queued job onto the GPU, if it is idle (k_lock held) */
+static void
+k_start_next(void)
+{
+	if (k_busy_slot < 0 && k_queued != 0 && kept) {
+		struct k_job j = k_queue[k_queue_first];
+
+		k_queue_first = (k_queue_first + 1) % K_QUEUE;
+		k_queued--;
+		k_start(j.slot, j.jc, j.fence);
+	}
+}
+
+/* The queue's thread: while a job runs, it looks every KEEP_ASK_US whether it is done and starts the next. */
+static void
+k_queue_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	lck_mtx_lock(&k_lock);
+	for (;;) {
+		k_poll();
+		if (k_busy_slot >= 0) {
+			lck_mtx_unlock(&k_lock);
+			delay_for_interval(KEEP_ASK_US, NSEC_PER_USEC);
+			lck_mtx_lock(&k_lock);
+		} else {
+			(void)lck_mtx_sleep(&k_lock, LCK_SLEEP_DEFAULT, (event_t)&k_queued, THREAD_UNINT);
+		}
+	}
+}
+
+static void
+k_queue_init(void)
+{
+	thread_t thread;
+
+	if (k_queue_started) {
+		return;
+	}
+	k_queue_started = true;
+	if (kernel_thread_start(k_queue_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+bool
+hakios_mali_gpu_done(uint32_t fence)
+{
+	bool done;
+
+	lck_mtx_lock(&k_lock);
+	k_poll();
+	done = (int32_t)(fence - k_done) <= 0;
+	lck_mtx_unlock(&k_lock);
+	return done;
+}
+
+uint32_t
+hakios_mali_gpu_last(void)
+{
+	return k_fence;
+}
+
+void
+hakios_mali_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(k_worked_abs, &ns);
+	*microseconds = ns / 1000;
+	*submissions = k_jobs;
+	for (int i = 0; i < 7; i++) {
+		by[i] = 0;
+	}
+}
+
+void
+hakios_mali_gpu_report(const char *why)
+{
+	say("mali: %s: %u jobs, %u failed; running %u on slot %d; GPU_STATUS %#x, job raw %#x, MMU raw %#x\n", why, k_jobs,
+	    k_faults, k_busy_fence, k_busy_slot, G(GPU_STATUS), G(JOB_IRQ_RAWSTAT), G(MMU_IRQ_RAWSTAT));
+}
+
+void
+hakios_mali_gpu_stop(void)
+{
+	kept = false;
+	if (mali != 0) {
+		power_off();
+	}
+}
+
+extern void HakiosGPUStartMali(void);
+
+/* ---- the GPU's clock: a governor (boot-arg mali_gov=1; owner's OK, 14 Nov) ------------------------------------- */
+
+/*
+ * S-BOOT leaves the Mali-G77 at 260 MHz ("start clock" in Samsung's tree, gpu_dvfs_start_clock 0x3f7a0) and nothing
+ * raised it: heavy frames took 24 ms while swiping (14 Nov). Samsung's own table (exynos9830.dts gpu_dvfs_table, the
+ * clocks in kHz): 800000 (gpu_max_clock), 702000, 572000, 455000, 377000, 260000, 156000 (gpu_min_clock); its Android
+ * governor is "interactive". This one, every 32 ms, from how long the GPU worked (k_worked_abs):
+ *   busy 25% or more  -> straight to the top (mali_gov_max, default 800000)
+ *   between           -> as it is
+ *   under 10% for 300 ms -> mali_gov_min (default 260000, S-BOOT's; 156000 for the coolest idle)
+ * The clock is asked of the APM as Samsung's cal_dfs_set_rate does: channel 5 (acpm_dvfs), {10 (g3d_cmu_cal_id
+ * 0xb04000a & 0xffff), kHz, FREQ_REQ 0, 0}; the APM sets the PLL and the voltage. Every change is checked by reading
+ * the G3D PLL back. Heat: above mali_gov_hot (default 52 C) on the GPU's zone the top is 572 MHz; the kernel's heat
+ * guard (exynos_thermal_stop) powers off as before.
+ */
+extern int hakios_exynos_acpm(uint32_t channel, uint32_t cmd[4]);
+
+static const uint32_t gov_khz[] = { 156000, 260000, 377000, 455000, 572000, 702000, 800000 };
+#define GOV_LEVELS      (sizeof(gov_khz) / sizeof(gov_khz[0]))
+#define GOV_TICK_MS     32
+static thread_call_t gov_call;
+static int gov_level = -1, gov_min = 1, gov_max = GOV_LEVELS - 1, gov_hot_c = 52;
+static uint64_t gov_last_worked, gov_last_at;
+static uint32_t gov_idle_ms, gov_changes;
+static uint64_t gov_ms_at[GOV_LEVELS];
+static thread_call_t gov_boost_call;
+static volatile uint64_t gov_boost_until;       /* mach time: busy whatever the load, until then (a touch) */
+extern void (*hakios_touch_boost)(void);
+
+static uint32_t
+gov_pll_mhz(void)
+{
+	uint32_t con3 = rd(cmu_top + PLL_CON3_PLL_G3D);
+	uint32_t m = (con3 >> 16) & 0x3ff, p = (con3 >> 8) & 0x3f, s = con3 & 7;
+
+	return p ? (uint32_t)(26ull * m / ((uint64_t)p << s)) : 0;
+}
+
+static int
+gov_level_of(uint32_t khz)
+{
+	int best = 0;
+
+	for (int i = 0; i < (int)GOV_LEVELS; i++) {
+		if (gov_khz[i] <= khz) {
+			best = i;
+		}
+	}
+	return best;
+}
+
+static void
+gov_set(int level, const char *why)
+{
+	uint32_t q[4] = { ACPM_DVFS_G3D, gov_khz[level], 0 /* FREQ_REQ */, 0 };
+	int r = hakios_exynos_acpm(ACPM_CH_DVFS, q);
+	uint32_t mhz = gov_pll_mhz();
+
+	if (gov_changes++ < 40) {
+		say("mali: gov: %s: %u MHz asked (APM %d), the G3D PLL runs at %u MHz now\n", why, gov_khz[level] / 1000, r, mhz);
+	}
+	gov_level = level;
+}
+
+static void
+gov_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t now = mach_absolute_time(), worked = k_worked_abs, busy_ns, all_ns, deadline;
+	uint32_t pct;
+	int top = gov_max, want = gov_level;
+
+	if (!kept) {
+		return;                 /* the GPU is off: nothing to clock */
+	}
+	absolutetime_to_nanoseconds(worked - gov_last_worked, &busy_ns);
+	absolutetime_to_nanoseconds(now - gov_last_at, &all_ns);
+	gov_last_worked = worked;
+	gov_last_at = now;
+	pct = all_ns ? (uint32_t)(busy_ns * 100 / all_ns) : 0;
+	if (g3d_celsius() >= gov_hot_c && top > gov_level_of(572000)) {
+		top = gov_level_of(572000);
+	}
+	if (pct >= 25 || now < gov_boost_until) {
+		want = top;
+		gov_idle_ms = 0;
+	} else if (pct < 10) {
+		gov_idle_ms += GOV_TICK_MS;
+		if (gov_idle_ms >= 300) {
+			want = gov_min;
+		}
+	} else {
+		gov_idle_ms = 0;
+	}
+	if (want > top) {
+		want = top;
+	}
+	if (gov_level >= 0) {
+		gov_ms_at[gov_level] += GOV_TICK_MS;
+	}
+	if (want != gov_level) {
+		gov_set(want, pct >= 25 ? "busy" : "idle");
+	}
+	clock_interval_to_deadline(GOV_TICK_MS, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(gov_call, deadline);
+}
+
+/* a touch: the top clock at once (the touch path must not wait for the APM: this runs in a thread call) */
+static void
+gov_boost(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	int top = gov_max;
+
+	if (g3d_celsius() >= gov_hot_c && top > gov_level_of(572000)) {
+		top = gov_level_of(572000);
+	}
+	if (kept && gov_level != top) {
+		gov_set(top, "touch");
+	}
+}
+
+static void
+gov_touch(void)
+{
+	uint64_t hold;
+
+	nanoseconds_to_absolutetime(300 * NSEC_PER_MSEC, &hold);
+	gov_boost_until = mach_absolute_time() + hold;
+	gov_idle_ms = 0;
+	if (gov_level != gov_max) {
+		thread_call_enter(gov_boost_call);
+	}
+}
+
+/* every minute: how long at each clock (mali_gov=1) */
+static thread_call_t gov_report_call;
+
+static void
+gov_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+
+	say("mali: gov: seconds at 156/260/377/455/572/702/800 MHz: %llu %llu %llu %llu %llu %llu %llu; now %u MHz, G3D %d C\n",
+	    gov_ms_at[0] / 1000, gov_ms_at[1] / 1000, gov_ms_at[2] / 1000, gov_ms_at[3] / 1000, gov_ms_at[4] / 1000,
+	    gov_ms_at[5] / 1000, gov_ms_at[6] / 1000, gov_pll_mhz(), g3d_celsius());
+	clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(gov_report_call, deadline);
+}
+
+static void
+gov_start(void)
+{
+	uint32_t value;
+
+	if (!PE_parse_boot_argn("mali_gov", &value, sizeof(value)) || value == 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("mali_gov_max", &value, sizeof(value)) && value >= 156000 && value <= 800000) {
+		gov_max = gov_level_of(value);
+	}
+	if (PE_parse_boot_argn("mali_gov_min", &value, sizeof(value)) && value >= 156000 && value <= 800000) {
+		gov_min = gov_level_of(value);
+	}
+	if (PE_parse_boot_argn("mali_gov_hot", &value, sizeof(value)) && value >= 40 && value <= 60) {
+		gov_hot_c = (int)value;
+	}
+	if (gov_min > gov_max) {
+		gov_min = gov_max;
+	}
+	say("mali: gov: on: %u..%u MHz, 572 MHz at most from %d C; the G3D PLL runs at %u MHz\n",
+	    gov_khz[gov_min] / 1000, gov_khz[gov_max] / 1000, gov_hot_c, gov_pll_mhz());
+	gov_level = gov_level_of(gov_pll_mhz() * 1000);
+	gov_last_worked = k_worked_abs;
+	gov_last_at = mach_absolute_time();
+	gov_call = thread_call_allocate_with_priority(gov_tick, NULL, THREAD_CALL_PRIORITY_HIGH);
+	gov_report_call = thread_call_allocate(gov_report, NULL);
+	gov_boost_call = thread_call_allocate_with_priority(gov_boost, NULL, THREAD_CALL_PRIORITY_HIGH);
+	hakios_touch_boost = gov_touch;
+	gov_tick(NULL, NULL);
+	gov_report(NULL, NULL);
+}
+
+/* ---- the steps ----------------------------------------------------------------------------------- */
+
+static bool (*const steps[])(void) = { step_look, step_reset, step_power, step_space, step_job };
+static const char *const names[] = { "look", "soft reset", "power on", "an address space", "a write-value job" };
+#define STEPS   (sizeof(steps) / sizeof(steps[0]))
+
+/*
+ * Boot-arg dpu_probe=1 (read only): how S-BOOT left the display, for showing the window server's surfaces without a copy
+ * (as Scion's fb_zc on the S9). Samsung's dpu30 (cal_9830 regs-decon.h, regs-dpp.h) and the S20's tree: DECON0 at
+ * 0x19050000 (default_win 5, default_ch 0), the first DPP at 0x19091000 with its IDMA at 0x19041000. Each register read
+ * both ways -- through the window and through a kernel mapping -- since the hypervisor skips some loads (run 82).
+ */
+#define DECON0_PA               0x19050000ull
+#define IDMA0_PA                0x19041000ull
+static void dpu_probe(void);
+static void
+dpu_probe(void)
+{
+	static const struct { uint32_t off; const char *name; } decon[] = {
+		{ 0x0000, "GLOBAL_CONTROL" }, { 0x0060, "SHADOW_REG_UPDATE_REQ" }, { 0x0070, "HW_SW_TRIG_CONTROL" },
+		{ 0x0214, "DATA_PATH_CONTROL_0" }, { 0x0218, "DATA_PATH_CONTROL_1" }, { 0x0230, "DATA_PATH_CONTROL_2" },
+		{ 0x1000 + 5 * 0x30, "WIN_CONTROL_0(5)" }, { 0x1004 + 5 * 0x30, "WIN_CONTROL_1(5)" },
+		{ 0x1008 + 5 * 0x30, "WIN_START_POSITION(5)" }, { 0x100c + 5 * 0x30, "WIN_END_POSITION(5)" },
+	}, idma[] = {
+		{ 0x0000, "IDMA_ENABLE" }, { 0x0004, "IDMA_IRQ" }, { 0x0008, "IDMA_IN_CON" }, { 0x0010, "IDMA_SRC_SIZE" },
+		{ 0x0014, "IDMA_SRC_OFFSET" }, { 0x0018, "IDMA_IMG_SIZE" }, { 0x0040, "IDMA_IN_BASE_ADDR_Y8" },
+		{ 0x0308, "IDMA_IN_REQ_DEST" },
+	};
+	vm_offset_t dw = low_map(DECON0_PA, 2), iw = low_map(IDMA0_PA, 1);
+	vm_offset_t dk = ml_io_map(DECON0_PA, 0x4000), ik = ml_io_map(IDMA0_PA & ~0x3fffull, 0x4000) + (IDMA0_PA & 0x3fff);
+
+	if (dw == 0 || iw == 0 || dk == 0 || ik == 0) {
+		say("dpu_probe: could not map the DECON or the IDMA\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(decon) / sizeof(decon[0]); i++) {
+		uint32_t off = decon[i].off;
+		uint32_t viaw = rd(dw + off);
+
+		say("dpu_probe: DECON0 %-22s +%#06x = %#010x (kernel mapping %#010x)\n", decon[i].name, off, viaw,
+		    *(volatile uint32_t *)(dk + off));
+	}
+	for (unsigned i = 0; i < sizeof(idma) / sizeof(idma[0]); i++) {
+		say("dpu_probe: IDMA0  %-22s +%#06x = %#010x (kernel mapping %#010x)\n", idma[i].name, idma[i].off,
+		    rd(iw + idma[i].off), *(volatile uint32_t *)(ik + idma[i].off));
+	}
+}
+
+void
+hakios_mali_init(void)
+{
+	uint32_t value = 0, done = 0, back = 0;
+
+	if (PE_parse_boot_argn("dpu_probe", &value, sizeof(value)) && value) {
+		dpu_probe();
+		value = 0;
+	}
+	if (!PE_parse_boot_argn("mali", &last_step, sizeof(last_step)) || last_step == 0) {
+		return;
+	}
+	if (last_step > STEPS) {
+		last_step = STEPS;
+	}
+	/* lower only: 60 C is the most the GPU is let reach here (the heat guard powers the phone off at 70) */
+	if (PE_parse_boot_argn("mali_hot", &value, sizeof(value)) && value >= 30 && value <= 60) {
+		hot_c = value;
+	}
+	mali = low_map(MALI_PA, MALI_SIZE / 4096);
+	pmu = low_map(PMU_G3D_PA, 1);
+	cmu_top = low_map(CMU_TOP_PA, 1);
+	if (mali == 0 || pmu == 0 || cmu_top == 0) {
+		say("mali: could not map the GPU, the PMU or the clock controller\n");
+		return;
+	}
+	/* bisect mark: bit 29 of AS7_TRANSTAB_LO, the driver's start (input init) */
+	wr(mali + AS(7) + AS_TRANSTAB_LO, rd(mali + AS(7) + AS_TRANSTAB_LO) | 0x20000000u);
+	say("mali: steps 1 to %u (of %u); no power on at or above %u C\n", last_step, (unsigned)STEPS, hot_c);
+	for (uint32_t s = 1; s <= last_step; s++) {
+		say("mali: step %u: %s\n", s, names[s - 1]);
+		if (!steps[s - 1]()) {
+			say("mali: step %u: FAILED; the steps after it are not attempted\n", s);
+			break;
+		}
+		say("mali: step %u: done\n", s);
+		done = s;
+	}
+	/* mali_keep=1: with the GPU powered (step 3 done), kept on for the system (HakiosGPU, Panfrost's interface) */
+	if (done >= 3 && PE_parse_boot_argn("mali_keep", &value, sizeof(value)) && value) {
+		if (keep_space()) {
+			kept = true;
+			say("mali: THE GPU STAYS ON for the system to draw with: the service HakiosGPU (Panfrost's interface)\n");
+			HakiosGPUStartMali();
+			gov_start();
+			return;
+		}
+		say("mali: not kept: no address space for it\n");
+	}
+	if (last_step >= 2 && done >= 1) {
+		power_off();
+		if (done < last_step || last_step >= 4) {
+			soft_reset();           /* nothing of ours (tables, a job) is left in the GPU's hands */
+		}
+	}
+	clock_stop();
+	if (cycled) {
+		domain_off();           /* the domain left off, Samsung's way (S-BOOT left it on with the GPU's PLL stopped) */
+		cycled = false;
+	}
+	say("mali: over: %u of %u steps done%s; G3D %d C\n", done, last_step,
+	    done == STEPS ? ": THE GPU RAN A JOB" : "", g3d_celsius());
+	if (PE_parse_boot_argn("mali_return", &back, sizeof(back)) && back) {
+		say("mali: back to the loader (mali_return)\n");
+		loader_return();
+	}
+}
+
+/* the heat guard's or a run's end: the GPU's cores off, if they were left on */
+void
+hakios_mali_stop(void)
+{
+	kept = false;
+	if (powered && mali != 0) {
+		power_off();
+	}
+	clock_stop();
+	if (cycled) {
+		domain_off();
+		cycled = false;
+	}
+}
+
+/*
+ * The write test as early as the kernel can do it (before nearly every driver), with mali=N: run 48 found the kernel's
+ * mapping right (0x18500000, Device-nGnRnE, writable) yet its stores lost and quick (10 ns, a read 300 ns), while the
+ * loader's stores before and after a kernel run land. Does the kernel lose them from the start, or only later?
+ */
+__startup_func
+static void
+mali_early_write_test(void)
+{
+	uint32_t n = 0, seen, after;
+	vm_offset_t m;
+	uint64_t t0, t1, ns;
+
+	/* the diagnostics of runs 50-69 (mali_early=1 only: the driver itself goes through the low window now) */
+	if (!PE_parse_boot_argn("mali_early", &n, sizeof(n)) || n == 0) {
+		return;
+	}
+	m = ml_io_map(MALI_PA, MALI_SIZE);
+	if (m == 0) {
+		return;
+	}
+	/* bisect mark (loader_return.c's loader_checkpoint): bit 30 of AS7_TRANSTAB_LO, the EARLY_BOOT hook */
+	wr(m + AS(7) + AS_TRANSTAB_LO, rd(m + AS(7) + AS_TRANSTAB_LO) | 0x40000000u);
+	{
+		/*
+		 * A stale TLB entry for this VA? The loader writes the GPU fine with the kernel's whole translation context
+		 * (TCR, MAIR, SCTLR, PAN, a TTBR1 table), so the kernel's page tables are right but what the CPU uses may
+		 * not be them. Invalidate this core's TLB, then the write.
+		 */
+		uint32_t s1, s2;
+
+		__asm__ volatile ("dsb sy; tlbi vmalle1; dsb sy; isb" : : : "memory");
+		wr(m + AS(2) + AS_TRANSTAB_LO, 0x5a5a5000u);
+		s1 = rd(m + AS(2) + AS_TRANSTAB_LO);
+		__asm__ volatile ("dsb sy; tlbi vmalle1is; dsb sy; isb" : : : "memory");
+		wr(m + AS(3) + AS_TRANSTAB_LO, 0x6b6b6000u);
+		s2 = rd(m + AS(3) + AS_TRANSTAB_LO);
+		say("mali: after tlbi vmalle1: wrote 0x5a5a5000, read %#x; after tlbi vmalle1is: wrote 0x6b6b6000, read %#x\n",
+		    s1, s2);
+	}
+	{
+		/*
+		 * The write through a table of our own in TTBR0 for a moment (interrupts are off this early): VA 0x40000000
+		 * -> the GPU's MMU page (0x18502000), Device-nGnRnE (the kernel's MAIR index 3), as the loader maps it. If
+		 * this lands and the kernel's own mapping does not, the kernel's TTBR1 tables are what differs.
+		 */
+		static uint64_t t_l1[512] __attribute__((aligned(4096)));
+		static uint64_t t_l2[512] __attribute__((aligned(4096)));
+		static uint64_t t_l3[512] __attribute__((aligned(4096)));
+		uint64_t old0, got = 0, l1pa = kvtophys((vm_offset_t)t_l1);
+
+		t_l1[1] = kvtophys((vm_offset_t)t_l2) | 3;
+		t_l2[0] = kvtophys((vm_offset_t)t_l3) | 3;
+		t_l3[0] = 0x18502000ull | 3ull << 2 | 1ull << 10 | 1ull << 53 | 1ull << 54 | 3;
+		to_memory((vm_offset_t)t_l1, 4096);
+		to_memory((vm_offset_t)t_l2, 4096);
+		to_memory((vm_offset_t)t_l3, 4096);
+		__asm__ volatile ("mrs %0, ttbr0_el1" : "=r" (old0));
+		__asm__ volatile (
+		    "  dsb sy\n"
+		    "  msr ttbr0_el1, %[t]\n"
+		    "  isb\n"
+		    "  tlbi vmalle1\n"
+		    "  dsb sy\n"
+		    "  isb\n"
+		    "  str %w[v], [%[a]]\n"
+		    "  dsb sy\n"
+		    "  ldr %w[g], [%[a]]\n"
+		    "  msr ttbr0_el1, %[o]\n"
+		    "  isb\n"
+		    "  tlbi vmalle1\n"
+		    "  dsb sy\n"
+		    "  isb\n"
+		    : [g] "=&r" (got)
+		    : [t] "r" (l1pa), [v] "r" (0x7c7c7000u), [a] "r" (0x40000000ull + 0x4c0), [o] "r" (old0)
+		    : "memory");
+		say("mali: through a TTBR0 table of our own (tables at %#llx): wrote 0x7c7c7000 to AS3, read %#llx; the kernel's "
+		    "TTBR0 was %#llx\n", l1pa, got, old0);
+
+		/*
+		 * Run 60: that lands. The kernel's own entry above the GPU's page carries table attributes our table has not
+		 * (its level-1 entry 0x380000092794c003: PXNTable, UXNTable, APTable[0] = no EL0 access). The same write with
+		 * each of them set in our level-1 entry, one at a time, to AS4..AS6.
+		 */
+		static const uint64_t attrs[3] = { 1ull << 61, 1ull << 59 | 1ull << 60, 7ull << 59 };
+		for (int k = 0; k < 3; k++) {
+			uint64_t g2 = 0;
+
+			t_l1[1] = kvtophys((vm_offset_t)t_l2) | 3 | attrs[k];
+			to_memory((vm_offset_t)t_l1, 4096);
+			__asm__ volatile (
+			    "  dsb sy\n"
+			    "  msr ttbr0_el1, %[t]\n"
+			    "  isb\n"
+			    "  tlbi vmalle1\n"
+			    "  dsb sy\n"
+			    "  isb\n"
+			    "  str %w[v], [%[a]]\n"
+			    "  dsb sy\n"
+			    "  ldr %w[g], [%[a]]\n"
+			    "  msr ttbr0_el1, %[o]\n"
+			    "  isb\n"
+			    "  tlbi vmalle1\n"
+			    "  dsb sy\n"
+			    "  isb\n"
+			    : [g] "=&r" (g2)
+			    : [t] "r" (l1pa), [v] "r" (0x1d1d1000u + (uint32_t)k), [a] "r" (0x40000000ull + 0x500 + 0x40 * k),
+			      [o] "r" (old0)
+			    : "memory");
+			say("mali:   level-1 attributes %#llx: wrote %#x, read %#llx\n", attrs[k], 0x1d1d1000u + k, g2);
+		}
+		/* and the kernel's own entries for the GPU's VA, for the record */
+		{
+			uint64_t ttbr1, d1, d2;
+			vm_offset_t va = m + 0x2000;
+
+			__asm__ volatile ("mrs %0, ttbr1_el1" : "=r" (ttbr1));
+			d1 = ml_phys_read_double_64((ttbr1 & 0x0000fffffffffffeull) + ((va >> 30) & 0xff) * 8);
+			d2 = ml_phys_read_double_64((d1 & 0x0000fffffffff000ull) + ((va >> 21) & 0x1ff) * 8);
+			say("mali:   the kernel's entries for %#lx: level 1 %#llx, level 2 %#llx, level 3 %#llx\n", (unsigned long)va,
+			    d1, d2, ml_phys_read_double_64((d2 & 0x0000fffffffff000ull) + ((va >> 12) & 0x1ff) * 8));
+			/*
+			 * Run 61: the attributes do not matter. Which table pages do? (a) our level 1 -> the kernel's own level-2
+			 * table: VA 0x40000000 + (va & 0x3fffffff) then walks the kernel's level 2 and level 3; (b) our level 1
+			 * and 2 -> the kernel's own level-3 table: VA 0x40000000 + (va & 0x1fffff) walks its level 3 only.
+			 */
+			for (int k = 0; k < 2; k++) {
+				uint64_t g4 = 0, a = 0x40000000ull;
+
+				if (k == 0) {
+					t_l1[1] = (d1 & 0x0000fffffffff000ull) | 3;
+					a += va & 0x3fffffffull;
+				} else {
+					t_l1[1] = kvtophys((vm_offset_t)t_l2) | 3;
+					t_l2[0] = (d2 & 0x0000fffffffff000ull) | 3;
+					a += va & 0x1fffffull;
+				}
+				to_memory((vm_offset_t)t_l1, 4096);
+				to_memory((vm_offset_t)t_l2, 4096);
+				__asm__ volatile (
+				    "  dsb sy\n"
+				    "  msr ttbr0_el1, %[t]\n"
+				    "  isb\n"
+				    "  tlbi vmalle1\n"
+				    "  dsb sy\n"
+				    "  isb\n"
+				    "  str %w[v], [%[a]]\n"
+				    "  dsb sy\n"
+				    "  ldr %w[g], [%[a]]\n"
+				    "  msr ttbr0_el1, %[o]\n"
+				    "  isb\n"
+				    "  tlbi vmalle1\n"
+				    "  dsb sy\n"
+				    "  isb\n"
+				    : [g] "=&r" (g4)
+				    : [t] "r" (l1pa), [v] "r" (0x2e2e2000u + (uint32_t)k), [a] "r" (a + 0x580 + 0x40 * k),
+				      [o] "r" (old0)
+				    : "memory");
+				say("mali:   through %s: wrote %#x, read %#llx\n", k == 0 ? "the kernel's level-2 and level-3 tables" :
+				    "the kernel's level-3 table", 0x2e2e2000u + k, g4);
+			}
+			/*
+			 * Run 62: both land. Left: the kernel's level-1 page itself, and TTBR1 as such. (c) TTBR0 = the kernel's
+			 * TTBR1 value (its level-1 page, CnP and all), VA = va's low 38 bits: the same walk, from the lower half.
+			 */
+			{
+				uint64_t g5 = 0, a = (va & 0x3fffffffffull) + 0x500;
+
+				say("mali:   the kernel's TTBR1 is %#llx\n", ttbr1);
+				__asm__ volatile (
+				    "  dsb sy\n"
+				    "  msr ttbr0_el1, %[t]\n"
+				    "  isb\n"
+				    "  tlbi vmalle1\n"
+				    "  dsb sy\n"
+				    "  isb\n"
+				    "  str %w[v], [%[a]]\n"
+				    "  dsb sy\n"
+				    "  ldr %w[g], [%[a]]\n"
+				    "  msr ttbr0_el1, %[o]\n"
+				    "  isb\n"
+				    "  tlbi vmalle1\n"
+				    "  dsb sy\n"
+				    "  isb\n"
+				    : [g] "=&r" (g5)
+				    : [t] "r" (ttbr1), [v] "r" (0x3f3f3000u), [a] "r" (a), [o] "r" (old0)
+				    : "memory");
+				say("mali:   through the kernel's level-1 page from TTBR0: wrote 0x3f3f3000, read %#llx\n", g5);
+				/* (d) and once more through the kernel's own upper-half VA, right after a full TLB invalidate */
+				__asm__ volatile ("dsb sy; tlbi vmalle1; dsb sy; isb" : : : "memory");
+				wr(va + 0x540, 0x4a4a4000u);
+				say("mali:   through the kernel's own VA %#lx: wrote 0x4a4a4000, read %#x\n", (unsigned long)(va + 0x540),
+				    rd(va + 0x540));
+				/*
+				 * The loader writes through these very tables (TTBR1 0x927915000, the kernel's VA, TCR, MAIR, SCTLR,
+				 * PAN) and its write lands; the kernel's does not, except through TTBR0. The one register left that
+				 * differs: TTBR0 (TCR.A1 = 0: the ASID comes from it). The kernel's VA again, with TTBR0 = (e) our
+				 * table, (f) the kernel's own TTBR0 with ASID 1.
+				 */
+				for (int k = 0; k < 2; k++) {
+					uint64_t g6 = 0, t0 = k == 0 ? l1pa : (old0 & 0x0000ffffffffffffull) | 1ull << 48;
+
+					__asm__ volatile (
+					    "  dsb sy\n"
+					    "  msr ttbr0_el1, %[t]\n"
+					    "  isb\n"
+					    "  tlbi vmalle1\n"
+					    "  dsb sy\n"
+					    "  isb\n"
+					    "  str %w[v], [%[a]]\n"
+					    "  dsb sy\n"
+					    "  ldr %w[g], [%[a]]\n"
+					    "  msr ttbr0_el1, %[o]\n"
+					    "  isb\n"
+					    "  tlbi vmalle1\n"
+					    "  dsb sy\n"
+					    "  isb\n"
+					    : [g] "=&r" (g6)
+					    : [t] "r" (t0), [v] "r" (0x5b5b5000u + (uint32_t)k), [a] "r" (va + 0x580 + 0x40 * k),
+					      [o] "r" (old0)
+					    : "memory");
+					say("mali:   the kernel's own VA with TTBR0 = %#llx: wrote %#x, read %#llx\n", t0, 0x5b5b5000u + k, g6);
+				}
+				/*
+				 * Run 65: both land. Which rule? (g) TTBR0 rewritten with its own value, (h) CnP set, ASID 0, (i) ASID
+				 * 0xff; and (j) TTBR0 = the kernel's table with ASID 1 left in place across ordinary P()/G() calls.
+				 */
+				{
+					static const uint64_t extra[3] = { 0, 1, 0xffull << 48 };
+					static const char *const label[3] = { "rewritten as it was", "with CnP", "with ASID 0xff" };
+
+					for (int k = 0; k < 3; k++) {
+						uint64_t g7 = 0, t0 = old0 | extra[k];
+
+						__asm__ volatile (
+						    "  dsb sy\n"
+						    "  msr ttbr0_el1, %[t]\n"
+						    "  isb\n"
+						    "  tlbi vmalle1\n"
+						    "  dsb sy\n"
+						    "  isb\n"
+						    "  str %w[v], [%[a]]\n"
+						    "  dsb sy\n"
+						    "  ldr %w[g], [%[a]]\n"
+						    "  msr ttbr0_el1, %[o]\n"
+						    "  isb\n"
+						    "  tlbi vmalle1\n"
+						    "  dsb sy\n"
+						    "  isb\n"
+						    : [g] "=&r" (g7)
+						    : [t] "r" (t0), [v] "r" (0x6c6c6000u + (uint32_t)k), [a] "r" (va + 0x400 + 0x40 * k),
+						      [o] "r" (old0)
+						    : "memory");
+						say("mali:   TTBR0 %s (%#llx): wrote %#x, read %#llx\n", label[k], t0, 0x6c6c6000u + k, g7);
+					}
+					__asm__ volatile ("dsb sy; msr ttbr0_el1, %0; isb; tlbi vmalle1; dsb sy; isb" : :
+					    "r" ((old0 & 0x0000ffffffffffffull) | 1ull << 48) : "memory");
+					wr(m + AS(0) + AS_TRANSTAB_LO, 0x7d7d7000u);
+					wr(m + AS(1) + AS_TRANSTAB_LO, 0x7e7e7000u);
+					say("mali:   (j) ASID 1 left in place, ordinary writes: AS0 read %#x, AS1 read %#x\n",
+					    rd(m + AS(0) + AS_TRANSTAB_LO), rd(m + AS(1) + AS_TRANSTAB_LO));
+					wr(m + AS(0) + AS_TRANSTAB_LO, 0);
+					wr(m + AS(1) + AS_TRANSTAB_LO, 0);
+					__asm__ volatile ("dsb sy; msr ttbr0_el1, %0; isb; tlbi vmalle1; dsb sy; isb" : : "r" (old0) : "memory");
+				}
+				/*
+				 * Run 66: TTBR0 rewritten with its own value lets the next store through, but a store a function call
+				 * later (j) is lost again. The window: k1 msr TTBR0 + isb + store (no tlbi); k2 tlbi + store (no msr);
+				 * k3 msr + tlbi + 64 nops + store; k4 msr + tlbi + a second store right after the first; k5 the store
+				 * alone. Each into its own AS register (AS2-AS7 table address), read back at once.
+				 */
+				{
+					uint64_t g[6] = { 0 };
+					vm_offset_t r = va + 0x480;     /* AS2 */
+
+					__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb; str %w[v], [%[a]]; dsb sy; ldr %w[g], [%[a]]"
+					    : [g] "=&r" (g[0]) : [o] "r" (old0), [v] "r" (0x81810000u), [a] "r" (r) : "memory");
+					__asm__ volatile ("dsb sy; tlbi vmalle1; dsb sy; isb; str %w[v], [%[a]]; dsb sy; ldr %w[g], [%[a]]"
+					    : [g] "=&r" (g[1]) : [v] "r" (0x82820000u), [a] "r" (r + 0x40) : "memory");
+					__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb; tlbi vmalle1; dsb sy; isb\n"
+					    ".rept 64\n nop\n .endr\n"
+					    "str %w[v], [%[a]]; dsb sy; ldr %w[g], [%[a]]"
+					    : [g] "=&r" (g[2]) : [o] "r" (old0), [v] "r" (0x83830000u), [a] "r" (r + 0x80) : "memory");
+					__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb; tlbi vmalle1; dsb sy; isb\n"
+					    "str %w[v], [%[a]]; dsb sy\n"
+					    "str %w[v2], [%[a2]]; dsb sy; ldr %w[g], [%[a2]]"
+					    : [g] "=&r" (g[3]) : [o] "r" (old0), [v] "r" (0x84840000u), [a] "r" (r + 0xc0),
+					      [v2] "r" (0x85850000u), [a2] "r" (r + 0x100) : "memory");
+					g[4] = rd(r + 0xc0);
+					__asm__ volatile ("dsb sy; str %w[v], [%[a]]; dsb sy; ldr %w[g], [%[a]]"
+					    : [g] "=&r" (g[5]) : [v] "r" (0x86860000u), [a] "r" (r + 0x140) : "memory");
+					say("mali:   window: k1 msr+store %#llx, k2 tlbi+store %#llx, k3 msr+tlbi+64 nops+store %#llx, k4 first "
+					    "store %#llx second %#llx, k5 store alone %#llx\n", g[0], g[1], g[2], g[4], g[3], g[5]);
+					/*
+					 * Run 67: the loads inside those blocks came back as other registers' old contents: the stores (and
+					 * loads?) are handled by the hypervisor in software. Read back with rd() instead, one per case:
+					 * m1 msr TTBR0 + isb + store; m2 msr + tlbi + store; m3 msr + store, then a second store 64 nops on;
+					 * m4 a store in wr() right after an msr in its own asm.
+					 */
+					{
+						uint32_t q[5];
+
+						__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb; str %w[v], [%[a]]; dsb sy"
+						    : : [o] "r" (old0), [v] "r" (0x91910000u), [a] "r" (r) : "memory");
+						q[0] = rd(r);
+						__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb; tlbi vmalle1; dsb sy; isb; str %w[v], [%[a]]; dsb sy"
+						    : : [o] "r" (old0), [v] "r" (0x92920000u), [a] "r" (r + 0x40) : "memory");
+						q[1] = rd(r + 0x40);
+						__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb; str %w[v], [%[a]]; dsb sy\n"
+						    ".rept 64\n nop\n .endr\n"
+						    "str %w[v2], [%[a2]]; dsb sy"
+						    : : [o] "r" (old0), [v] "r" (0x93930000u), [a] "r" (r + 0x80), [v2] "r" (0x94940000u),
+						      [a2] "r" (r + 0xc0) : "memory");
+						q[2] = rd(r + 0x80);
+						q[3] = rd(r + 0xc0);
+						__asm__ volatile ("dsb sy; msr ttbr0_el1, %[o]; isb" : : [o] "r" (old0) : "memory");
+						wr(r + 0x100, 0x95950000u);
+						q[4] = rd(r + 0x100);
+						say("mali:   by rd(): m1 msr+store %#x, m2 msr+tlbi+store %#x, m3 first %#x then 64 nops later %#x, "
+						    "m4 wr() after an msr %#x\n", q[0], q[1], q[2], q[3], q[4]);
+					}
+					/*
+					 * Run 68: erratic, and a second store a moment after a lost first one often lands. How many tries
+					 * does a write take until it reads back? 16 writes to AS0-AS7 LO/HI table addresses, plain wr()
+					 * each try (at most 200), then the same with TTBR0 rewritten before each try.
+					 */
+					for (int mode = 0; mode < 2; mode++) {
+						char line[200];
+						int at = 0, total = 0, worst = 0, failed = 0;
+
+						at += snprintf(line + at, sizeof(line) - at, "mali:   tries %s:", mode ? "with TTBR0 rewritten" : "plain");
+						for (int i = 0; i < 16; i++) {
+							vm_offset_t reg = va + 0x400 + 0x40 * (i / 2) + 4 * (i & 1);
+							uint32_t want = 0xa0000000u | (uint32_t)(mode << 20) | (uint32_t)(i << 12);
+							int t;
+
+							for (t = 1; t <= 200; t++) {
+								if (mode) {
+									__asm__ volatile ("dsb sy; msr ttbr0_el1, %0; isb" : : "r" (old0) : "memory");
+								}
+								wr(reg, want);
+								if (rd(reg) == want) {
+									break;
+								}
+							}
+							if (t > 200) {
+								failed++;
+							} else {
+								total += t;
+								worst = t > worst ? t : worst;
+							}
+							at += snprintf(line + at, sizeof(line) - at, " %d", t > 200 ? 0 : t);
+						}
+						say("%s; worst %d, failed %d\n", line, worst, failed);
+					}
+				}
+			}
+		}
+	}
+	{
+		/* ISR_EL1 bit 8: an SError pending (a bus error answer to a write lands there, masked in the kernel) */
+		uint64_t isr0, isr1, isr2, daif;
