@@ -2481,6 +2482,38 @@ plain_program(const char *fragment, const char *what)
 	return program;
 }
 
+/* The app-open transition can be the first draw that needs this lookup program. */
+static bool
+make_lookup_program(struct eagl *e)
+{
+	GLint linked = 0;
+	GLuint program;
+	uint64_t began;
+
+	if (e->lookup != 0) {
+		return true;
+	}
+
+	began = now_us();
+	program = plain_program(table_fragment, "through a table");
+	if (program == 0) {
+		return false;
+	}
+	glGetProgramiv(program, GL_LINK_STATUS, &linked);
+	if (!linked) {
+		glDeleteProgram(program);
+		return false;
+	}
+	e->lookup = program;
+	e->lookup_matrix = glGetUniformLocation(e->lookup, "vertex_matrix");
+	glUseProgram(e->lookup);
+	glUniform1i(glGetUniformLocation(e->lookup, "table"), 1);
+	if (frame_lines || warm_lookup) {
+		say("hakios-gl: colour lookup program linked and bound in %llu us\n", now_us() - began);
+	}
+	return true;
+}
