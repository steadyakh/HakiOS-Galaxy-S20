diff --git a/sysimage/apfs-extract.py b/sysimage/apfs-extract.py
new file mode 100644
index 0000000..c6f25ca
--- /dev/null
+++ b/sysimage/apfs-extract.py
@@ -0,0 +1,269 @@
+#!/usr/bin/env python3
+"""Unpack the files of an APFS disk image on Windows, where 7-Zip cannot do it all.
+
+usage: apfs-extract.py --dlls DIR [options] IMAGE OUTDIR
+
+Windows' 7-Zip skips every file compressed with LZBITMAP (it reports "Unsupported Method" and
+leaves nothing, not even the two attribute files unzbm.c would finish), and a Windows folder
+cannot hold a symbolic link without developer mode. This reads the image with HakiOS's own APFS
+reader (../tools/apfs/apfs.py) instead and:
+
+  - writes every regular file, decompressed: zlib, LZVN, LZFSE and LZBITMAP, the last three with
+    zbitmap.dll and lzfse.dll (built from open source by .github/workflows/x1s-wintools.yml);
+  - writes no symbolic link, but lists each one, with its target, in OUTDIR.manifest, which has the
+    format of system.manifest ("mode<TAB>uid<TAB>gid<TAB>path[<TAB>target]", octal mode), so that
+    ../tools/apfs/mkapfs.py makes them, and owners and modes, when it builds the image;
+  - uses \\\\?\\ paths, so paths longer than 260 characters work.
+
+  --only PATH          only this subtree (e.g. System/Library/Caches/com.apple.dyld)
+  --skip-name NAME     leave out every file or directory with this name, wherever it is
+  --skip PATH          leave out this path and what is below it
+  --skip-glob PATTERN  leave out files whose name matches (e.g. '*.symbols*')
+  --volume NAME        the volume to read (default: the first with a root directory)
+
+Nothing is downloaded. The image is the user's, out of the user's own IPSW (ipsw-member.py).
+"""
+import argparse
+import ctypes
+import fnmatch
+import os
+import struct
+import sys
+import types
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "tools", "apfs"))
+import apfs  # noqa: E402
+
+LZVN_MAGIC = 0x6e787662          # 'bvxn': an LZVN block inside an LZFSE stream
+END_MAGIC = 0x24787662           # 'bvx$': the end of the stream
+
+
+class Codecs:
+    def __init__(self, dlls):
+        self.zbm = ctypes.CDLL(os.path.join(dlls, "zbitmap.dll"))
+        self.zbm.zbm_decompress.restype = ctypes.c_int
+        self.zbm.zbm_decompress.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_char_p,
+                                            ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t)]
+        self.lz = ctypes.CDLL(os.path.join(dlls, "lzfse.dll"))
+        self.lz.lzfse_decode_buffer.restype = ctypes.c_size_t
+        self.lz.lzfse_decode_buffer.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_char_p,
+                                                ctypes.c_size_t, ctypes.c_void_p]
+        self.lz.lzfse_decode_scratch_size.restype = ctypes.c_size_t
+        self.scratch = ctypes.create_string_buffer(self.lz.lzfse_decode_scratch_size())
+
+    def lzfse(self, src, out_len=None):
+        """An LZFSE stream. Without a known size the buffer grows until the output fits."""
+        cap = out_len if out_len else max(len(src) * 8, 1 << 20)
+        while True:
+            dst = ctypes.create_string_buffer(cap + 1)
+            n = self.lz.lzfse_decode_buffer(dst, cap + 1, src, len(src), self.scratch)
+            if n <= cap:
+                return dst.raw[:n]
+            cap *= 2
+            if cap > 1 << 32:
+                raise apfs.ApfsError("lzfse: output too large")
+
+    def lzvn(self, src, out_len):
+        """A bare LZVN stream, wrapped as the one LZVN block of an LZFSE stream."""
+        hdr = struct.pack("<III", LZVN_MAGIC, out_len, len(src))
+        return self.lzfse(hdr + src + struct.pack("<I", END_MAGIC), out_len)[:out_len]
+
+    def zbitmap(self, src, out_len):
+        dst = ctypes.create_string_buffer(max(out_len, 1))
+        got = ctypes.c_size_t(0)
+        if self.zbm.zbm_decompress(dst, out_len, src, len(src), ctypes.byref(got)) != 0 or \
+                got.value != out_len:
+            raise apfs.ApfsError("LZBITMAP block does not decompress")
+        return dst.raw[:out_len]
+
+
+def install(codecs):
+    """Give apfs.py and dmg.py what they import as 'lzfse', and the decmpfs types they lack."""
+    mod = types.ModuleType("lzfse")
+    mod.decompress = lambda src: codecs.lzfse(bytes(src))
+    sys.modules["lzfse"] = mod
+
+    def one(ctype, piece, n):
+        if ctype in (7, 8):                  # LZVN: 0x06 in front means stored as it is
+            return piece[1:1 + n] if piece[:1] == b"\x06" else codecs.lzvn(piece, n)
+        return piece[1:1 + n] if piece[:1] == b"\xff" else codecs.zbitmap(piece, n)  # LZBITMAP
+
+    def table_fork(ctype, rsrc, usize):
+        # LZVN and LZBITMAP forks: le32 offsets of every block, and one more for the end (unzbm.c)
+        bs = apfs.DECMPFS_BLOCK_SIZE
+        blocks = (usize + bs - 1) // bs
+        if (blocks + 1) * 4 > len(rsrc):
+            raise apfs.ApfsError("block table does not fit in the resource fork")
+        out = bytearray()
+        for b in range(blocks):
+            fr, to = struct.unpack_from("<II", rsrc, 4 * b)
+            if fr > to or to > len(rsrc):
+                raise apfs.ApfsError("block %d out of range" % b)
+            out += one(ctype, rsrc[fr:to], min(bs, usize - b * bs))
+        return bytes(out)
+
+    old = apfs.Inode.decompress
+
+    def decompress(self, hdr):
+        _magic, ctype, usize = struct.unpack_from("<IIQ", hdr, 0)
+        if ctype in (7, 13):
+            return one(ctype, hdr[16:], usize)
+        if ctype in (8, 14):
+            rsrc = self.vol.xattr_bytes(self.obj_id, apfs.RSRC_FORK_XATTR_NAME, self.xattrs)
+            if rsrc is None:
+                raise apfs.ApfsError("inode %d: type %d but no resource fork" % (self.obj_id, ctype))
+            return table_fork(ctype, rsrc, usize)
+        return old(self, hdr)
+    apfs.Inode.decompress = decompress
+
+    # Sealed volumes (the cryptexes): file-system tree nodes carry no object header, so no
+    # checksum (the seal's hashes vouch for them instead); child links count from the root's identifier;
+    # and file extents
+    # live in a tree of their own, the fext tree, keyed (private id, logical offset).
+    old_get = apfs.Blocks.get
+
+    def get(self, addr, verify=True):
+        try:
+            return old_get(self, addr, verify)
+        except apfs.ApfsError:
+            b = self.raw(addr)
+            if len(b) == self.block_size and b[:32] == bytes(32) and \
+                    struct.unpack_from("<H", b, 32)[0] & apfs.BTNODE_NOHEADER:
+                self.cache[addr] = b
+                return b
+            raise
+    apfs.Blocks.get = get
+
+    def tree(self):
+        if self._tree is None:
+            self._tree = apfs.Btree(self.c.blocks, self.root_tree_oid,
+                                    resolve=self.omap.resolver(), name="fstree")
+            if self.sealed:
+                # a hashed tree names a child by its distance from the root's identifier: child
+                # n is object root+n in the object map (checked against the children's SHA-256s)
+                omap, root = self.omap, self.root_tree_oid
+                self._tree.resolve = lambda oid: omap.lookup(root + oid)
+        return self._tree
+    apfs.Volume.tree = property(tree)
+
+    old_extents = apfs.Volume.extents
+
+    def extents(self, stream_id):
+        if not self.sealed:
+            return old_extents(self, stream_id)
+        if getattr(self, "_fext", None) is None:
+            blk = self.c.blocks.get(self.addr)
+            self._fext = apfs.Btree(self.c.blocks, struct.unpack_from("<Q", blk, 1032)[0], name="fext")
+        out = []
+        for k, v in self._fext.iter_from(lambda k: struct.unpack_from("<QQ", k, 0) < (stream_id, 0)):
+            pid, logical = struct.unpack_from("<QQ", k, 0)
+            if pid != stream_id:
+                break
+            len_and_flags, phys = struct.unpack_from("<QQ", v, 0)
+            out.append((logical, len_and_flags & apfs.J_FILE_EXTENT_LEN_MASK, phys))
+        return out
+    apfs.Volume.extents = extents
+
+
+def long_path(p):
+    p = os.path.abspath(p)
+    if os.name == "nt" and not p.startswith("\\\\?\\"):
+        p = "\\\\?\\" + p
+    return p
+
+
+def write_file(vol, ino, dst):
+    hdr = ino.decmpfs
+    if hdr is not None and len(hdr) >= 16 and struct.unpack_from("<I", hdr, 0)[0] == apfs.DECMPFS_MAGIC:
+        data = ino.decompress(hdr)
+        with open(dst, "wb") as f:
+            f.write(data)
+        return len(data)
+    size = ino._dstream[0] if ino._dstream else 0
+    bs = vol.c.block_size
+    with open(dst, "wb") as f:
+        if size:
+            f.truncate(size)                 # holes read as zeros
+        for logical, length, phys in vol.extents(ino.private_id):
+            if logical >= size or phys == 0:
+                continue
+            n = min(length, size - logical)
+            f.seek(logical)
+            done = 0
+            while done < n:                  # 64 MB at a time
+                k = min(n - done, 64 << 20)
+                nb = (k + bs - 1) // bs
+                f.write(vol.c.blocks.raw(phys + done // bs, nb)[:k])
+                done += k
+    return size
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("image")
+    ap.add_argument("outdir")
+    ap.add_argument("--dlls", required=True)
+    ap.add_argument("--only", default="")
+    ap.add_argument("--skip-name", action="append", default=[])
+    ap.add_argument("--skip", action="append", default=[])
+    ap.add_argument("--skip-glob", action="append", default=[])
+    ap.add_argument("--volume")
+    a = ap.parse_args()
+
+    install(Codecs(a.dlls))
+    c = apfs.Container(a.image)
+    vol = apfs.pick_volume(c, a.volume)
+    only = a.only.strip("/")
+    start = apfs.ROOT_DIR_INO_NUM
+    if only:
+        hit = vol.lookup(only)
+        if hit is None:
+            sys.exit("apfs-extract: %s: not in the image" % only)
+        start = hit[0]
+    skips = [s.strip("/") for s in a.skip]
+    out_root = long_path(a.outdir)
+    os.makedirs(out_root, exist_ok=True)
+    manifest = []
+    nfiles = nbytes = nlinks = nother = 0
+    prefix = only + "/" if only else ""
+
+    def visit(oid, rel):
+        nonlocal nfiles, nbytes, nlinks, nother
+        for name, fid, dt in sorted(vol.dir_entries(oid)):
+            r = rel + name
+            if name in a.skip_name or (prefix + r) in skips:
+                continue
+            ino = vol.inode(fid)
+            if ino is None:
+                continue
+            line = "%o\t%d\t%d\t%s" % (ino.mode, ino.owner, ino.group, r)
+            dst = os.path.join(out_root, *r.split("/"))
+            if dt == 4:
+                os.makedirs(dst, exist_ok=True)
+                manifest.append(line)
+                visit(fid, r + "/")
+            elif dt == 8:
+                if any(fnmatch.fnmatchcase(name, g) for g in a.skip_glob):
+                    continue
+                nbytes += write_file(vol, ino, dst)
+                nfiles += 1
+                manifest.append(line)
+                if nfiles % 500 == 0:
+                    print("  %d files, %.0f MB" % (nfiles, nbytes / 1e6), flush=True)
+            elif dt == 10:
+                t = ino.symlink_target_bytes() or b""
+                manifest.append(line + "\t" + t.decode("utf-8", "surrogateescape"))
+                nlinks += 1
+            else:
+                nother += 1
+
+    visit(start, "")
+    mpath = long_path(a.outdir.rstrip("\\/") + ".manifest")
+    with open(mpath, "w", encoding="utf-8", errors="surrogateescape", newline="\n") as f:
+        f.write("\n".join(manifest) + "\n")
+    print("apfs-extract: %d files (%.1f MB), %d symbolic links (in %s), %d others left out"
+          % (nfiles, nbytes / 1e6, nlinks, os.path.basename(mpath), nother))
+
+
+if __name__ == "__main__":
+    main()
