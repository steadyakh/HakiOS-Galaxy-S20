index c604123..0647ae9 100755
--- a/userland/build.sh
+++ b/userland/build.sh
@@ -80,10 +80,42 @@
 #   CHECK=1          check every image (every container) as it is made: apfsck has to find it clean and
 #                    the kernel's apfs_lib has to read every volume back as the directory it was made of
 #                    (../tools/apfs/check-image.sh; the system image takes a few minutes more)
+#   PREBUILT_DIR=... with PREBUILT=1: take the programs from there instead (a CI build's, say)
+#   COMPILE_ONLY=1   compile the programs into obj/ and stop: no Darwin file is read or needed (with an empty
+#                    ../sysimage/rootfs/usr/lib the dynamically linked ones too). For a CI runner that has the
+#                    toolchain but must not have Apple's files; the images are then made elsewhere with PREBUILT_DIR.
+#
+# On Windows (Git Bash, no WSL) the images are made with PREBUILT=1. Git Bash cannot make a symbolic link,
+# so `ln -s` notes each one in obj/winlinks.tsv and mkapfs.py (MKAPFS_LINKS) puts it into the image; the
+# links of an unpacked cryptex come from its .manifest (../sysimage/apfs-extract.py).
 set -e
 # a copy of a tree that shares its files' data: hard links (Linux), clones of the files (macOS's APFS, whose cp has no -l)
-linkcopy() { if [ "$(uname)" = Darwin ]; then cp -cRp "$1" "$2"; else cp -al "$1" "$2"; fi; }
+linkcopy() {
+	if [ "$(uname)" = Darwin ]; then cp -cRp "$1" "$2"; else cp -al "$1" "$2"; fi
+	if [ -n "$MKAPFS_LINKS" ] && [ -f "$1.manifest" ]; then
+		awk -F'\t' -v d="$(cd "$2" && pwd -W)" '$1 ~ /^12/ { print d "/" $4 "\t" $5 }' "$1.manifest" >> "$MKAPFS_LINKS"
+	fi
+}
 cd "$(dirname "$(readlink -f "$0")")"
+case "$(uname)" in
+MINGW*|MSYS*|CYGWIN*)
+	mkdir -p obj
+	export MKAPFS_LINKS=$(pwd -W)/obj/winlinks.tsv
+	rm -f "$MKAPFS_LINKS"
+	ln() {
+		local s= f= a
+		while [ "${1#-}" != "$1" ]; do
+			case "$1" in *s*) s=1 ;; esac
+			case "$1" in *f*) f=1 ;; esac
+			shift
+		done
+		if [ -z "$s" ]; then command ln ${f:+-f} "$@"; return; fi
