diff --git a/userland/src/mali_test.c b/userland/src/mali_test.c
new file mode 100644
index 0000000..d89e9a7
--- /dev/null
+++ b/userland/src/mali_test.c
@@ -0,0 +1,117 @@
+/*
+ * mali_test: the Galaxy S20's Mali-G77 given one job from user space, through the kernel's service HakiosGPU in
+ * its Panfrost mode (boot-args mali=3 mali_keep=1: drivers/gpu/hakios.mali.c, hakios.gpu.cpp) -- the requests
+ * Mesa's panfrost makes, without Mesa: what the GPU says it is (GET_PARAM), a buffer (CREATE_BO) seen in this
+ * process (client memory of the type that is its handle, as tools/mesa/hakios-drm maps it), a WRITE_VALUE job in
+ * it, SUBMIT, the fence waited for (msm's WAIT_FENCE, which hakios-drm uses), and the value looked for.
+ *
+ *   mali_test [JOBS]     JOBS jobs one after another (default 3), each writing its own number
+ */
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <mach/mach_time.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define GPU_SERVICE             "HakiosGPU"
+#define REQ_SUBMIT              0x40
+#define REQ_CREATE_BO           0x42
+#define REQ_GET_PARAM           0x44
+#define REQ_GET_BO_OFFSET       0x45
+#define REQ_WAIT_FENCE          0x47    /* msm's */
+
+struct submit {
+	uint64_t jc, in_syncs;
+	uint32_t in_sync_count, out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count, requirements;
+};
+struct create_bo {
+	uint32_t size, flags, handle, pad;
+	uint64_t offset;
+};
+struct get_param {
+	uint32_t param, pad;
+	uint64_t value;
+};
+struct wait_fence {
+	uint32_t fence, flags;
+	int64_t seconds, nanoseconds;
+	uint32_t queueid;
+};
+
+static io_connect_t gpu;
+
+static int
+call(uint32_t number, void *data, size_t size)
+{
+	size_t out = size;
+	kern_return_t r = IOConnectCallStructMethod(gpu, number, data, size, data, &out);
+
+	return r == KERN_SUCCESS ? 0 : (int)r;
+}
+
+static uint64_t
+param(uint32_t which)
+{
+	struct get_param p = { .param = which };
+
+	return call(REQ_GET_PARAM, &p, sizeof(p)) == 0 ? p.value : ~0ull;
+}
+
+int
+main(int argc, char **argv)
+{
+	io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching(GPU_SERVICE));
+	struct create_bo bo = { .size = 16384 };
+	mach_vm_address_t cpu = 0;
+	mach_vm_size_t length = 0;
+	int jobs = argc > 1 ? atoi(argv[1]) : 3, good = 0;
+
+	if (service == 0 || IOServiceOpen(service, mach_task_self(), 0, &gpu) != KERN_SUCCESS) {
+		printf("mali_test: no GPU service (boot-args mali=3 mali_keep=1?)\n");
+		return 1;
+	}
+	printf("mali_test: GPU product %#llx revision %#llx, shaders %#llx, L2 %#llx, tiler %#llx, MMU features %#llx, "
+	    "max threads %llu, TLS %llu\n", param(0), param(1), param(2), param(4), param(3), param(12), param(14), param(39));
+	if (call(REQ_CREATE_BO, &bo, sizeof(bo)) != 0 ||
+	    IOConnectMapMemory64(gpu, bo.handle, mach_task_self(), &cpu, &length, kIOMapAnywhere) != KERN_SUCCESS) {
+		printf("mali_test: no buffer (%u)\n", bo.handle);
+		return 1;
+	}
+	printf("mali_test: buffer %u, GPU address %#llx, mapped here at %#llx (%llu bytes)\n", bo.handle, bo.offset,
+	    (unsigned long long)cpu, (unsigned long long)length);
+	for (int n = 1; n <= jobs; n++) {
+		volatile uint32_t *job = (volatile uint32_t *)(uintptr_t)cpu;
+		volatile uint32_t *target = (volatile uint32_t *)(uintptr_t)(cpu + 0x1000);
+		uint32_t value = 0x6a0b0000u + (uint32_t)n;
+		uint64_t at = bo.offset + 0x1000, t0, t1;
+		struct submit s = { .jc = bo.offset };
+		struct wait_fence w = { .seconds = 2 };
+		int r;
+
+		memset((void *)job, 0, 64);
+		job[4] = 1u | 2u << 1 | 1u << 16;      /* 64-bit descriptors, WRITE_VALUE, index 1 */
+		job[8] = (uint32_t)at;
+		job[9] = (uint32_t)(at >> 32);
+		job[10] = 6;                           /* a 32-bit immediate */
+		job[12] = value;
+		*target = 0xdeadbeefu;
+		__sync_synchronize();
+		t0 = mach_absolute_time();
+		r = call(REQ_SUBMIT, &s, sizeof(s));
+		w.fence = s.out_sync;
+		if (r == 0) {
+			r = call(REQ_WAIT_FENCE, &w, sizeof(w));
+		}
+		t1 = mach_absolute_time();
+		printf("mali_test: job %d: submit+wait %d, fence %u, status word %#x, value %#x (%s), %llu us\n", n, r, s.out_sync,
+		    job[0], *target, *target == value ? "WRITTEN BY THE GPU" : "not written",
+		    (unsigned long long)(t1 - t0) * 1000 / 26000);
+		good += *target == value;
+	}
+	printf("mali_test: %d of %d jobs done by the GPU\n", good, jobs);
+	return good == jobs ? 0 : 2;
+}
diff --git a/userland/src/rwremote.c b/userland/src/rwremote.c
new file mode 100644
index 0000000..7928afa
--- /dev/null
+++ b/userland/src/rwremote.c
@@ -0,0 +1,66 @@
+/*
+ * rwremote: touches from the computer while iOS runs (the Galaxy S20's remote control, devices/x1s/PLAN.md).
+ *
+ * The host sends "fastboot oem touch STEPS" to the loader, which watches the kernel from core 0 (bootcpu=N); the loader
+ * puts STEPS into the kernel's loader_live mailbox with a new number (xnu/files/osfmk/arm64/loader_return.c), and the
+ * kernel gives both out as kern.hakios.remote, "NUMBER STEPS". This program looks every 30 ms and runs
+ *   /redwood/bin/rwtouch STEPS
+ * for each new number -- tap, swipe, drag, button home and the rest of rwtouch's steps. One command at a time:
+ * a new one waits for the one before to end.
+ *
+ * usage: rwremote          (rc.jobs.remote starts it in the background)
+ */
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/sysctl.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+int
+main(void)
+{
+	unsigned long long last = 0;
+	int said = 0;
+
+	for (;;) {
+		char buf[320], *steps, *argv[64];
+		size_t len = sizeof(buf) - 1;
+		unsigned long long seq;
+		int argc = 0;
+		pid_t pid;
+
+		if (sysctlbyname("kern.hakios.remote", buf, &len, NULL, 0) != 0) {
+			if (!said) {
+				printf("rwremote: no kern.hakios.remote in this kernel: nothing to do\n");
+				said = 1;
+			}
+			sleep(5);
+			continue;
+		}
+		buf[len < sizeof(buf) ? len : sizeof(buf) - 1] = 0;
+		seq = strtoull(buf, &steps, 10);
+		if (seq == 0 || seq == last) {
+			usleep(30000);
+			continue;
+		}
+		last = seq;
+		argv[argc++] = "/redwood/bin/rwtouch";
+		for (char *t = strtok(steps, " \t\n"); t != NULL && argc < 63; t = strtok(NULL, " \t\n")) {
+			argv[argc++] = t;
+		}
+		argv[argc] = NULL;
+		if (argc < 2) {
+			continue;
+		}
+		printf("rwremote: %llu:%s\n", seq, steps);
+		if (posix_spawn(&pid, argv[0], NULL, NULL, argv, environ) == 0) {
+			int status;
+
+			waitpid(pid, &status, 0);
+		}
+	}
+}
