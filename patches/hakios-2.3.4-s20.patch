diff --git a/tools/mk-jb-win.py b/tools/mk-jb-win.py
new file mode 100644
index 0000000..261df0b
--- /dev/null
+++ b/tools/mk-jb-win.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""
+tools/mk-jb.sh for Windows (Git Bash, no WSL): the Procursus rootless bootstrap with Sileo in it, unpacked into jb/
+(never in the repository), as userland/build.sh takes it -- jb/root/var/jb -- plus what Windows cannot keep in a
+directory: jb/root/var/jb.manifest, one line per entry (mode in octal with the type bits, uid, gid, path relative to
+var/jb, and for a symbolic link its target), in the format of tools/apfs/mkapfs.py's manifests. userland/build.sh adds
+it to the system image's manifest, so the image gets the links (1151 in the bootstrap), the owners and the set-user-ID
+bits (login, su, sudo, passwd, ..., Sileo's giveMeRoot) that unpacking on NTFS loses.
+
+  python tools/mk-jb-win.py          (downloads into jb/debs once, like mk-jb.sh)
+
+Needs Python 3.14 (compression.zstd). The same sources and versions as mk-jb.sh.
+"""
+import io, os, shutil, stat, sys, tarfile, urllib.request
+
+SUITE = '1800'
+SILEO = 'org.coolstar.sileo_2.5.1_iphoneos-arm64.deb'
+MIRROR = 'https://apt.procurs.us'
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
+OUT = os.path.join(ROOT, 'jb')
+JB = os.path.join(OUT, 'root', 'var', 'jb')
+
+try:
+    from compression import zstd
+except ImportError:
+    sys.exit('mk-jb-win.py: needs Python 3.14 or newer (compression.zstd)')
+
+
+def get(url, name):
+    path = os.path.join(OUT, 'debs', name)
+    if not (os.path.exists(path) and os.path.getsize(path) > 0):
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with urllib.request.urlopen(url) as r, open(path + '.part', 'wb') as f:
+            shutil.copyfileobj(r, f)
+        os.replace(path + '.part', path)
+    return path
+
+
+def ar_members(data):
+    """a .deb is an ar archive: {name: bytes}"""
+    if data[:8] != b'!<arch>\n':
+        sys.exit('mk-jb-win.py: the .deb is not an ar archive')
+    at, out = 8, {}
+    while at + 60 <= len(data):
+        head = data[at:at + 60]
+        name = head[:16].decode().strip().rstrip('/')
+        size = int(head[48:58].decode().strip())
+        out[name] = data[at + 60:at + 60 + size]
+        at += 60 + size + (size & 1)
+    return out
+
+
+def open_tar(name, blob):
+    if name.endswith('.zst'):
+        return tarfile.open(fileobj=zstd.ZstdFile(io.BytesIO(blob)), mode='r|')
+    return tarfile.open(fileobj=io.BytesIO(blob), mode='r:*')
+
+
+def unpack(tar, manifest):
+    """every entry under var/jb into JB; what NTFS cannot hold into manifest {relative path: line}"""
+    for m in tar:
+        name = m.name[2:] if m.name.startswith('./') else m.name
+        name = name.rstrip('/')
+        rel = name[len('var/jb/'):] if name.startswith('var/jb/') else None
+        if not rel:
+            continue
+        if '..' in rel.split('/') or any(c in rel for c in ':*?"<>|\\'):
+            sys.exit('mk-jb-win.py: an entry Windows cannot hold: %s' % rel)
+        dest = os.path.join(JB, *rel.split('/'))
+        perm = m.mode & 0o7777
+        if m.isdir():
+            os.makedirs(dest, exist_ok=True)
+            manifest[rel] = '%o\t%d\t%d\t%s' % (stat.S_IFDIR | perm, m.uid, m.gid, rel)
+        elif m.issym():
+            if os.path.lexists(dest) and not os.path.isdir(dest):
+                os.remove(dest)
+            manifest[rel] = '%o\t%d\t%d\t%s\t%s' % (stat.S_IFLNK | 0o755, m.uid, m.gid, rel, m.linkname)
+        elif m.islnk():
+            target = m.linkname[2:] if m.linkname.startswith('./') else m.linkname
+            src = os.path.join(JB, *target[len('var/jb/'):].split('/'))
+            os.makedirs(os.path.dirname(dest), exist_ok=True)
+            shutil.copyfile(src, dest)
+            manifest[rel] = '%o\t%d\t%d\t%s' % (stat.S_IFREG | perm, m.uid, m.gid, rel)
+        elif m.isfile():
+            os.makedirs(os.path.dirname(dest), exist_ok=True)
+            with tar.extractfile(m) as f, open(dest, 'wb') as o:
+                shutil.copyfileobj(f, o)
+            manifest[rel] = '%o\t%d\t%d\t%s' % (stat.S_IFREG | perm, m.uid, m.gid, rel)
+
+
+def main():
+    boot = get('%s/bootstraps/%s/bootstrap-iphoneos-arm64.tar.zst' % (MIRROR, SUITE), 'bootstrap.tar.zst')
+    deb = get('%s/pool/main/iphoneos-arm64-rootless/%s/sileo/%s' % (MIRROR, SUITE, SILEO), 'sileo.deb')
+    shutil.rmtree(os.path.join(OUT, 'root'), ignore_errors=True)
+    os.makedirs(JB)
+    manifest = {}
+    with zstd.open(boot, 'rb') as f, tarfile.open(fileobj=f, mode='r|') as t:
+        unpack(t, manifest)
+    parts = ar_members(open(deb, 'rb').read())
+    data = [n for n in parts if n.startswith('data.tar')]
+    if not data:
+        sys.exit('mk-jb-win.py: the .deb has no data.tar')
+    with open_tar(data[0], parts[data[0]]) as t:
+        unpack(t, manifest)
+    app = os.path.join(JB, 'Applications', 'Sileo.app')
+    if not os.path.isdir(app):
+        sys.exit('mk-jb-win.py: no Sileo.app in the package')
+    # Sileo's root helper: set-user-ID root, as the package ships it (mk-jb.sh: chmod 4755)
+    rel = 'Applications/Sileo.app/giveMeRoot'
+    if rel not in manifest:
+        sys.exit('mk-jb-win.py: no giveMeRoot in Sileo.app')
+    manifest[rel] = '%o\t0\t0\t%s' % (stat.S_IFREG | 0o4755, rel)
+    with open(os.path.join(OUT, 'root', 'var', 'jb.manifest'), 'w', newline='\n') as f:
+        for rel in sorted(manifest):
+            f.write(manifest[rel] + '\n')
+    links = sum(1 for l in manifest.values() if l.startswith('12'))
+    setid = sorted(l.split('\t')[3] for l in manifest.values() if int(l.split('\t')[0], 8) & 0o6000)
+    print('mk-jb-win.py: %d entries (%d links) in %s; set-ID: %s' % (len(manifest), links, JB, ', '.join(setid)))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mkdatavol-x1s.py b/tools/mkdatavol-x1s.py
new file mode 100644
index 0000000..b5ec076
--- /dev/null
+++ b/tools/mkdatavol-x1s.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""The Galaxy S20's data volume (devices/x1s/PLAN.md S5): the pieces of an empty HFS Plus volume to write into the first
+110 GB of its userdata from TWRP, and the script that writes them.
+
+usage: mkdatavol-x1s.py VOLUME.hfs OUTDIR
+
+VOLUME.hfs is the whole volume as mkfs.hfsplus made it (26855468 blocks of 4096; made on Windows as a sparse file, so
+it takes no room: devices/x1s/README or PLAN.md S5). Only the blocks the new volume uses -- the volume header and its
+copy at the end, the allocation bitmap, the extents and catalog trees, the journal -- are written: what is in free
+space does not matter to HFS Plus. OUTDIR gets one file per run of used blocks, a list, and twrp-write.sh, which
+writes them with dd into /dev/block/by-name/userdata at their block and reads each back.
+"""
+import hashlib
+import os
+import struct
+import sys
+
+BS = 4096
+VOL_BLOCKS = 26855468                 # xnuloader/loader.c USERDATA_VOL_BLOCKS, drivers/storage/hakios.ufs.c UFS_USERDATA_VOL
+USERDATA_MIN_BYTES = VOL_BLOCKS * BS
+
+
+def used_blocks(img):
+    img.seek(1024)
+    vh = img.read(512)
+    sig, = struct.unpack('>H', vh[0:2])
+    if sig not in (0x482B, 0x4858):
+        sys.exit('mkdatavol-x1s.py: no HFS Plus volume header')
+    block_size, total = struct.unpack('>II', vh[40:48])
+    if block_size != BS or total != VOL_BLOCKS:
+        sys.exit('mkdatavol-x1s.py: the volume is %d blocks of %d, not %d of %d' % (total, block_size, VOL_BLOCKS, BS))
+    fork = vh[112:192]
+    extents = [struct.unpack('>II', fork[16 + 8 * i:24 + 8 * i]) for i in range(8)]
+    bitmap = bytearray()
+    for start, count in extents:
+        if count:
+            img.seek(start * BS)
+            bitmap += img.read(count * BS)
+    if len(bitmap) * 8 < total:
+        sys.exit('mkdatavol-x1s.py: the allocation file is in more pieces than its fork says')
+    runs = []
+    b = 0
+    while b < total:
+        byte = bitmap[b >> 3]
+        if byte == 0 and (b & 7) == 0:
+            b += 8
+            continue
+        if byte & (0x80 >> (b & 7)):
+            if runs and runs[-1][0] + runs[-1][1] == b:
+                runs[-1][1] += 1
+            else:
+                runs.append([b, 1])
+        b += 1
+    return runs
+
+
+def main():
+    if len(sys.argv) != 3:
+        sys.exit(__doc__)
+    vol, out = sys.argv[1], sys.argv[2]
+    os.makedirs(out, exist_ok=True)
+    lines = ['#!/system/bin/sh',
+             '# written by tools/mkdatavol-x1s.py: the empty data volume into the first 110 GB of userdata',
+             'set -e',
+             'cd "$(dirname "$0")"',
+             'dev=/dev/block/by-name/userdata',
+             'real=$(readlink -f $dev)',
+             'size=$(blockdev --getsize64 $real)',
+             'echo "userdata is $real, $size bytes"',
+             '[ "$size" -ge %d ] || { echo "userdata is smaller than the volume: nothing written"; exit 1; }' % USERDATA_MIN_BYTES,
+             'grep -q " /data " /proc/mounts && { echo "/data is mounted: unmount it first (umount /data)"; exit 1; }',
+             ]
+    total_bytes = 0
+    with open(vol, 'rb') as img:
+        runs = used_blocks(img)
+        listing = []
+        for first, count in runs:
+            img.seek(first * BS)
+            data = img.read(count * BS)
+            name = 'blk_%08d_%d.bin' % (first, count)
+            with open(os.path.join(out, name), 'wb') as f:
+                f.write(data)
+            sha = hashlib.sha256(data).hexdigest()
+            listing.append('%d %d %s %s' % (first, count, sha, name))
+            lines.append('dd if=%s of=$dev bs=4096 seek=%d count=%d conv=notrunc,fsync 2>/dev/null' % (name, first, count))
+            lines.append('[ "$(dd if=$dev bs=4096 skip=%d count=%d 2>/dev/null | sha256sum | cut -d" " -f1)" = %s ] '
+                         '|| { echo "block %d: read back differs"; exit 1; }' % (first, count, sha, first))
+            total_bytes += len(data)
+    lines.append('sync')
+    lines.append('echo "the data volume is written: %d pieces, %d bytes, each read back the same"' % (len(runs), total_bytes))
+    with open(os.path.join(out, 'twrp-write.sh'), 'w', newline='\n') as f:
+        f.write('\n'.join(lines) + '\n')
+    with open(os.path.join(out, 'pieces.txt'), 'w', newline='\n') as f:
+        f.write('\n'.join(listing) + '\n')
+    for l in listing:
+        print(l)
+    print('%s: %d pieces, %d bytes to write' % (out, len(runs), total_bytes))
+
+
+if __name__ == '__main__':
+    main()
