+/*
+ * Panfrost's requests (the Galaxy S20's Mali, gb == &gMali), on the buffers above: a buffer is wired memory entered
+ * into the GPU's address space 0, executable unless the program says otherwise (the GPU runs its shaders from them).
+ * A submission is the GPU address of a job chain; its fence goes back in out_sync, and every buffer of this client
+ * waits for it (the bo_handles list is not read: all of them are the GPU's). What Panfrost waits for before
+ * submitting, tools/mesa/hakios-drm waits for in the program. With the lock not held.
+ */
+IOReturn
+HakiosGPUUserClient::panfrostRequest(uint32_t selector, void * request)
+{
+	IOReturn ret = kIOReturnSuccess;
+	struct gpu_buffer * b;
+
+	switch (selector) {
+	case kPanfrostSubmit: {
+		struct panfrost_submit * r = (struct panfrost_submit *) request;
+		uint64_t jc = r->jc;
+		uint32_t req = r->requirements, fence;
+
+		IOLockLock(gGPULock);
+		gb->to_memory(NULL, 0);                         /* (a barrier: what the program wrote is in memory) */
+		fence = gb->submit(&jc, &req, 1);
+		if (fence == 0) {
+			IOLockUnlock(gGPULock);
+			return kIOReturnBusy;
+		}
+		/*
+		 * (every buffer of the program's: Panfrost's jobs name their buffers inside the job chain, not in the request;
+		 * a surface among them is what the display's driver waits for before it shows it, MiniIOSurfaceDrawn(), and
+		 * the panel-sized one the GPU stretches a frame into is only shown once a submission has named it at all)
+		 */
+		/*
+		 * Only the buffers the job names (bo_handles), when it names them: marking every buffer of the program busy
+		 * made Panfrost's cache of freed buffers find none idle, so every render pass's scratch memory was made anew
+		 * and freed (run 104's glprof: a quarter of the drawing thread in buffer making, mapping and freeing).
+		 */
+		uint32_t named = r->bo_handle_count;
+		uint32_t * handles = named != 0 && named <= GPU_BUFFERS ? IONew(uint32_t, named) : NULL;
+
+		if (handles != NULL && copyin((user_addr_t) r->bo_handles, handles, named * sizeof(uint32_t)) == 0) {
+			for (uint32_t i = 0; i < named; i++) {
+				if ((b = buffer(handles[i])) != NULL) {
+					b->fence = fence;
+					if (b->surface != NULL) {
+						b->surface->drawn = fence;
+					}
+				}
+			}
+		} else {
+			for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+				if (fBuffers[i].memory != NULL) {
+					fBuffers[i].fence = fence;
+					if (fBuffers[i].surface != NULL) {
+						fBuffers[i].surface->drawn = fence;
+					}
+				}
+			}
+		}
+		if (handles != NULL) {
+			IODelete(handles, uint32_t, named);
+		}
+		IOLockUnlock(gGPULock);
+		r->out_sync = fence;
+		break;
+	}
+	case kPanfrostWaitBo: {
+		struct panfrost_wait_bo * r = (struct panfrost_wait_bo *) request;
+		uint32_t fence;
+
+		IOLockLock(gGPULock);
+		b = buffer(r->handle);
+		fence = b != NULL && b->fence != 0 ? b->fence : gb->last();
+		if (!gpuWait(fence, r->timeout_ns != 0 ? 2000 : 0)) {
+			ret = kIOReturnTimeout;
+		}
+		IOLockUnlock(gGPULock);
+		break;
+	}
+	case kPanfrostCreateBo: {
+		struct panfrost_create_bo * r = (struct panfrost_create_bo *) request;
+		struct msm_gem_new made;
+
+		bzero(&made, sizeof(made));
+		made.size = r->size;
+
+		ret = gemNew(&made);
+		if (ret == kIOReturnSuccess) {
+			IOLockLock(gGPULock);
+			b = buffer(made.handle);
+			r->handle = made.handle;
+			r->offset = b != NULL ? b->address : 0;
+			IOLockUnlock(gGPULock);
+		}
+		break;
+	}
+	case kPanfrostMmapBo:
+		((struct panfrost_mmap_bo *) request)->offset = 0;     /* (mapped as client memory of type = handle) */
+		break;
+	case kPanfrostGetParam: {
+		struct panfrost_get_param * r = (struct panfrost_get_param *) request;
+
+		ret = gb->parameter(r->param, &r->value) ? kIOReturnSuccess : kIOReturnBadArgument;
+		break;
+	}
+	case kPanfrostGetBoOffset: {
+		struct panfrost_get_bo_offset * r = (struct panfrost_get_bo_offset *) request;
+
+		IOLockLock(gGPULock);
+		b = buffer(r->handle);
+		r->offset = b != NULL ? b->address : 0;
+		ret = b != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+		IOLockUnlock(gGPULock);
+		break;
+	}
+	case kPanfrostMadvise:
+		((struct panfrost_madvise *) request)->retained = 1;
+		break;
+	case kPanfrostSetLabelBo:
+		break;
+	default:
+		IOLog("HakiosGPU: Panfrost's request %#x is not known here\n", selector);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	return ret;
+}
+
+/*
+ * Panfrost's SUBMIT and WAIT_BO by IOConnectTrap (the S20's Mali): an IOKit trap goes straight to the method, without
+ * IOConnectCallStructMethod's Mach message and its copies -- after runs 104-107 those two calls were about a fifth of
+ * the window server's drawing thread (glprof). The Galaxy S9+ port does the same (danstronics/ios-s9plus-exynos,
+ * hakios.mali_fast.h). Trap 0: SUBMIT, p1 the user's 40-byte drm_panfrost_submit (its out_sync written back); trap 1:
+ * WAIT_BO, p1 its 16 bytes. tools/mesa/hakios-drm/hakios.drm.c uses them when the first answers.
+ */
+IOExternalTrap *
+HakiosGPUUserClient::getTargetAndTrapForIndex(IOService ** targetP, UInt32 index)
+{
+	static IOExternalTrap traps[2] = {
+		{ NULL, (IOTrap) &HakiosGPUUserClient::trapSubmit },
+		{ NULL, (IOTrap) &HakiosGPUUserClient::trapWaitBo },
+	};
+
+	if (index >= 2 || gb != &gMali) {
+		return NULL;
+	}
+	*targetP = this;
+	return &traps[index];
+}
+
+IOReturn
+HakiosGPUUserClient::trapSubmit(void * p1, void *, void *, void *, void *, void *)
+{
+	struct panfrost_submit request;
+	IOReturn ret;
+
+	if (copyin((user_addr_t) p1, &request, sizeof(request)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	ret = panfrostRequest(kPanfrostSubmit, &request);
+	if (ret == kIOReturnSuccess && copyout(&request, (user_addr_t) p1, sizeof(request)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return ret;
+}
+
+IOReturn
+HakiosGPUUserClient::trapWaitBo(void * p1, void *, void *, void *, void *, void *)
+{
+	struct panfrost_wait_bo request;
+
+	if (copyin((user_addr_t) p1, &request, sizeof(request)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return panfrostRequest(kPanfrostWaitBo, &request);
+}
