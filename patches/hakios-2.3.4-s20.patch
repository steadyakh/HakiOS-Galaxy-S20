+/*
+ * The root image from a partition of the phone's own storage (rd_part=NAME on the payload's command line): read by
+ * this loader into the place "oem ramdisk" puts one, before the run, so the run is exactly a USB one without the USB
+ * (the S20's "Boot iOS from storage", devices/x1s/PLAN.md S4). Only read_blocks is called. The image is an APFS
+ * container: its size is its own superblock's (block size times block count at offsets 36 and 40, "NXSB" at 32), and
+ * it has to fit both the partition and the room. Returns the size read, or 0.
+ */
+static uint64_t
+rd_from_partition(const char *want, uint8_t *dest, uint64_t room)
+{
+	static const efi_guid part_guid = EFI_PARTITION_INFO_GUID;
+	static const efi_guid blk_guid = EFI_BLOCK_IO_GUID;
+	efi_handle *handles;
+	uint64_t count, size = 0;
+
+	if (EFI_ERROR(BS->locate_handle_buffer(ByProtocol, &part_guid, NULL, &count, &handles))) {
+		print("rd_part: no partitions from the firmware\n");
+		return 0;
+	}
+	for (uint64_t i = 0; i < count; i++) {
+		efi_partition_info *info;
+		efi_block_io *bio;
+		char name[40];
+		uint64_t bs, part_bytes, done, t0, nx_count = 0;
+		uint32_t nx_bs;
+
+		if (EFI_ERROR(BS->handle_protocol(handles[i], &part_guid, (void **)&info)) || info->type != 2 ||
+		    EFI_ERROR(BS->handle_protocol(handles[i], &blk_guid, (void **)&bio))) {
+			continue;
+		}
+		ufs_name(info, name, sizeof(name));
+		if (!str_same(name, want)) {
+			continue;
+		}
+		bs = bio->media->block_size;
+		part_bytes = (bio->media->last_block + 1) * bs;
+		if (bs == 0 || bs > 0x10000 || room < bs ||
+		    EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, 0, bs, dest))) {
+			print("rd_part: %s: its first block does not read\n", name);
+			break;
+		}
+		nx_bs = (uint32_t)dest[36] | (uint32_t)dest[37] << 8 | (uint32_t)dest[38] << 16 | (uint32_t)dest[39] << 24;
+		for (int b = 7; b >= 0; b--) {
+			nx_count = nx_count << 8 | dest[40 + b];
+		}
+		if (memcmp(dest + 32, "NXSB", 4) != 0 || nx_bs == 0 || nx_count == 0 || nx_count > part_bytes / nx_bs) {
+			print("rd_part: %s holds no APFS image (or a damaged one)\n", name);
+			break;
+		}
+		size = (uint64_t)nx_bs * nx_count;
+		if (size > part_bytes || size > room || size % bs != 0) {
+			print("rd_part: the image (%x bytes) does not fit (partition %x, room %x)\n", size, part_bytes, room);
+			size = 0;
+			break;
+		}
+		print("rd_part: reading %d MB of %s into %x\n", size >> 20, name, (uint64_t)(uintptr_t)dest);
+		t0 = READ_SYSREG(CNTVCT_EL0);
+		for (done = 0; done < size;) {
+			uint64_t chunk = size - done < (16ULL << 20) ? size - done : (16ULL << 20);
+
+			if (EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, done / bs, chunk, dest + done))) {
+				print("rd_part: read failed at %x\n", done);
+				size = 0;
+				break;
+			}
+			done += chunk;
+			if ((done & ((256ULL << 20) - 1)) == 0) {
+				print("rd_part: %d MB\n", done >> 20);
+			}
+		}
+		if (size) {
+			print("rd_part: %d MB in %d ms\n", size >> 20, hc_ms_since(t0));
+		}
+		break;
+	}
+	BS->free_pool(handles);
+	return size;
+}
