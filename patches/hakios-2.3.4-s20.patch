+/* the value of NAME=value on a command line, into out (empty if it is not there) */
+static void
+cmdline_value(const char *cmdline, const char *key, char *out, unsigned size)
+{
+	unsigned k = 0, n = 0;
+
+	while (key[k]) {
+		k++;
+	}
+	out[0] = 0;
+	for (const char *c = cmdline; c && *c; c++) {
+		if ((c == cmdline || c[-1] == ' ') && memcmp(c, key, k) == 0) {
+			for (c += k; *c && *c != ' ' && n + 1 < size; c++) {
+				out[n++] = *c;
+			}
+			out[n] = 0;
+			return;
+		}
+	}
+}
