+/*
+ * The Samsung Exynos990's (Galaxy S20's) GPU, an Arm Mali-G77 (Valhall, the "job manager" kind: no firmware to load),
+ * woken step by step and given one piece of work: devices/x1s/PLAN.md "GPU (Mali-G77)", step G3. Only with boot-arg
+ * mali=N, and only on this phone: every address below is the Exynos990's.
+ *
+ * The steps (mali=N does the first N of them, then gives back whatever it switched on):
+ *   1  look, without writing anything: the G3D power domain (PMU), the GPU's clock as the firmware left it, the GPU's
+ *      temperature, and -- when the domain is on -- the Mali's identity and what it has (cores, address spaces, job
+ *      slots, how many address bits its MMU takes). When the domain is off the steps end here: switching it on is
+ *      step G2 of the plan (Samsung's way, through a secure call and the APM), not done here.
+ *   2  a soft reset of the GPU, its interrupts masked (nothing here takes interrupts: everything is asked for)
+ *   3  the L2 cache, the tiler and the shader cores powered on through the GPU's own power registers, after the G3D
+ *      temperature has been read and found below mali_hot
+ *   4  one address space of the GPU's own MMU (AS 0): a four-level table in the AArch64 4K format, 16K of GPU
+ *      addresses at 0x1000000 mapped onto one page of ours, uncached for the GPU
+ *   5  one job: a WRITE_VALUE job (the simplest there is: it writes a number into memory) on job slot 1, and the
+ *      number looked for in memory
+ * After the last step the shader cores, the tiler and the L2 are powered off again (what S-BOOT left: off) and the
+ * system goes on starting. The GPU's clock is not touched: it runs at what the firmware left (read and said in step 1).
+ *
+ * Register layouts: Linux's drivers/gpu/drm/panfrost (panfrost_regs.h, panfrost_gpu.c, panfrost_mmu.c,
+ * panfrost_job.c) and Arm's kbase (mali_kbase_gpu_regmap.h, mali_kbase_mmu_mode_aarch64.c, mali_kbase_jm_hw.c, which
+ * Samsung ships for this phone); the job's layout: Mesa's src/panfrost/lib/genxml/v9.xml ("Job Header", "Write Value
+ * Job Payload"). The Mali at 0x18500000 and its power domain pd-embedded_g3d (PMU 0x15862200, status +4 bit 0): the
+ * phone's device tree. Read on the phone (U-Boot's gpucheck, test 25): domain on, GPU_ID 0x90800011 (G77 r0p1),
+ * SHADER_PRESENT 0x670077 (11 cores), 21 C.
+ *
+ * Status: WRITTEN, not yet run on the phone.
+ *
+ * Boot-args:
+ *   mali=N             the first N steps (1: read only; 5: everything)
+ *   mali_hot=C         no power on, and the cores off at once, at or above this G3D temperature (30 to 60; 50)
+ *   mali_tz=1          when step 2 finds that our writes do not reach the GPU: the secure call Samsung makes after the
+ *                      G3D domain comes on (its protection restored, tz_restore()), then the write test again
+ *   mali_cycle=1       when step 2 finds that our writes do not reach the GPU: the G3D domain switched off and on
+ *                      again exactly as Samsung's kernel does (domain_cycle()); left off at the end, Samsung's way
+ *   mali_clk=1         when step 2 finds that our writes do not reach the GPU: its clock started as Samsung's power-on
+ *                      of the domain does (clock_start()), the write test again; all of it undone at the end
+ *   mali_return=1      after the steps, back to the loader instead of starting the system
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/startup.h>
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
