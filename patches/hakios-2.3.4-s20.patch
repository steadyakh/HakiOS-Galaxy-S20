@@ -0,0 +1,5 @@
+#!/bin/sh
+# python3 for Git Bash on Windows, where "python3" is the Microsoft Store's stub and the real interpreter is "python"
+# (python.org's installer). The scripts here start with "#!/usr/bin/env python3"; with tools/win-bin first on PATH
+# they run under the real one. Not for Linux or macOS.
+exec python "$@"
