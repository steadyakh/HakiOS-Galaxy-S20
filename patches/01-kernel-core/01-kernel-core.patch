--- a/drivers/core/hakios.platform.c
+++ b/drivers/core/hakios.platform.c
@@ -22,6 +22,20 @@
 /* kern.hakios: the node every driver of this port hangs its sysctls under (it was hakios.battery.c's) */
 SYSCTL_NODE(_kern, OID_AUTO, hakios, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "redwood phone bits");
 
+/* kern.hakios.remote: the last command the host sent through a watching loader, "NUMBER STEPS" (0 before any) */
+extern uint64_t loader_remote(char *buf, size_t size);
+
+static int
+hakios_sysctl_remote(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	char steps[240], out[272];
+
+	snprintf(out, sizeof(out), "%llu %s", loader_remote(steps, sizeof(steps)), steps);
+	return SYSCTL_OUT(req, out, strlen(out) + 1);
+}
+SYSCTL_PROC(_kern_hakios, OID_AUTO, remote, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0,
+    hakios_sysctl_remote, "A", "touches from the computer: the last command, NUMBER STEPS (userland/src/rwremote.c)");
+
 static LCK_GRP_DECLARE(hakios_platform_lock_group, "hakios-platform");
 
 /*
