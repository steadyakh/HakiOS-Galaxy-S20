+static void __attribute__((unused))
+core_probe_one(int core, int hvc, uint64_t entry, const char *how)
+{
+	uint64_t mpidr = (uint64_t)core << PLAT->core_shift, start;
+	volatile uint64_t *slot = core_probe_slot[core];
+	int64_t status, affinity;
+
+	psci_by_hvc = hvc;
+	clean_dcache((uint64_t)(uintptr_t)&psci_by_hvc, (uint64_t)(uintptr_t)&psci_by_hvc + 8);
+	for (int i = 0; i < 8; i++) {
+		slot[i] = 0;
+	}
+	flush_dcache((uint64_t)(uintptr_t)slot, (uint64_t)(uintptr_t)slot + 64);
+	status = psci_call_by(hvc, PSCI_CPU_ON, mpidr >> PLAT->psci_shift, entry, (uint64_t)(uintptr_t)slot);
+	start = READ_SYSREG(CNTVCT_EL0);
