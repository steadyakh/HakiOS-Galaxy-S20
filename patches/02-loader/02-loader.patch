+		    "AFFINITY_INFO %d\n", (uint64_t)core, hvc ? "HVC" : "SMC", how, entry, (uint64_t)status, slot[0],
+		    slot[1] >> 2, slot[3], slot[4], (uint64_t)affinity);
+	} else {
+		print("  core %d %s %s entry %x: CPU_ON %d; nothing in 200 ms; AFFINITY_INFO %d\n", (uint64_t)core,
+		    hvc ? "HVC" : "SMC", how, entry, (uint64_t)status, (uint64_t)affinity);
+	}
