+			}
+		}
+		BS->stall(50000);
+		later = psci_call_by(PLAT->psci_hvc, PSCI_AFFINITY_INFO, target, 0, 0);
+		flush_dcache(page + 0x100, page + 0x140);
+		print("  core %d (PSCI %x) low: CPU_ON %d, AFFINITY_INFO right after %d, later %d; marks %x %x %x %x %x %x\n",
+		    (uint64_t)core, target, (uint64_t)status, (uint64_t)right_after, (uint64_t)later, marks[0], marks[1],
+		    marks[2], marks[3], marks[4], marks[5]);
+	}
+}
