+	__asm__ volatile ("dsb sy\n ic iallu\n dsb sy\n isb" ::: "memory");
+	marks = (volatile uint64_t *)(uintptr_t)(page + 0x100);
+	print("  low probe: %d bytes of code at %x\n", n, page);
+	for (int core = 1; core < PLAT->cores && core < 8; core++) {
+		uint64_t target = ((uint64_t)core << PLAT->core_shift) >> PLAT->psci_shift, start;
+		int64_t status, right_after, later;
+
+		status = psci_call_by(PLAT->psci_hvc, PSCI_CPU_ON, target, page, 0);
+		right_after = psci_call_by(PLAT->psci_hvc, PSCI_AFFINITY_INFO, target, 0, 0);
+		start = READ_SYSREG(CNTVCT_EL0);
