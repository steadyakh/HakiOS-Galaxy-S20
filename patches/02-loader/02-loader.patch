+	if (n > 0xf0 || page == 0) {
+		print("  low probe: no page in 0x80080000-0x80200000 (%d bytes of code)\n", n);
+		return;
+	}
+	for (uint64_t i = 0; i < 0x1000; i++) {
+		((volatile char *)(uintptr_t)page)[i] = 0;
+	}
+	for (uint64_t i = 0; i < n; i++) {
+		((volatile char *)(uintptr_t)page)[i] = core_probe_low[i];
+	}
+	*(volatile uint64_t *)(uintptr_t)(page + 0xf8) = PLAT->psci_hvc;
