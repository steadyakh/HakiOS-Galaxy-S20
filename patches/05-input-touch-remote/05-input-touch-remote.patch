diff --git a/userland/src/rwremote.c b/userland/src/rwremote.c
new file mode 100644
index 0000000..7928afa
--- /dev/null
+++ b/userland/src/rwremote.c
@@ -0,0 +1,66 @@
+/*
+ * rwremote: touches from the computer while iOS runs (the Galaxy S20's remote control, devices/x1s/PLAN.md).
+ *
+ * The host sends "fastboot oem touch STEPS" to the loader, which watches the kernel from core 0 (bootcpu=N); the loader
+ * puts STEPS into the kernel's loader_live mailbox with a new number (xnu/files/osfmk/arm64/loader_return.c), and the
+ * kernel gives both out as kern.hakios.remote, "NUMBER STEPS". This program looks every 30 ms and runs
+ *   /redwood/bin/rwtouch STEPS
+ * for each new number -- tap, swipe, drag, button home and the rest of rwtouch's steps. One command at a time:
+ * a new one waits for the one before to end.
+ *
+ * usage: rwremote          (rc.jobs.remote starts it in the background)
+ */
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/sysctl.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+int
+main(void)
+{
+	unsigned long long last = 0;
+	int said = 0;
+
+	for (;;) {
+		char buf[320], *steps, *argv[64];
+		size_t len = sizeof(buf) - 1;
+		unsigned long long seq;
+		int argc = 0;
+		pid_t pid;
+
+		if (sysctlbyname("kern.hakios.remote", buf, &len, NULL, 0) != 0) {
+			if (!said) {
+				printf("rwremote: no kern.hakios.remote in this kernel: nothing to do\n");
+				said = 1;
+			}
+			sleep(5);
+			continue;
+		}
+		buf[len < sizeof(buf) ? len : sizeof(buf) - 1] = 0;
+		seq = strtoull(buf, &steps, 10);
+		if (seq == 0 || seq == last) {
+			usleep(30000);
+			continue;
+		}
+		last = seq;
+		argv[argc++] = "/redwood/bin/rwtouch";
+		for (char *t = strtok(steps, " \t\n"); t != NULL && argc < 63; t = strtok(NULL, " \t\n")) {
+			argv[argc++] = t;
+		}
+		argv[argc] = NULL;
+		if (argc < 2) {
+			continue;
+		}
+		printf("rwremote: %llu:%s\n", seq, steps);
+		if (posix_spawn(&pid, argv[0], NULL, NULL, argv, environ) == 0) {
+			int status;
+
+			waitpid(pid, &status, 0);
+		}
+	}
+}
