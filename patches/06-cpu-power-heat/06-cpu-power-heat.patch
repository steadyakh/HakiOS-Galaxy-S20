+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[256];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+
+#define ACPM_SRAM_PA            0x02039000u
+#define ACPM_SRAM_SIZE          0x38000u
+#define ACPM_INITDATA           0x7000u
+#define ACPM_IPC_CHANNELS       0x08u
+#define ACPM_IPC_AP_MAX         0x18u
+#define ACPM_MBOX_PA            0x15900000u
+#define ACPM_INTGR0             0x08u
+#define ACPM_INTCR1             0x20u
+#define ACPM_CH_MFD             2
+#define ACPM_CH_FRAMEWORK       4
+#define ACPM_CH_TMU             9
+#define ACPM_CH_DVFS            5       /* the device tree's acpm_dvfs: one place, TYPE_BUFFER */
+#define ACPM_TYPE_BUFFER        2
+#define ACPM_FREQ_REQ           0       /* Samsung's acpm_dvfs.h: set a domain's clock, cmd[1] in kHz */
+#define ACPM_FREQ_GET           1       /* ... a question, the answer in cmd[1] in kHz (CPU domains: 0xffff, unknown) */
+#define ACPM_PROTOCOL_STOP      (1u << 22)
+#define ACPM_SEQ_SHIFT          16
+#define ACPM_SEQ_MASK           (0x3fu << ACPM_SEQ_SHIFT)
+#define ACPM_TIMEOUT_US         50000u
+
+#define TMU_IPC_READ_TEMP       0x02u
+#define ZONES                   4       /* BIG, MID, LITTLE and G3D (the GPU): the device tree's thermal-zones 0-3 */
+
+#define PMIC_SPEEDY_BUS         0
+#define PMIC_BLOCK_RTC          0x02u
+#define PMIC_RTC_WTSR_SMPL      0x01u
+#define PMIC_RTC_CAPSEL         0x03u
+#define PMIC_WTSR_EN            (1u << 6)
+#define PMIC_SMPL_EN            (1u << 7)
+#define PMIC_SUB_SMPL_EN        (1u << 3)
+#define MFD_FUNC_UPDATE         2u
+
+#define PMU_PA                  0x15860000u
+#define PMU_PS_HOLD_CONTROL     0x030cu
+#define PMU_PS_HOLD_EN          (1u << 8)
+
+/* the firmware's description of a channel (ACPM's framework.h: struct ipc_channel) */
+struct acpm_channel {
+	uint32_t id, field;
+	int32_t  owner;
+	uint32_t type;
+	uint32_t rx_rear, rx_front, rx_base;
+	uint32_t rx_indr_buf, rx_indr_buf_base, rx_indr_buf_size;
+	uint32_t tx_rear, tx_front, tx_base;
+	uint32_t q_len, q_elem_size, credit, mbox_addr;
+	uint32_t ap_poll;
+};
+
+static vm_offset_t sram, mbox, pmu;
+static uint32_t seq;
+static uint32_t poll_ms = 1000, stop_c = 70, gpu_stop_c = 60;
+static int strikes, gpu_strikes, blind_ms, last_step;
+static LCK_GRP_DECLARE(acpm_group, "exynos_acpm");
+static LCK_MTX_DECLARE(acpm_lock, &acpm_group);     /* one message to the APM at a time: the guard's and others' */
+static uint64_t last_log;
+static bool stopping;
+
+static int exynos_thermal_max_c = -273;
+static char exynos_thermal_zones[64] = "";
+static int exynos_thermal_reads;
+
+SYSCTL_INT(_kern_hakios, OID_AUTO, exynos_thermal_max_c, CTLFLAG_RD | CTLFLAG_LOCKED, &exynos_thermal_max_c, 0,
+    "the hottest of the Exynos990's CPU zones, in degrees (-273: none read)");
+SYSCTL_STRING(_kern_hakios, OID_AUTO, exynos_thermal_zones, CTLFLAG_RD | CTLFLAG_LOCKED, exynos_thermal_zones, 0,
+    "the CPU zones and their temperatures: \"BIG=31 MID=30 LITTLE=30\"");
+SYSCTL_INT(_kern_hakios, OID_AUTO, exynos_thermal_reads, CTLFLAG_RD | CTLFLAG_LOCKED, &exynos_thermal_reads, 0,
+    "how many times the zones were read");
+
+static inline uint32_t
+rd32(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr32(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static vm_offset_t
+acpm_channel(uint32_t id)
+{
+	uint32_t chans = rd32(sram + ACPM_INITDATA + ACPM_IPC_CHANNELS);
+	uint32_t max = rd32(sram + ACPM_INITDATA + ACPM_IPC_AP_MAX);
+
+	if (chans == 0 || chans >= ACPM_SRAM_SIZE || max == 0 || max > 32) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < max; i++) {
+		vm_offset_t c = sram + chans + i * sizeof(struct acpm_channel);
+
+		if (c + sizeof(struct acpm_channel) <= sram + ACPM_SRAM_SIZE &&
+		    rd32(c + offsetof(struct acpm_channel, id)) == id) {
+			return c;
+		}
+	}
+	return 0;
+}
+
+#define CH(c, field)    rd32((c) + offsetof(struct acpm_channel, field))
+
+/* cmd[4] to the APM on a channel, its answer back into cmd: 0, or an errno (acpm_lock held) */
+static int
+acpm_send_locked(uint32_t id, uint32_t cmd[4])
+{
+	vm_offset_t c = acpm_channel(id);
+	uint32_t len, size, front, next, rear, s;
+	uint64_t start;
+
+	if (c == 0) {
+		return ENODEV;
+	}
+	len = CH(c, q_len);
+	size = CH(c, q_elem_size);
+	if (len == 0 || len > 64 || size < 16 || size > 64) {
+		return EINVAL;
+	}
+	if (CH(c, type) == ACPM_TYPE_BUFFER && len == 1) {
+		/*
+		 * A one-place channel (the DVFS one, 5: type 2, q_len 1; run 87's table): no queue to wait on -- as a
+		 * ring of one it is always "full", which is why every FREQ_GET of runs 33-87 came back EBUSY. The message
+		 * goes into its one place, the APM is rung, and its answer, with our sequence number, comes back in the
+		 * other direction's one place (Samsung's acpm_ipc.c reads a TYPE_BUFFER answer from the base itself).
+		 */
+		seq = seq % 63 + 1;
+		s = seq;
+		cmd[0] = (cmd[0] & ~ACPM_SEQ_MASK) | s << ACPM_SEQ_SHIFT;
+		for (uint32_t k = 0; k < size / 4; k++) {
+			wr32(sram + CH(c, rx_base) + 4 * k, k < 4 ? cmd[k] : 0);
+		}
+		__builtin_arm_dsb(0xf);
+		wr32(mbox + ACPM_INTGR0, (1u << id) << 16);
+		start = now_us();
+		while (now_us() - start <= ACPM_TIMEOUT_US) {
+			vm_offset_t e = sram + CH(c, tx_base);
+
+			if (((rd32(e) & ACPM_SEQ_MASK) >> ACPM_SEQ_SHIFT) == s) {
+				for (uint32_t k = 0; k < 4; k++) {
+					cmd[k] = rd32(e + 4 * k);
+				}
+				wr32(mbox + ACPM_INTCR1, 1u << id);
+				return 0;
+			}
+			delay_for_interval(10, NSEC_PER_USEC);
+		}
+		return ETIMEDOUT;
+	}
+	front = rd32(sram + CH(c, rx_front));
+	next = (front + 1) % len;
+	start = now_us();
+	while (next == rd32(sram + CH(c, rx_rear))) {
+		if (now_us() - start > ACPM_TIMEOUT_US) {
+			return EBUSY;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	seq = seq % 63 + 1;
+	s = seq;
+	cmd[0] = (cmd[0] & ~ACPM_SEQ_MASK) | s << ACPM_SEQ_SHIFT;
+	for (uint32_t k = 0; k < size / 4; k++) {
+		wr32(sram + CH(c, rx_base) + size * front + 4 * k, k < 4 ? cmd[k] : 0);
+	}
+	__builtin_arm_dsb(0xf);
+	wr32(sram + CH(c, rx_front), next);
+	__builtin_arm_dsb(0xf);
+	wr32(mbox + ACPM_INTGR0, (1u << id) << 16);
+
+	start = now_us();
+	while (now_us() - start <= ACPM_TIMEOUT_US) {
+		front = rd32(sram + CH(c, tx_front));
+		rear = rd32(sram + CH(c, tx_rear));
+		for (uint32_t i = rear; i != front; i = (i + 1) % len) {
+			vm_offset_t e = sram + CH(c, tx_base) + size * i;
+
+			if (((rd32(e) & ACPM_SEQ_MASK) >> ACPM_SEQ_SHIFT) != s) {
+				continue;
+			}
+			for (uint32_t k = 0; k < 4; k++) {
+				cmd[k] = rd32(e + 4 * k);
+			}
+			if (i != rear) {
+				for (uint32_t k = 0; k < size / 4; k++) {
+					wr32(e + 4 * k, rd32(sram + CH(c, tx_base) + size * rear + 4 * k));
+				}
+			}
+			rear = (rear + 1) % len;
+			wr32(sram + CH(c, tx_rear), rear);
+			if (rear == rd32(sram + CH(c, tx_front))) {
+				wr32(mbox + ACPM_INTCR1, 1u << id);
+			}
+			return 0;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+acpm_send(uint32_t id, uint32_t cmd[4])
+{
+	int ret;
+
+	lck_mtx_lock(&acpm_lock);
+	ret = acpm_send_locked(id, cmd);
+	lck_mtx_unlock(&acpm_lock);
+	return ret;
+}
+
+/* a zone's temperature in degrees, or -1 */
+static int
+read_zone(uint32_t zone)
+{
+	uint32_t cmd[4] = { 0, TMU_IPC_READ_TEMP | zone << 16, 0, 0 };
+	int t;
+
+	if (acpm_send(ACPM_CH_TMU, cmd) != 0) {
+		return -1;
+	}
+	t = (int)(cmd[1] >> 24);
+	return t >= 5 && t <= 125 ? t : -1;
+}
+
+int
+hakios_exynos_temperature(uint32_t zone)
+{
+	return sram == 0 || mbox == 0 || zone > 5 ? -1 : read_zone(zone);
+}
+
+/* a word of the APM's SRAM at an offset the firmware's table gives, or 0xeeeeeeee if that is not in the SRAM */
+static uint32_t
+srd(uint32_t offset)
+{
+	return offset <= ACPM_SRAM_SIZE - 4 && (offset & 3) == 0 ? rd32(sram + offset) : 0xeeeeeeeeu;
+}
+
+/* every channel of the firmware's table, by its place in the table (Samsung's acpm_ipc.c sends by place), read only */
+void
+hakios_exynos_acpm_list(void)
+{
+	uint32_t chans, max;
+
+	if (sram == 0) {
+		return;
+	}
+	chans = rd32(sram + ACPM_INITDATA + ACPM_IPC_CHANNELS);
+	max = rd32(sram + ACPM_INITDATA + ACPM_IPC_AP_MAX);
+	say("exynos_thermal: APM channel table at %#x, %u channels\n", chans, max);
+	if (chans == 0 || chans >= ACPM_SRAM_SIZE || max == 0 || max > 32) {
+		return;
+	}
+	for (uint32_t i = 0; i < max; i++) {
+		vm_offset_t c = sram + chans + i * sizeof(struct acpm_channel);
+
+		if (c + sizeof(struct acpm_channel) > sram + ACPM_SRAM_SIZE) {
+			break;
+		}
+		/* the table's own words only: a queue index elsewhere in the SRAM may be a place whose read stops the bus
+		 * (runs 38, 39: the phone hung, the watchdog reset it) */
+		say("exynos_thermal:   place %u: id %u type %u owner %d q_len %u elem %u ap_poll %u; to %#x/%#x base %#x, "
+		    "from %#x/%#x base %#x\n", i, CH(c, id), CH(c, type), (int)CH(c, owner), CH(c, q_len), CH(c, q_elem_size),
+		    CH(c, ap_poll), CH(c, rx_front), CH(c, rx_rear), CH(c, rx_base), CH(c, tx_front), CH(c, tx_rear),
+		    CH(c, tx_base));
+	}
+}
+
+/* a channel's description and its queues, said in the log (read only): why a channel does not take a message */
+void
+hakios_exynos_acpm_show(uint32_t id)
+{
+	vm_offset_t c;
+	uint32_t len, size;
+
+	if (sram == 0) {
+		return;
+	}
+	lck_mtx_lock(&acpm_lock);
+	c = acpm_channel(id);
+	if (c == 0) {
+		lck_mtx_unlock(&acpm_lock);
+		say("exynos_thermal: APM channel %u: not found\n", id);
+		return;
+	}
+	len = CH(c, q_len);
+	size = CH(c, q_elem_size);
+	say("exynos_thermal: APM channel %u: field %#x owner %d type %#x q_len %u elem %u credit %u mbox %#x ap_poll %#x\n",
+	    id, CH(c, field), (int)CH(c, owner), CH(c, type), len, size, CH(c, credit), CH(c, mbox_addr), CH(c, ap_poll));
+	say("exynos_thermal:   to the APM: front %u rear %u base %#x (indirect %#x %#x %#x); from it: front %u rear %u base %#x\n",
+	    srd(CH(c, rx_front)), srd(CH(c, rx_rear)), CH(c, rx_base), CH(c, rx_indr_buf),
+	    CH(c, rx_indr_buf_base), CH(c, rx_indr_buf_size), srd(CH(c, tx_front)), srd(CH(c, tx_rear)),
+	    CH(c, tx_base));
+	for (uint32_t i = 0; i < len && i < 8 && size >= 16; i++) {
+		uint32_t e = CH(c, rx_base) + size * i, t = CH(c, tx_base) + size * i;
+
+		say("exynos_thermal:   [%u] to %#x %#x %#x %#x  from %#x %#x %#x %#x\n", i, srd(e), srd(e + 4), srd(e + 8),
+		    srd(e + 12), srd(t), srd(t + 4), srd(t + 8), srd(t + 12));
+	}
+	say("exynos_thermal:   mailbox INTGR0..: %#x %#x %#x %#x %#x %#x %#x %#x\n", rd32(mbox), rd32(mbox + 4), rd32(mbox + 8),
+	    rd32(mbox + 12), rd32(mbox + 16), rd32(mbox + 20), rd32(mbox + 24), rd32(mbox + 28));
+	lck_mtx_unlock(&acpm_lock);
+}
+
+/*
+ * The CPU clocks, by touch (boot-arg cpu_gov=1; owner's OK, 14 Nov: "a safe rate yet smooth"). S-BOOT leaves every
+ * cluster near 1.05 GHz, and the window server's drawing thread was then the limit of a swipe (14 Nov: ~24 ms of a
+ * 26 ms frame on the CPU, spread over Mesa, IOKit and CoreAnimation). At a touch -- the screen's or rwtouch's -- the
+ * A76s (APM DVFS domain 3) go to cpu_gov_a76 (default 2392000 of Samsung's 2600000) and the A55s (domain 2) to
+ * cpu_gov_a55 (default 2002000, their maximum), held 1.5 s past the last touch (a fling goes on after the finger
+ * leaves); then both back to cpu_gov_idle (default 1066000). From exynos_thermal_gov_hot (default 50) degrees on the
+ * hottest CPU zone the boost is 1794000 / 1586000. The Mongooses (Samsung's HIU) are left alone. The heat guard
+ * (exynos_thermal_stop) powers off as ever. The same channel and message as cpu_a76=/cpu_a55= above.
+ */
+extern void (*hakios_touch_boost_cpu)(void);
+
+static thread_call_t cpu_gov_call;
+static volatile uint64_t cpu_gov_until;
+static uint32_t cpu_gov_a76 = 2392000, cpu_gov_a55 = 2002000, cpu_gov_idle = 1066000, cpu_gov_hot = 50;
+static uint32_t cpu_gov_now_a76, cpu_gov_now_a55, cpu_gov_changes;
+
+static void
+cpu_gov_set(uint32_t a76, uint32_t a55, const char *why)
+{
+	int r76 = 0, r55 = 0;
+
+	if (a76 != cpu_gov_now_a76) {
+		uint32_t q[4] = { 3, a76, ACPM_FREQ_REQ, 0 };
+
+		r76 = acpm_send(ACPM_CH_DVFS, q);
+		cpu_gov_now_a76 = a76;
+	}
+	if (a55 != cpu_gov_now_a55) {
+		uint32_t q[4] = { 2, a55, ACPM_FREQ_REQ, 0 };
+
+		r55 = acpm_send(ACPM_CH_DVFS, q);
+		cpu_gov_now_a55 = a55;
+	}
+	if (cpu_gov_changes++ < 30) {
+		say("cpu_gov: %s: A76 %u MHz (APM %d), A55 %u MHz (APM %d); hottest %d C\n", why, a76 / 1000, r76, a55 / 1000,
+		    r55, exynos_thermal_max_c);
+	}
+}
+
+/* every 250 ms while boosted: back to idle once the touches are 1.5 s past; lower when hot */
+static void
+cpu_gov_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+	bool hot = exynos_thermal_max_c >= (int)cpu_gov_hot;
+
+	if (mach_absolute_time() < cpu_gov_until) {
+		cpu_gov_set(hot ? 1794000 : cpu_gov_a76, hot ? 1586000 : cpu_gov_a55, hot ? "touch (hot: capped)" : "touch");
+		clock_interval_to_deadline(250, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(cpu_gov_call, deadline);
+	} else {
+		cpu_gov_set(cpu_gov_idle, cpu_gov_idle, "idle");
+	}
+}
+
+static void
+cpu_gov_touch(void)
+{
+	uint64_t hold, was = cpu_gov_until;
+
+	nanoseconds_to_absolutetime(1500 * NSEC_PER_MSEC, &hold);
+	cpu_gov_until = mach_absolute_time() + hold;
+	if (mach_absolute_time() >= was) {
+		thread_call_enter(cpu_gov_call);        /* not boosted yet: now (else the tick running keeps it) */
+	}
+}
+
+static void
+cpu_gov_start(void)
+{
+	uint32_t v;
+
+	if (!PE_parse_boot_argn("cpu_gov", &v, sizeof(v)) || v == 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("cpu_gov_a76", &v, sizeof(v)) && v >= 507000 && v <= 2496000) {
+		cpu_gov_a76 = v;
+	}
+	if (PE_parse_boot_argn("cpu_gov_a55", &v, sizeof(v)) && v >= 442000 && v <= 2002000) {
+		cpu_gov_a55 = v;
+	}
+	if (PE_parse_boot_argn("cpu_gov_idle", &v, sizeof(v)) && v >= 507000 && v <= 2002000) {
+		cpu_gov_idle = v;
+	}
+	if (PE_parse_boot_argn("cpu_gov_hot", &v, sizeof(v)) && v >= 40 && v <= 58) {
+		cpu_gov_hot = v;
+	}
+	cpu_gov_call = thread_call_allocate_with_priority(cpu_gov_tick, NULL, THREAD_CALL_PRIORITY_HIGH);
+	say("cpu_gov: on: at a touch A76 %u, A55 %u MHz for 1.5 s (capped from %u C), else %u MHz\n", cpu_gov_a76 / 1000,
+	    cpu_gov_a55 / 1000, cpu_gov_hot, cpu_gov_idle / 1000);
+	cpu_gov_set(cpu_gov_idle, cpu_gov_idle, "start");
+	hakios_touch_boost_cpu = cpu_gov_touch;
+}
+
+/* a message to the APM for another driver (the Mali driver asks the DVFS channel for the GPU's clock): 0 or an errno */
+int
+hakios_exynos_acpm(uint32_t channel, uint32_t cmd[4])
+{
+	return sram == 0 || mbox == 0 ? ENODEV : acpm_send(channel, cmd);
+}
+
+static int
+pmic_update(uint32_t block, uint32_t reg, uint32_t val, uint32_t mask)
+{
+	uint32_t cmd[4] = { (block & 0xf) << 8 | (reg & 0xff) | (PMIC_SPEEDY_BUS & 0xf) << 12,
+		            MFD_FUNC_UPDATE | (val & 0xff) << 8 | (mask & 0xff) << 16, 0, 0 };
+	int ret = acpm_send(ACPM_CH_MFD, cmd);
+
+	return ret != 0 ? ret : ((cmd[1] >> 24) & 0xff) != 0 ? EIO : 0;
+}
+
+/* Samsung's power off (sec_reboot.c's sec_power_off, and HakiOS's U-Boot on this phone): it does not come back */
+static void __dead2
+power_off(int celsius)
+{
+	uint32_t stop[4] = { ACPM_PROTOCOL_STOP, 0, 0, 0 };
+	int wtsr, sub, apm;
+
+	boolean_t istate;
+
+	/*
+	 * Everything said while interrupts are on: XNU panics on console output from a context with interrupts off
+	 * ("Console I/O from interrupt-disabled context", seen on the phone with exynos_thermal_stop=20). They are off
+	 * only around the cut itself.
+	 */
+	say("\n--- exynos_thermal: %d C, at or above exynos_thermal_stop=%u: powering the phone off ---\n", celsius, stop_c);
+	wtsr = pmic_update(PMIC_BLOCK_RTC, PMIC_RTC_WTSR_SMPL, 0, PMIC_WTSR_EN | PMIC_SMPL_EN);
+	sub = pmic_update(PMIC_BLOCK_RTC, PMIC_RTC_CAPSEL, 0, PMIC_SUB_SMPL_EN);
+	apm = acpm_send(ACPM_CH_FRAMEWORK, stop);
+	say("exynos_thermal: WTSR/SMPL off %d, SUB_SMPL off %d, APM stop %d; PS_HOLD low\n", wtsr, sub, apm);
+	istate = ml_set_interrupts_enabled(FALSE);
+	__builtin_arm_dsb(0xf);
+	wr32(pmu + PMU_PS_HOLD_CONTROL, rd32(pmu + PMU_PS_HOLD_CONTROL) & ~PMU_PS_HOLD_EN);
+	__builtin_arm_dsb(0xf);
+	delay_for_interval(2000, NSEC_PER_MSEC);
+	(void)ml_set_interrupts_enabled(istate);
+	say("exynos_thermal: still on: a USB cable keeps the power chip on. Unplug it, or hold Volume Down + Power.\n");
+	(void)ml_set_interrupts_enabled(FALSE);
+	for (;;) {
+		__builtin_arm_wfi();
+	}
+}
+
+static thread_call_t call;
+
+static void
+look(void)
+{
+	int t[ZONES], hottest = -1;
+	static const char *const names[ZONES] = { "BIG", "MID", "LITTLE", "G3D" };
+	char list[sizeof(exynos_thermal_zones)];
+	uint64_t now = mach_absolute_time(), ns;
+
+	list[0] = 0;
+	for (uint32_t z = 0; z < ZONES; z++) {
+		char one[16];
+
+		t[z] = read_zone(z);
+		if (t[z] > hottest) {
+			hottest = t[z];
+		}
+		snprintf(one, sizeof(one), "%s%s=%d", z ? " " : "", names[z], t[z]);
+		strlcat(list, one, sizeof(list));
+	}
+	exynos_thermal_reads++;
+
+	if (hottest < 0) {
+		blind_ms += (int)poll_ms;
+		if (blind_ms >= 10000 && !stopping) {
+			stopping = true;
+			say("\n--- exynos_thermal: no temperature from the APM for 10 s: back to the loader ---\n");
+			hakios_var_save_on_return();
+			loader_return();
+		}
+		return;
+	}
+	blind_ms = 0;
+	strlcpy(exynos_thermal_zones, list, sizeof(exynos_thermal_zones));
+	exynos_thermal_max_c = hottest;
+
+	int step = hottest >= 50 ? hottest / 5 : 0;
+	absolutetime_to_nanoseconds(now - last_log, &ns);
+	if (last_log == 0 || step > last_step || ns >= 10 * NSEC_PER_SEC) {
+		say("exynos_thermal: %s C\n", list);
+		last_log = now;
+	}
+	last_step = step;
+
+	strikes = hottest >= (int)stop_c ? strikes + 1 : 0;
+	gpu_strikes = t[3] >= (int)gpu_stop_c ? gpu_strikes + 1 : 0;
+	if ((strikes >= 2 || gpu_strikes >= 2) && !stopping) {
+		stopping = true;
+		if (gpu_strikes >= 2) {
+			say("exynos_thermal: the GPU (G3D) at %d C, at or above exynos_thermal_gpu_stop=%u\n", t[3], gpu_stop_c);
+			hakios_mali_stop();
+		}
+		power_off(hottest);
+	}
+}
+
+static void
+tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+
+	look();
+	clock_interval_to_deadline(poll_ms, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+}
+
+/*
+ * Boot-arg cpu_mhz=1: how fast each core really runs, read only (13 Nov, run 86). S-BOOT leaves the clocks as it likes and
+ * we change none of them; before anyone asks whether to, this says what they are. Each core in turn, interrupts off,
+ * runs a chain of 20 million dependent additions (one a clock cycle on the A55, the A76 and the M5) against the 26 MHz
+ * timer: cycles over time. A minute after the start, when every core is up.
+ */
+static void
+cpu_mhz_measure(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned cpus = ml_get_cpu_count();
+	uint32_t khz;
+
+	/*
+	 * Boot-args cpu_a76=kHz, cpu_a55=kHz (owner's OK, 13 Nov): Samsung's exynos_acpm_set_rate() for the A76s (APM
+	 * DVFS domain 3) and the A55s (domain 2): channel 5, {domain, kHz, FREQ_REQ = 0, 0}. The APM sets the PLL and the
+	 * voltage that goes with it itself (that is how Samsung's Linux does it: cal_dfs_set_rate). Capped at 2.0 GHz for
+	 * the A76s (of 2.6) and 1.8 GHz for the A55s (of 2.0); the heat guard stays on. The Mongooses' clock goes another
+	 * way (Samsung's HIU) and is left alone. Then the measurement below says whether it took.
+	 */
+	for (int i = 0; i < 4; i++) {
+		/* (gpu_khz: the Mali-G77, APM DVFS domain 10 (g3d_cmu_cal_id 0xb04000a), from S-BOOT's 260 MHz; Samsung's
+		 * gpu driver asks the same through cal_dfs_set_rate. Capped at 700 MHz of 800.) */
+		if (i == 3) {
+			if (PE_parse_boot_argn("gpu_khz", &khz, sizeof(khz)) && khz >= 156000 && khz <= 700000) {
+				uint32_t q[4] = { 10, khz, ACPM_FREQ_REQ, 0 };
+				int r = acpm_send(ACPM_CH_DVFS, q);
+
+				say("cpu_mhz: gpu_khz=%u: the APM asked to set the GPU (domain 10) to %u kHz: answer %d (%#x %#x %#x %#x)\n",
+				    khz, khz, r, q[0], q[1], q[2], q[3]);
+			}
+			continue;
+		}
+		/* (cpu_m5: the Mongooses, domain 4. Samsung's Linux goes through the HIU for them; the APM is asked here as for
+		 * the others, capped at 2.0 GHz of 2.73 -- Samsung's own boot-time clock for them, pm_qos-booting) */
+		const char *arg = i == 0 ? "cpu_a76" : i == 1 ? "cpu_a55" : "cpu_m5";
+		uint32_t domain = i == 0 ? 3 : i == 1 ? 2 : 4, cap = i == 1 ? 1800000 : 2000000;
+
+		/*
+		 * Off (runs 89-93): the APM takes the request, and from then on the other seven cores never start again --
+		 * not even at the next boots ("1 of 8 processors are running") until the phone is restarted from scratch.
+		 * Only with cpu_dvfs_unsafe=1 as well, for whoever finds what Samsung's Linux does around it.
+		 */
+		uint32_t unsafe = 1;           /* (run 95: the lost cores were a second kernel in one loader session, not this) */
+
+		(void)PE_parse_boot_argn("cpu_dvfs_unsafe", &unsafe, sizeof(unsafe));
+		if (unsafe && PE_parse_boot_argn(arg, &khz, sizeof(khz)) && khz >= 500000 && khz <= cap) {
+			uint32_t q[4] = { domain, khz, ACPM_FREQ_REQ, 0 };
+			int r = acpm_send(ACPM_CH_DVFS, q);
+
+			say("cpu_mhz: %s=%u: the APM asked to set domain %u to %u kHz: answer %d (%#x %#x %#x %#x)\n", arg, khz,
+			    domain, khz, r, q[0], q[1], q[2], q[3]);
+			delay_for_interval(100, NSEC_PER_MSEC);
+		}
+	}
+
+	for (unsigned cpu = 0; cpu < cpus && cpu < 8; cpu++) {
+		processor_t processor = cpu_to_processor((int)cpu);
+		uint64_t began, took, ns, x = 0;
+		boolean_t was;
+
+		if (processor == PROCESSOR_NULL) {
+			continue;
+		}
+		thread_bind(processor);
+		thread_block(THREAD_CONTINUE_NULL);
+		/*
+		 * (interrupts left on: run 86, with them off for the whole chain, froze the phone. Twenty short bursts of
+		 * 100,000 additions instead, the fastest kept: an interrupt can only make a burst slower)
+		 */
+		(void)was;
+		took = ~0ull;
+		for (int burst = 0; burst < 20; burst++) {
+			uint64_t t;
+
+			began = mach_absolute_time();
+			for (uint32_t i = 0; i < 1000; i++) {
+				__asm__ volatile (".rept 100\n\tadd %0, %0, #1\n.endr" : "+r" (x));
+			}
+			t = mach_absolute_time() - began;
+			took = t < took ? t : took;
+		}
+		x = 100000;                     /* (the additions of one burst) */
+		absolutetime_to_nanoseconds(took, &ns);
+		say("cpu_mhz: cpu %u (on cpu %d) runs at about %llu MHz (%llu additions in %llu us)\n", cpu, cpu_number(),
+		    ns ? x * 1000ull / ns : 0, x, ns / 1000);
+	}
+	thread_bind(PROCESSOR_NULL);
+	/* what the APM says the clusters run at: FREQ_GET (a question) for its CPU domains 2-4 (cal-ids 0xb040002-4) */
+	for (uint32_t domain = 2; domain <= 4; domain++) {
+		uint32_t q[4] = { domain, 0, ACPM_FREQ_GET, 0 };
+		int r = acpm_send(ACPM_CH_DVFS, q);
+
+		say("cpu_mhz: the APM says domain %u (%s) runs at %u kHz (answer %d: %#x %#x %#x %#x)\n", domain,
+		    domain == 2 ? "the A55s" : domain == 3 ? "the A76s" : "the Mongooses", r == 0 ? q[1] : 0, r, q[0], q[1],
+		    q[2], q[3]);
+	}
+	say("cpu_mhz: done; the clocks are S-BOOT's, nothing was changed\n");
+	cpu_gov_start();        /* (cpu_gov=1: from here the clocks follow the touches) */
+	/* (a kernel thread whose function returns is ended by the kernel itself) */
+}
+
+static void
+cpu_mhz_start(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(cpu_mhz_measure, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+__startup_func
+static void
+exynos_thermal_init(void)
+{
+	uint32_t enabled = 0, value;
+
+	if (!PE_parse_boot_argn("exynos_thermal", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	if (PE_parse_boot_argn("exynos_thermal_poll", &value, sizeof(value)) && value >= 200 && value <= 10000) {
+		poll_ms = value;
+	}
+	/* lower only: 70 C is the most this phone is let reach */
+	if (PE_parse_boot_argn("exynos_thermal_stop", &value, sizeof(value)) && value >= 20 && value <= 70) {
+		stop_c = value;
+	}
+	if (PE_parse_boot_argn("exynos_thermal_gpu_stop", &value, sizeof(value)) && value >= 20 && value <= 70) {
+		gpu_stop_c = value;
+	}
+	sram = ml_io_map(ACPM_SRAM_PA, ACPM_SRAM_SIZE);
+	mbox = ml_io_map(ACPM_MBOX_PA, 0x1000);
+	pmu = ml_io_map(PMU_PA, 0x1000);
+	if (sram == 0 || mbox == 0 || pmu == 0) {
+		say("exynos_thermal: could not map the APM or the PMU; off\n");
+		return;
+	}
+	say("exynos_thermal: the CPU and GPU zones from the APM every %u ms; power off at %u C (GPU: %u C)\n", poll_ms,
+	    stop_c, gpu_stop_c);
+	call = thread_call_allocate(tick, NULL);
+	tick(NULL, NULL);
+	if (PE_parse_boot_argn("cpu_mhz", &value, sizeof(value)) && value) {
+		uint64_t deadline;
+
+		clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(thread_call_allocate(cpu_mhz_start, NULL), deadline);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, exynos_thermal_init);
